 };
@@ -324,6 +326,12 @@ test('with startcase subject should succeed for "always startcase"', async () =>
 	expect(actual).toEqual(expected);
 });
 
+test('with startcase subject containing a version should succeed for "always startcase"', async () => {
+	const [actual] = subjectCase(await parsed.startcase_version, "always", "start-case");
+	const expected = true;
+	expect(actual).toEqual(expected);
+});
+
 test('with startcase unicode subject should fail for "always pascalcase"', async () => {
