+/// Report the Brewfile's packages that are not installed, and fail if there
+/// are any, so `zb bundle check || zb bundle install` only installs when it
+/// has to. Nothing is fetched: the check only reads the local database.
+fn check_file(installer: &zb_io::Installer, manifest_path: &Path) -> Result<(), zb_core::Error> {
+    let entries = load_manifest(manifest_path)?;
+    let missing = missing_entries(&entries, |name| installer.is_installed(name))?;
+
+    if missing.is_empty() {
+        println!(
+            "{} The Brewfile's dependencies are satisfied.",
+            style("==>").cyan().bold()
+        );
+        return Ok(());
+    }
+
+    println!(
+        "{} {} of {} packages in {} are not installed:",
+        style("==>").cyan().bold(),
+        style(missing.len()).red().bold(),
+        entries.len(),
+        manifest_path.display()
+    );
+    for name in &missing {
+        println!("  {name}");
+    }
+
+    let install = if manifest_path == Path::new("Brewfile") {
+        "zb bundle install".to_string()
+    } else {
+        format!("zb bundle install -f {}", manifest_path.display())
+    };
+    Err(zb_core::Error::ExecutionError {
+        message: format!("the Brewfile's dependencies are not satisfied (run `{install}`)"),
+    })
+}
+
+/// The entries whose installed name, as `zb install` would record it, is not
+/// installed. Entries are returned as written in the Brewfile.
+fn missing_entries(
+    entries: &[String],
+    is_installed: impl Fn(&str) -> bool,
+) -> Result<Vec<String>, zb_core::Error> {
+    let mut missing = Vec::new();
+    for entry in entries {
+        if !is_installed(&normalize_formula_name(entry)?) {
+            missing.push(entry.clone());
+        }
+    }
+    Ok(missing)
+}
