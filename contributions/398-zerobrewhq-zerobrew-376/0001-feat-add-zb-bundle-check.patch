+    fn installer_with(installed: &[&str]) -> (zb_io::Installer, tempfile::TempDir) {
+        let tmp = tempfile::TempDir::new().unwrap();
+        let root = tmp.path().join("zerobrew");
+        let prefix = tmp.path().join("homebrew");
+        std::fs::create_dir_all(root.join("db")).unwrap();
+
+        let mut db = zb_io::Database::open(&root.join("db/zb.sqlite3")).unwrap();
+        let tx = db.transaction().unwrap();
+        for name in installed {
+            tx.record_install(name, "1.0.0", "store-key").unwrap();
+        }
+        tx.commit().unwrap();
+
+        let installer = zb_io::Installer::new(
+            zb_io::ApiClient::with_base_url("http://127.0.0.1:9".to_string()).unwrap(),
+            zb_io::BlobCache::new(&root.join("cache")).unwrap(),
+            zb_io::Store::new(&root).unwrap(),
+            zb_io::Cellar::new(&root).unwrap(),
+            zb_io::Linker::new(&prefix).unwrap(),
+            db,
+            prefix,
+            root.join("locks"),
+        );
+        (installer, tmp)
+    }
+
+    fn brewfile(contents: &str) -> tempfile::NamedTempFile {
+        let mut file = tempfile::NamedTempFile::new().unwrap();
+        write!(file, "{contents}").unwrap();
+        file
+    }
+
+    #[test]
+    fn check_passes_when_everything_is_installed() {
+        let (installer, _tmp) =
+            installer_with(&["jq", "hashicorp/tap/terraform", "cask:docker-desktop"]);
+        let file = brewfile(
+            "tap \"hashicorp/tap\"\nbrew \"jq\"\nbrew \"hashicorp/tap/terraform\"\ncask \"docker-desktop\"\n",
+        );
+
+        check_file(&installer, file.path()).unwrap();
+    }
+
+    #[test]
+    fn check_fails_when_a_package_is_missing() {
+        let (installer, _tmp) = installer_with(&["jq"]);
+        let file = brewfile("brew \"jq\"\nbrew \"wget\"\n");
+
+        let err = check_file(&installer, file.path()).unwrap_err();
+        match err {
+            zb_core::Error::ExecutionError { message } => {
+                assert!(message.contains("not satisfied"), "{message}")
+            }
+            other => panic!("expected execution error, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn missing_entries_uses_installed_names() {
+        let installed = ["jq", "cask:docker-desktop", "hashicorp/tap/terraform"];
+        let entries: Vec<String> = [
+            "homebrew/core/jq",
+            "homebrew/cask/docker-desktop",
+            "hashicorp/tap/terraform",
+            "cask:firefox",
+            "wget",
+        ]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+
+        let missing = missing_entries(&entries, |name| installed.contains(&name)).unwrap();
+        assert_eq!(missing, vec!["cask:firefox", "wget"]);
+    }
+
