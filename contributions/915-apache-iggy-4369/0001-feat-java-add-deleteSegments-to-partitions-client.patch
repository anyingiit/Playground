From 09bb773b1f9ac8cf21783c16f6a720d86b37f43b Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 23:22:27 +0000
Subject: [PATCH] feat(java): add deleteSegments to partitions client

The Rust SDK exposes SegmentClient::delete_segments but the Java SDK
had no way to issue the command.

Add CommandCode.Segment.DELETE (503) and deleteSegments to the blocking
and async PartitionsClient. TCP encodes stream and topic identifiers
followed by partition_id and segments_count as u32 LE. HTTP sends
DELETE /streams/{stream}/topics/{topic}/partitions/{partition} with a
segments_count query parameter.
---
 .../iggy/client/async/PartitionsClient.java   | 24 +++++++++++++++++++
 .../client/async/tcp/PartitionsTcpClient.java | 20 ++++++++++++++++
 .../client/blocking/PartitionsClient.java     |  6 +++++
 .../blocking/http/PartitionsHttpClient.java   |  8 +++++++
 .../blocking/tcp/PartitionsTcpClient.java     |  5 ++++
 .../org/apache/iggy/serde/CommandCode.java    | 15 ++++++++++++
 .../blocking/PartitionsClientBaseTest.java    | 24 +++++++++++++++++++
 7 files changed, 102 insertions(+)

diff --git a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/PartitionsClient.java b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/PartitionsClient.java
index d06260e..ce623ac 100644
--- a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/PartitionsClient.java
+++ b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/PartitionsClient.java
@@ -72,4 +72,28 @@ public interface PartitionsClient {
      * @return A CompletableFuture that completes when the operation is done
      */
     CompletableFuture<Void> deletePartitions(StreamId streamId, TopicId topicId, Long partitionsCount);
+
+    /**
+     * Deletes the oldest segments of a partition asynchronously.
+     *
+     * @param streamId The stream identifier (numeric ID)
+     * @param topicId The topic identifier (numeric ID)
+     * @param partitionId The partition identifier
+     * @param segmentsCount The number of segments to delete
+     * @return A CompletableFuture that completes when the operation is done
+     */
+    default CompletableFuture<Void> deleteSegments(Long streamId, Long topicId, Long partitionId, Long segmentsCount) {
+        return deleteSegments(StreamId.of(streamId), TopicId.of(topicId), partitionId, segmentsCount);
+    }
+
+    /**
+     * Deletes the oldest segments of a partition asynchronously.
+     *
+     * @param streamId The stream identifier
+     * @param topicId The topic identifier
+     * @param partitionId The partition identifier
+     * @param segmentsCount The number of segments to delete
+     * @return A CompletableFuture that completes when the operation is done
+     */
+    CompletableFuture<Void> deleteSegments(StreamId streamId, TopicId topicId, Long partitionId, Long segmentsCount);
 }
diff --git a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/tcp/PartitionsTcpClient.java b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/tcp/PartitionsTcpClient.java
index e854406..bcfe69c 100644
--- a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/tcp/PartitionsTcpClient.java
+++ b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/async/tcp/PartitionsTcpClient.java
@@ -75,4 +75,24 @@ public class PartitionsTcpClient implements PartitionsClient {
                     response.release();
                 });
     }
+
+    @Override
+    public CompletableFuture<Void> deleteSegments(
+            StreamId streamId, TopicId topicId, Long partitionId, Long segmentsCount) {
+        var payload = BytesSerializer.toBytes(streamId);
+        payload.writeBytes(BytesSerializer.toBytes(topicId));
+        payload.writeIntLE(partitionId.intValue());
+        payload.writeIntLE(segmentsCount.intValue());
+
+        log.debug(
+                "Deleting {} segments for stream: {}, topic: {}, partition: {}",
+                segmentsCount,
+                streamId,
+                topicId,
+                partitionId);
+
+        return connection().send(CommandCode.Segment.DELETE.getValue(), payload).thenAccept(response -> {
+            response.release();
+        });
+    }
 }
diff --git a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/PartitionsClient.java b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/PartitionsClient.java
index 89e63fa..f7df13f 100644
--- a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/PartitionsClient.java
+++ b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/PartitionsClient.java
@@ -35,4 +35,10 @@ public interface PartitionsClient {
     }
 
     void deletePartitions(StreamId streamId, TopicId topicId, Long partitionsCount);
+
+    default void deleteSegments(Long streamId, Long topicId, Long partitionId, Long segmentsCount) {
+        deleteSegments(StreamId.of(streamId), TopicId.of(topicId), partitionId, segmentsCount);
+    }
+
+    void deleteSegments(StreamId streamId, TopicId topicId, Long partitionId, Long segmentsCount);
 }
diff --git a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/http/PartitionsHttpClient.java b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/http/PartitionsHttpClient.java
index 8726a37..9d1a8ff 100644
--- a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/http/PartitionsHttpClient.java
+++ b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/http/PartitionsHttpClient.java
@@ -50,5 +50,13 @@ class PartitionsHttpClient implements PartitionsClient {
         httpClient.execute(request);
     }
 
+    @Override
+    public void deleteSegments(StreamId streamId, TopicId topicId, Long partitionId, Long segmentsCount) {
+        var request = httpClient.prepareDeleteRequest(
+                STREAMS + "/" + streamId + TOPICS + "/" + topicId + PARTITIONS + "/" + partitionId,
+                new BasicNameValuePair("segments_count", segmentsCount.toString()));
+        httpClient.execute(request);
+    }
+
     private record CreatePartitions(Long partitionsCount) {}
 }
diff --git a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/tcp/PartitionsTcpClient.java b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/tcp/PartitionsTcpClient.java
index d2060b2..1741be4 100644
--- a/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/tcp/PartitionsTcpClient.java
+++ b/foreign/java/java-sdk/src/main/java/org/apache/iggy/client/blocking/tcp/PartitionsTcpClient.java
@@ -40,4 +40,9 @@ final class PartitionsTcpClient implements PartitionsClient {
     public void deletePartitions(StreamId streamId, TopicId topicId, Long partitionsCount) {
         FutureUtil.resolve(delegate.deletePartitions(streamId, topicId, partitionsCount));
     }
+
+    @Override
+    public void deleteSegments(StreamId streamId, TopicId topicId, Long partitionId, Long segmentsCount) {
+        FutureUtil.resolve(delegate.deleteSegments(streamId, topicId, partitionId, segmentsCount));
+    }
 }
diff --git a/foreign/java/java-sdk/src/main/java/org/apache/iggy/serde/CommandCode.java b/foreign/java/java-sdk/src/main/java/org/apache/iggy/serde/CommandCode.java
index 8e7fb29..aae8a1b 100644
--- a/foreign/java/java-sdk/src/main/java/org/apache/iggy/serde/CommandCode.java
+++ b/foreign/java/java-sdk/src/main/java/org/apache/iggy/serde/CommandCode.java
@@ -181,6 +181,21 @@ public interface CommandCode {
         }
     }
 
+    enum Segment implements CommandCode {
+        DELETE(503);
+
+        private final int value;
+
+        Segment(int value) {
+            this.value = value;
+        }
+
+        @Override
+        public int getValue() {
+            return value;
+        }
+    }
+
     enum ConsumerGroup implements CommandCode {
         GET(600),
         GET_ALL(601),
diff --git a/foreign/java/java-sdk/src/test/java/org/apache/iggy/client/blocking/PartitionsClientBaseTest.java b/foreign/java/java-sdk/src/test/java/org/apache/iggy/client/blocking/PartitionsClientBaseTest.java
index ea84098..46c2233 100644
--- a/foreign/java/java-sdk/src/test/java/org/apache/iggy/client/blocking/PartitionsClientBaseTest.java
+++ b/foreign/java/java-sdk/src/test/java/org/apache/iggy/client/blocking/PartitionsClientBaseTest.java
@@ -19,6 +19,7 @@
 
 package org.apache.iggy.client.blocking;
 
+import org.apache.iggy.partition.Partition;
 import org.apache.iggy.topic.TopicDetails;
 import org.junit.jupiter.api.BeforeEach;
 import org.junit.jupiter.api.Test;
@@ -60,4 +61,27 @@ public abstract class PartitionsClientBaseTest extends IntegrationTest {
         topic = topicsClient.getTopic(STREAM_NAME, TOPIC_NAME).get();
         assertThat(topic.partitionsCount()).isEqualTo(1L);
     }
+
+    @Test
+    void shouldDeleteSegments() {
+        // given
+        Partition partition = topicsClient
+                .getTopic(STREAM_NAME, TOPIC_NAME)
+                .get()
+                .partitions()
+                .get(0);
+        Long segmentsCountBefore = partition.segmentsCount();
+        assertThat(segmentsCountBefore).isPositive();
+
+        // when
+        partitionsClient.deleteSegments(STREAM_NAME, TOPIC_NAME, partition.id(), 1L);
+
+        // then
+        Partition partitionAfter = topicsClient
+                .getTopic(STREAM_NAME, TOPIC_NAME)
+                .get()
+                .partitions()
+                .get(0);
+        assertThat(partitionAfter.segmentsCount()).isPositive().isLessThanOrEqualTo(segmentsCountBefore);
+    }
 }
