diff --git a/libraries/classes/Util.php b/libraries/classes/Util.php
index eb84efd..774c581 100644
--- a/libraries/classes/Util.php
+++ b/libraries/classes/Util.php
@@ -376,6 +376,18 @@ public static function getTableList($db): array
 
     /* ----------------------- Set of misc functions ----------------------- */
 
+    /**
+     * Wraps a compound statement (CREATE PROCEDURE, EVENT, TRIGGER, ...) in
+     * DELIMITER $$ ... $$ DELIMITER ; so that the query can be run again
+     * from the SQL tab or the mysql client, even when its body contains ";".
+     *
+     * @param string $query the statement to wrap
+     */
+    public static function getQueryWithDelimiter(string $query): string
+    {
+        return "DELIMITER $$\n" . $query . "$$\nDELIMITER ;\n";
+    }
+
     /**
      * Adds backquotes on both sides of a database, table or field name.
      * and escapes backquotes inside the name with another backquote
diff --git a/test/classes/UtilTest.php b/test/classes/UtilTest.php
index d8427bf..0de7e05 100644
--- a/test/classes/UtilTest.php
+++ b/test/classes/UtilTest.php
@@ -10,6 +10,9 @@
 use PhpMyAdmin\MoTranslator\Loader;
 use PhpMyAdmin\ResponseRenderer;
 use PhpMyAdmin\SqlParser\Context;
+use PhpMyAdmin\SqlParser\Parser;
+use PhpMyAdmin\SqlParser\Statements\CreateStatement;
+use PhpMyAdmin\SqlParser\Statements\DropStatement;
 use PhpMyAdmin\SqlParser\Token;
 use PhpMyAdmin\Util;
 use PhpMyAdmin\Utils\SessionCache;
@@ -1851,6 +1854,28 @@ public static function providerUnQuoteSelectedChar(): array
         ];
     }
 
+    public function testGetQueryWithDelimiter(): void
+    {
+        $query = 'CREATE PROCEDURE `p`() BEGIN SELECT 1; SELECT 2; END';
+
+        $delimited = Util::getQueryWithDelimiter($query);
+
+        self::assertSame("DELIMITER $$\n" . $query . "$$\nDELIMITER ;\n", $delimited);
+
+        // The procedure body contains ";", the result must still be parsed as one statement.
+        $parser = new Parser($delimited);
+        self::assertCount(0, $parser->errors);
+        self::assertCount(1, $parser->statements);
+        self::assertInstanceOf(CreateStatement::class, $parser->statements[0]);
+
+        // When editing, the DROP statement is shown before the DELIMITER line.
+        $parser = new Parser("DROP PROCEDURE `p`;\n" . $delimited);
+        self::assertCount(0, $parser->errors);
+        self::assertCount(2, $parser->statements);
+        self::assertInstanceOf(DropStatement::class, $parser->statements[0]);
+        self::assertInstanceOf(CreateStatement::class, $parser->statements[1]);
+    }
+
     /**
      * @dataProvider providerForTestBackquote
      */
