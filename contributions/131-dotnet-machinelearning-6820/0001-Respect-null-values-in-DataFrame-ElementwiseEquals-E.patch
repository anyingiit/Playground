+        /// <summary>
+        /// Values of null elements are not meaningful, so the result of ElementwiseEquals/ElementwiseNotEquals for rows
+        /// where at least one operand is null is determined by validity only: two nulls are equal, null and a value are not.
+        /// </summary>
+        /// <param name="operation">The comparison operation that was applied.</param>
+        /// <param name="right">The right container, or <see langword="null"/> if the right operand is a (non null) scalar value.</param>
+        /// <param name="ret">The container with comparison results to fix.</param>
+        private void ApplyNullEqualitySemantics(ComparisonOperation operation, PrimitiveColumnContainer<T> right, PrimitiveColumnContainer<bool> ret)
+        {
+            if (operation != ComparisonOperation.ElementwiseEquals && operation != ComparisonOperation.ElementwiseNotEquals)
+                return;
+
+            if (NullCount == 0 && (right == null || right.NullCount == 0))
+                return;
+
+            bool isEquals = operation == ComparisonOperation.ElementwiseEquals;
+
+            long rowIndex = 0;
+            for (int i = 0; i < this.Buffers.Count; i++)
+            {
+                var length = this.Buffers[i].Length;
+                var leftValidity = this.NullBitMapBuffers[i].ReadOnlySpan;
+                var rightValidity = right == null ? ReadOnlySpan<byte>.Empty : right.NullBitMapBuffers[i].ReadOnlySpan;
+
+                for (int j = 0; j < length; j++, rowIndex++)
+                {
+                    bool isLeftValid = BitUtility.GetBit(leftValidity, j);
+                    bool isRightValid = right == null || BitUtility.GetBit(rightValidity, j);
+
+                    if (!isLeftValid || !isRightValid)
+                        ret[rowIndex] = (isLeftValid == isRightValid) == isEquals;
+                }
+            }
+        }
+
