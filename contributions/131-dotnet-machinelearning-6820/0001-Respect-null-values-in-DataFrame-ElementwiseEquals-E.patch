+        [Fact]
+        public void TestElementwiseEqualsWithNulls()
+        {
+            var left = new Int32DataFrameColumn("Left", new int?[] { 0, 2, null, null, 3 });
+            var right = new Int32DataFrameColumn("Right", new int?[] { null, 2, 0, null, 4 });
+
+            var equals = left.ElementwiseEquals(right);
+            Assert.Equal(new bool?[] { false, true, false, true, false }, equals);
+            Assert.Equal(0, equals.NullCount);
+
+            var notEquals = left.ElementwiseNotEquals(right);
+            Assert.Equal(new bool?[] { true, false, true, false, true }, notEquals);
+            Assert.Equal(0, notEquals.NullCount);
+        }
+
+        [Fact]
+        public void TestElementwiseEqualsWithNullsAndDifferentColumnTypes()
+        {
+            var left = new Int32DataFrameColumn("Left", new int?[] { 0, 2, null, null });
+            var right = new DoubleDataFrameColumn("Right", new double?[] { null, 2, 0, null });
+
+            Assert.Equal(new bool?[] { false, true, false, true }, left.ElementwiseEquals(right));
+            Assert.Equal(new bool?[] { true, false, true, false }, left.ElementwiseNotEquals(right));
+        }
+
+        [Fact]
+        public void TestElementwiseEqualsScalarWithNulls()
+        {
+            var column = new Int32DataFrameColumn("Int", new int?[] { 0, null, 2 });
+
+            Assert.Equal(new bool?[] { true, false, false }, column.ElementwiseEquals(0));
+            Assert.Equal(new bool?[] { false, true, true }, column.ElementwiseNotEquals(0));
+
+            // Different scalar type (requires conversion)
+            Assert.Equal(new bool?[] { true, false, false }, column.ElementwiseEquals(0.0));
+            Assert.Equal(new bool?[] { false, true, true }, column.ElementwiseNotEquals(0.0));
+        }
+
