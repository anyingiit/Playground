From b7b12c063a0a4aefe74889c6283eab260613ac14 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 23:11:15 +0000
Subject: [PATCH] feat(core): add TransactionStatus enum for transaction
 outcomes

Adds COMMITTED, ROLLED_BACK and ERRORED with display labels to
com.sdlcpro.springlens.model.transaction, for the transaction
diagnostics model (#506).

Closes #526
---
 .../model/transaction/TransactionStatus.java  | 28 +++++++++++++++++++
 .../transaction/TransactionStatusTest.java    | 21 ++++++++++++++
 2 files changed, 49 insertions(+)
 create mode 100644 spring-lens-core/src/main/java/com/sdlcpro/springlens/model/transaction/TransactionStatus.java
 create mode 100644 spring-lens-core/src/test/java/com/sdlcpro/springlens/model/transaction/TransactionStatusTest.java

diff --git a/spring-lens-core/src/main/java/com/sdlcpro/springlens/model/transaction/TransactionStatus.java b/spring-lens-core/src/main/java/com/sdlcpro/springlens/model/transaction/TransactionStatus.java
new file mode 100644
index 0000000..98540ae
--- /dev/null
+++ b/spring-lens-core/src/main/java/com/sdlcpro/springlens/model/transaction/TransactionStatus.java
@@ -0,0 +1,28 @@
+package com.sdlcpro.springlens.model.transaction;
+
+/**
+ * Outcome of a Spring transaction execution recorded by Spring-Lens.
+ */
+public enum TransactionStatus {
+    /** The transaction completed and its changes were committed. */
+    COMMITTED("Committed"),
+    /** The transaction was rolled back and its changes were discarded. */
+    ROLLED_BACK("Rolled Back"),
+    /** The transaction failed with an error before it could complete. */
+    ERRORED("Errored");
+
+    private final String label;
+
+    TransactionStatus(String label) {
+        this.label = label;
+    }
+
+    /**
+     * Returns the human-readable label for this status, for display.
+     *
+     * @return the display label, such as {@code "Rolled Back"}
+     */
+    public String getLabel() {
+        return label;
+    }
+}
diff --git a/spring-lens-core/src/test/java/com/sdlcpro/springlens/model/transaction/TransactionStatusTest.java b/spring-lens-core/src/test/java/com/sdlcpro/springlens/model/transaction/TransactionStatusTest.java
new file mode 100644
index 0000000..0700de4
--- /dev/null
+++ b/spring-lens-core/src/test/java/com/sdlcpro/springlens/model/transaction/TransactionStatusTest.java
@@ -0,0 +1,21 @@
+package com.sdlcpro.springlens.model.transaction;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class TransactionStatusTest {
+
+    @Test
+    void shouldDefineStatusesInOrder() {
+        assertThat(TransactionStatus.values())
+                .containsExactly(TransactionStatus.COMMITTED, TransactionStatus.ROLLED_BACK, TransactionStatus.ERRORED);
+    }
+
+    @Test
+    void shouldExposeDisplayLabels() {
+        assertThat(TransactionStatus.COMMITTED.getLabel()).isEqualTo("Committed");
+        assertThat(TransactionStatus.ROLLED_BACK.getLabel()).isEqualTo("Rolled Back");
+        assertThat(TransactionStatus.ERRORED.getLabel()).isEqualTo("Errored");
+    }
+}
