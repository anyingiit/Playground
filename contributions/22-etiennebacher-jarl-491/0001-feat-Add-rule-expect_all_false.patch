diff --git a/crates/jarl-core/src/lints/testthat/expect_all_false/expect_all_false.rs b/crates/jarl-core/src/lints/testthat/expect_all_false/expect_all_false.rs
new file mode 100644
index 0000000..90c6f5a
--- /dev/null
+++ b/crates/jarl-core/src/lints/testthat/expect_all_false/expect_all_false.rs
@@ -0,0 +1,126 @@
+use crate::diagnostic::*;
+use crate::rule_set::Rule;
+use crate::utils::{
+    Formals, get_arg, get_function_name, get_function_namespace_prefix, node_contains_comments,
+};
+use air_r_syntax::*;
+use biome_rowan::{AstNode, AstSeparatedList};
+
+const FORMALS_EXPECT_TRUE: Formals = &["object", "info", "label"];
+
+/// <!-- docs: start -->
+/// Version added: 0.7.0
+///
+/// ## What it does
+///
+/// Checks for usage of `expect_true(all(!x))`.
+///
+/// ## Why is this bad?
+///
+/// `expect_all_false()` states the intent more directly than
+/// `expect_true(all(!x))`, and when the test fails it reports which elements
+/// are not `FALSE` instead of only saying that `all(!x)` is not `TRUE`.
+///
+/// `expect_all_false()` was added in testthat 3.3.0.
+///
+/// This rule is **disabled by default**. Select it either with the rule name
+/// `"expect_all_false"` or with the rule group `"TESTTHAT"`.
+///
+/// This rule doesn't report calls that pass `info` or `label` to
+/// `expect_true()`, or that pass several arguments (such as `na.rm`) to
+/// `all()`.
+///
+/// This rule has an automatic fix that is marked unsafe and therefore requires
+/// passing `--unsafe-fixes`. `expect_all_false()` is stricter than
+/// `expect_true(all(!x))`: it errors when `x` is empty and can fail when `x`
+/// isn't a logical vector (for example, `x <- c(0, 0)`), so a test that passes
+/// now could fail after the fix.
+///
+/// ## Example
+///
+/// ```r
+/// expect_true(all(!x))
+/// expect_true(all(!is.na(x)))
+/// ```
+///
+/// Use instead:
+/// ```r
+/// expect_all_false(x)
+/// expect_all_false(is.na(x))
+/// ```
+///
+/// ## References
+///
+/// See `?testthat::expect_all_false`
+/// <!-- docs: end -->
+pub fn expect_all_false(ast: &RCall, fn_name: &str) -> anyhow::Result<Option<Diagnostic>> {
+    if fn_name != "expect_true" {
+        return Ok(None);
+    }
+
+    // `expect_all_false()` has no `info` or `label` argument.
+    if ast.arguments()?.items().iter().count() != 1 {
+        return Ok(None);
+    }
+
+    let object = unwrap_or_return_none!(get_arg(ast, FORMALS_EXPECT_TRUE, "object"));
+    let object_value = unwrap_or_return_none!(object.value());
+    let all_call = unwrap_or_return_none!(object_value.as_r_call());
+
+    if get_function_name(all_call.function()?) != "all" {
+        return Ok(None);
+    }
+
+    // Only `all(!x)`: `all(!x, !y)` or `all(!x, na.rm = TRUE)` have no
+    // `expect_all_false()` equivalent.
+    let all_args = all_call.arguments()?.items();
+    if all_args.iter().count() != 1 {
+        return Ok(None);
+    }
+    let all_arg = unwrap_or_return_none!(all_args.iter().next().and_then(|arg| arg.ok()));
+    if all_arg.name_clause().is_some() {
+        return Ok(None);
+    }
+    let all_arg_value = unwrap_or_return_none!(all_arg.value());
+
+    let unary_expr = unwrap_or_return_none!(all_arg_value.as_r_unary_expression());
+    let operator = unwrap_or_return_none!(unary_expr.operator().ok());
+    if operator.kind() != RSyntaxKind::BANG {
+        return Ok(None);
+    }
+    let argument = unwrap_or_return_none!(unary_expr.argument().ok());
+
+    // Skip rlang's `!!` and `!!!`.
+    if let Some(inner_unary) = argument.as_r_unary_expression()
+        && let Ok(inner_op) = inner_unary.operator()
+        && inner_op.kind() == RSyntaxKind::BANG
+    {
+        return Ok(None);
+    }
+
+    // `all(!(x > 1))` -> `expect_all_false(x > 1)`
+    let inner_text = match argument
+        .as_r_parenthesized_expression()
+        .and_then(|paren| paren.body().ok())
+    {
+        Some(body) => body.to_trimmed_text(),
+        None => argument.to_trimmed_text(),
+    };
+
+    let namespace_prefix = get_function_namespace_prefix(ast.function()?).unwrap_or_default();
+    let range = ast.syntax().text_trimmed_range();
+
+    Ok(Some(Diagnostic::new(
+        ViolationData::new(
+            Rule::TestthatExpectAllFalse,
+            "`expect_true(all(!x))` is not as clear as `expect_all_false(x)`.".to_string(),
+            Some("Use `expect_all_false(x)` instead.".to_string()),
+        ),
+        range,
+        Fix::new(
+            range,
+            format!("{}expect_all_false({})", namespace_prefix, inner_text),
+            node_contains_comments(ast.syntax()),
+        ),
+    )))
+}
diff --git a/crates/jarl-core/src/lints/testthat/expect_all_false/mod.rs b/crates/jarl-core/src/lints/testthat/expect_all_false/mod.rs
