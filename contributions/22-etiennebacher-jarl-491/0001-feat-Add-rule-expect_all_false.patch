+pub(crate) mod expect_all_false;
+
+#[cfg(test)]
+mod tests {
+    use crate::utils_test::*;
+    use insta::assert_snapshot;
+
+    fn snapshot_lint(code: &str) -> String {
+        format_diagnostics(code, "expect_all_false", None)
+    }
+
+    #[test]
+    fn test_no_lint_expect_all_false() {
+        expect_no_lint("expect_all_false(x)", "expect_all_false", None);
+        expect_no_lint("expect_true(all(x))", "expect_all_false", None);
+        expect_no_lint("expect_true(any(!x))", "expect_all_false", None);
+        expect_no_lint("expect_false(all(!x))", "expect_all_false", None);
+        expect_no_lint("expect_true(!all(x))", "expect_all_false", None);
+        expect_no_lint("expect_true(all(!x | y))", "expect_all_false", None);
+        expect_no_lint("all(!x)", "expect_all_false", None);
+
+        // `all()` with several arguments can't be expressed with `expect_all_false()`
+        expect_no_lint("expect_true(all(!x, !y))", "expect_all_false", None);
+        expect_no_lint(
+            "expect_true(all(!x, na.rm = TRUE))",
+            "expect_all_false",
+            None,
+        );
+
+        // `expect_all_false()` has no `info` or `label` argument
+        expect_no_lint(
+            "expect_true(all(!x), info = 'msg')",
+            "expect_all_false",
+            None,
+        );
+        expect_no_lint(
+            "expect_true(all(!x), label = 'x')",
+            "expect_all_false",
+            None,
+        );
+
+        // rlang "!!" and "!!!" operators should not be flagged
+        expect_no_lint("expect_true(all(!!x))", "expect_all_false", None);
+        expect_no_lint("expect_true(all(!!!x))", "expect_all_false", None);
+
+        // Wrong code but no panic
+        expect_no_lint("expect_true()", "expect_all_false", None);
+        expect_no_lint("expect_true(all())", "expect_all_false", None);
+        expect_no_lint("expect_true(all(!))", "expect_all_false", None);
+        expect_no_lint("expect_true(object =)", "expect_all_false", None);
+        expect_no_lint("expect_true(all(x =))", "expect_all_false", None);
+    }
+
+    #[test]
+    fn test_lint_expect_all_false() {
+        assert_snapshot!(
+            snapshot_lint("expect_true(all(!x))"),
+            @"
+        warning: expect_all_false
+         --> <test>:1:1
+          |
+        1 | expect_true(all(!x))
+          | -------------------- `expect_true(all(!x))` is not as clear as `expect_all_false(x)`.
+          |
+          = help: Use `expect_all_false(x)` instead.
+        Found 1 error.
+        "
+        );
+        assert_snapshot!(
+            snapshot_lint("testthat::expect_true(all(!which_loop(g2)))"),
+            @"
+        warning: expect_all_false
+         --> <test>:1:1
+          |
+        1 | testthat::expect_true(all(!which_loop(g2)))
+          | ------------------------------------------- `expect_true(all(!x))` is not as clear as `expect_all_false(x)`.
+          |
+          = help: Use `expect_all_false(x)` instead.
+        Found 1 error.
+        "
+        );
+        assert_snapshot!(
+            snapshot_lint("expect_true(object = all(!is.na(x)))"),
+            @"
+        warning: expect_all_false
+         --> <test>:1:1
+          |
+        1 | expect_true(object = all(!is.na(x)))
+          | ------------------------------------ `expect_true(all(!x))` is not as clear as `expect_all_false(x)`.
+          |
+          = help: Use `expect_all_false(x)` instead.
+        Found 1 error.
+        "
+        );
+    }
+
+    #[test]
+    fn test_expect_all_false_no_safe_fix() {
+        // The fix is unsafe, so nothing changes without `--unsafe-fixes`.
+        assert_snapshot!(
+            get_fixed_text(vec!["expect_true(all(!x))"], "expect_all_false", None),
+            @"
+        OLD:
+        ====
+        expect_true(all(!x))
+        NEW:
+        ====
+        expect_true(all(!x))
+        "
+        );
+    }
+
+    #[test]
+    fn test_expect_all_false_unsafe_fix() {
+        assert_snapshot!(
+            "fix_output",
+            get_unsafe_fixed_text(
+                vec![
+                    "expect_true(all(!x))",
+                    "expect_true(all(!which_loop(g2)))",
+                    "expect_true(all(!(x > 1)))",
+                    "expect_true(all(!(x & y)))",
+                    "testthat::expect_true(base::all(!x))",
+                ],
+                "expect_all_false",
+            )
+        );
+    }
+
+    #[test]
+    fn test_expect_all_false_with_comments_no_fix() {
+        assert_snapshot!(
+            "no_fix_with_comments",
+            get_unsafe_fixed_text(
+                vec![
+                    "# leading comment\nexpect_true(all(!x))",
+                    "expect_true(all(\n  # comment\n  !x))",
+                    "expect_true(all(!x)) # trailing comment",
+                ],
+                "expect_all_false",
+            )
+        );
+    }
+}
