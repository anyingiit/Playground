+    def test_svg_badge_text_has_blurred_shadow(self) -> None:
+        response = self.client.get(
+            reverse(
+                "widget-image",
+                kwargs={
+                    "path": self.project.get_url_path(),
+                    "widget": "svg",
+                    "color": "badge",
+                    "extension": "svg",
+                },
+            )
+        )
+
+        self.assert_svg(response)
+        svg_ns = "{http://www.w3.org/2000/svg}"
+        tree = parse_xml(response.content)
+        blur_filters = [
+            element
+            for element in tree.iter(f"{svg_ns}filter")
+            if element.find(f"{svg_ns}feGaussianBlur") is not None
+        ]
+        self.assertEqual(len(blur_filters), 1)
+        filter_reference = f"url(#{blur_filters[0].attrib['id']})"
+
+        # Every visible text (label and value) has a blurred shadow
+        blurred_texts = [
+            element.text
+            for element in tree.iter(f"{svg_ns}text")
+            if element.attrib.get("filter") == filter_reference
+        ]
+        visible_texts = [
+            element.text
+            for element in tree.iter(f"{svg_ns}text")
+            if "fill-opacity" not in element.attrib
+        ]
+        self.assertEqual(len(visible_texts), 2)
+        self.assertEqual(blurred_texts, visible_texts)
+
+        # Shadows are hidden from assistive technologies
+        for group in tree.iter(f"{svg_ns}g"):
+            if group.find(f"{svg_ns}text[@filter]") is not None:
+                self.assertEqual(group.attrib.get("aria-hidden"), "true")
+
