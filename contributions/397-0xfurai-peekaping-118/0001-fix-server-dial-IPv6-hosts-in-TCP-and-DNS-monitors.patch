+func dnsMonitorVia(resolver string, port int, resolveType string) *Monitor {
+	return &Monitor{
+		ID:      "dns",
+		Type:    "dns",
+		Name:    "peekaping.test",
+		Timeout: 2,
+		Config:  fmt.Sprintf(`{"host": "peekaping.test", "resolver_server": %q, "port": %d, "resolve_type": %q}`, resolver, port, resolveType),
+	}
+}
+
+// An IPv6 resolver is queried at [resolver]:port, both through net.Resolver
+// (A) and through miekg/dns (SOA).
+func TestDNSExecutor_Execute_IPv6Resolver(t *testing.T) {
+	probe := listenIPv6Loopback(t)
+	probe.Close()
+	port := startDNSServerOn(t, "[::1]:0")
+	executor := NewDNSExecutor(zap.NewNop().Sugar())
+
+	for _, resolveType := range []string{"A", "SOA"} {
+		t.Run(resolveType, func(t *testing.T) {
+			result := executor.Execute(context.Background(), dnsMonitorVia("::1", port, resolveType), nil)
+
+			assert.Equal(t, shared.MonitorStatusUp, result.Status, result.Message)
+		})
+	}
+}
+
+// Runs without IPv6 too: the resolver address is well formed even where it
+// can't be reached.
+func TestDNSExecutor_Execute_IPv6ResolverAddressIsWellFormed(t *testing.T) {
+	executor := NewDNSExecutor(zap.NewNop().Sugar())
+
+	for _, resolveType := range []string{"A", "SOA"} {
+		t.Run(resolveType, func(t *testing.T) {
+			result := executor.Execute(context.Background(), dnsMonitorVia("::1", closedPort(t), resolveType), nil)
+
+			assert.Equal(t, shared.MonitorStatusDown, result.Status)
+			assert.NotContains(t, result.Message, "too many colons")
+		})
+	}
+}
