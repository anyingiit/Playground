+// An IPv6 host is dialled as [host]:port, not split on its colons.
+func TestTCPExecutor_Execute_IPv6(t *testing.T) {
+	l := listenIPv6Loopback(t)
+	defer l.Close()
+
+	result := NewTCPExecutor(zap.NewNop().Sugar()).Execute(context.Background(), tcpMonitor(t, l.Addr().String()), nil)
+
+	assert.Equal(t, shared.MonitorStatusUp, result.Status, result.Message)
+}
+
+// Runs without IPv6 too: the address is well formed even where it can't be
+// reached, whether the host is written bare or, as before, in brackets.
+func TestTCPExecutor_Execute_IPv6AddressIsWellFormed(t *testing.T) {
+	for _, host := range []string{"::1", "[::1]"} {
+		t.Run(host, func(t *testing.T) {
+			monitor := &Monitor{ID: "tcp", Type: "tcp", Name: "tcp", Timeout: 2, Config: fmt.Sprintf(`{"host": %q, "port": 1}`, host)}
+
+			result := NewTCPExecutor(zap.NewNop().Sugar()).Execute(context.Background(), monitor, nil)
+
+			assert.Equal(t, shared.MonitorStatusDown, result.Status)
+			assert.NotContains(t, result.Message, "too many colons")
+			assert.NotContains(t, result.Message, "missing port")
+		})
+	}
+}
+
 func TestTCPExecutor_Execute_InvalidConfig(t *testing.T) {
