diff --git a/apps/server/internal/modules/healthcheck/executor/tcp.go b/apps/server/internal/modules/healthcheck/executor/tcp.go
index 1134733..911bf97 100644
--- a/apps/server/internal/modules/healthcheck/executor/tcp.go
+++ b/apps/server/internal/modules/healthcheck/executor/tcp.go
@@ -5,6 +5,8 @@ import (
 	"fmt"
 	"net"
 	"peekaping/internal/modules/shared"
+	"strconv"
+	"strings"
 	"time"
 
 	"go.uber.org/zap"
@@ -44,7 +46,13 @@ func (t *TCPExecutor) Execute(ctx context.Context, m *Monitor, proxyModel *Proxy
 	}
 	cfg := cfgAny.(*TCPConfig)
 
-	address := fmt.Sprintf("%s:%d", cfg.Host, cfg.Port)
+	// JoinHostPort brackets an IPv6 host, which "%s:%d" would not. A host
+	// already written as [::1] is unwrapped first, so it isn't bracketed twice.
+	host := cfg.Host
+	if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+		host = host[1 : len(host)-1]
+	}
+	address := net.JoinHostPort(host, strconv.Itoa(cfg.Port))
 
 	startTime := time.Now().UTC()
 
