+// listenIPv6Loopback listens on TCP [::1], or skips the test on a host
+// without IPv6.
+func listenIPv6Loopback(t *testing.T) net.Listener {
+	t.Helper()
+	l, err := net.Listen("tcp", "[::1]:0")
+	if err != nil {
+		t.Skipf("IPv6 loopback not available: %v", err)
+	}
+	return l
+}
