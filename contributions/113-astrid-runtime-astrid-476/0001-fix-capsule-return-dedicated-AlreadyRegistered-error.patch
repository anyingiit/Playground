+
+// Duplicate registrations return dedicated errors (#476).
+#[test]
+fn duplicate_register_returns_already_registered() {
+    let mut registry = CapsuleRegistry::new();
+    registry
+        .register(Box::new(MockCapsule::new("dup-capsule")))
+        .expect("first registration");
+
+    let err = registry
+        .register(Box::new(MockCapsule::new("dup-capsule")))
+        .expect_err("second registration must fail");
+
+    assert!(
+        matches!(&err, CapsuleError::AlreadyRegistered(id) if id == "dup-capsule"),
+        "expected AlreadyRegistered, got {err:?}"
+    );
+    assert_eq!(err.to_string(), "Already registered: dup-capsule");
+    assert_eq!(registry.len(), 1);
+}
+
+#[test]
+fn duplicate_register_existing_returns_already_registered() {
+    let mut registry = CapsuleRegistry::new();
+    let hash = test_hash("dup-system-hash");
+    let id = CapsuleId::from_static("dup-service");
+    let alice = pid("alice");
+
+    registry
+        .register_system_runtime(
+            Box::new(MockCapsule::new("dup-service")),
+            hash.clone(),
+            &alice,
+        )
+        .expect("register system runtime");
+
+    let err = registry
+        .register_existing(&id, &hash, &alice)
+        .expect_err("alice already has this capsule");
+
+    assert!(
+        matches!(&err, CapsuleError::AlreadyRegistered(dup) if dup == "dup-service"),
+        "expected AlreadyRegistered, got {err:?}"
+    );
+}
+
+#[test]
+fn duplicate_register_uplink_returns_uplink_already_registered() {
+    let mut registry = CapsuleRegistry::new();
+    let id = CapsuleId::from_static("uplink-owner");
+    let descriptor = UplinkDescriptor::builder("dup-uplink", "cli").build();
+    let uplink_id = descriptor.id;
+
+    registry
+        .register_uplink(&id, descriptor.clone())
+        .expect("first uplink registration");
+
+    let err = registry
+        .register_uplink(&id, descriptor)
+        .expect_err("second uplink registration must fail");
+
+    assert!(
+        matches!(&err, CapsuleError::UplinkAlreadyRegistered(dup) if *dup == uplink_id.to_string()),
+        "expected UplinkAlreadyRegistered, got {err:?}"
+    );
+    assert_eq!(
+        err.to_string(),
+        format!("Uplink already registered: {uplink_id}")
+    );
+}
