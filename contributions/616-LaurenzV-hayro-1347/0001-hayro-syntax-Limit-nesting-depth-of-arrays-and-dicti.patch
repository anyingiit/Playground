+/// The maximum nesting depth of arrays and dictionaries that we accept.
+///
+/// Skipping over nested arrays and dictionaries is implemented recursively, so
+/// without a limit, a (malicious) file with deeply nested objects could overflow
+/// the stack and abort the whole process. The PDF specification suggests a limit
+/// of 28 in Annex C, but we are a bit more lenient here.
+pub(crate) const MAX_NESTING_DEPTH: u32 = 256;
+
+/// Skip an object that is nested `depth` levels deep inside of arrays and dictionaries.
+pub(crate) fn skip_object(r: &mut Reader<'_>, is_content_stream: bool, depth: u32) -> Option<()> {
+    let old_offset = r.offset;
+
+    let res = match r.peek_byte()? {
+        b'n' => Null::skip(r, is_content_stream),
+        b't' | b'f' => bool::skip(r, is_content_stream),
+        b'/' => Name::skip(r, is_content_stream),
+        b'<' => match r.peek_bytes(2)? {
+            // A stream can never appear in a dict/array, so it should never be skipped.
+            b"<<" => dict::skip_dict(r, is_content_stream, depth),
+            _ => String::skip(r, is_content_stream),
+        },
+        b'(' => String::skip(r, is_content_stream),
+        b'.' | b'+' | b'-' | b'0'..=b'9' => Number::skip(r, is_content_stream),
+        b'[' => array::skip_array(r, is_content_stream, depth),
+        // See test case operator-in-TJ-array-0: Be lenient and skip content operators in
+        // array
+        _ => skip_name_like(r, false),
+    };
+
+    if res.is_none() {
+        r.offset = old_offset;
+    }
+
+    res
+}
+
+/// Skip an object (or, outside of content streams, an object reference) that is
+/// nested `depth` levels deep inside of arrays and dictionaries.
+pub(crate) fn skip_nested_value(
+    r: &mut Reader<'_>,
+    is_content_stream: bool,
+    depth: u32,
+) -> Option<()> {
+    if !is_content_stream && r.skip::<ObjRef>(false).is_some() {
+        return Some(());
+    }
+
+    skip_object(r, is_content_stream, depth)
+}
