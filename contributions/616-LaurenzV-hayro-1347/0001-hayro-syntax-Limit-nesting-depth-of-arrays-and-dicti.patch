diff --git a/hayro-syntax/src/pdf.rs b/hayro-syntax/src/pdf.rs
index c196cb1..855842b 100644
--- a/hayro-syntax/src/pdf.rs
+++ b/hayro-syntax/src/pdf.rs
@@ -182,4 +182,53 @@ mod tests {
 
         assert_eq!(pdf.version(), PdfVersion::Pdf14);
     }
+
+    fn nested_pdf(open: &str, close: &str, depth: usize) -> Vec<u8> {
+        let mut obj = String::from("1 0 obj\n<< /Type /Catalog /Pages 2 0 R /Nested ");
+        obj.push_str(&open.repeat(depth));
+        obj.push_str(&close.repeat(depth));
+        obj.push_str(" >>\nendobj\n");
+
+        let mut data = b"%PDF-1.7\n".to_vec();
+        let offset_1 = data.len();
+        data.extend_from_slice(obj.as_bytes());
+        let offset_2 = data.len();
+        data.extend_from_slice(b"2 0 obj\n<< /Type /Pages /Kids [] /Count 0 >>\nendobj\n");
+        let xref_offset = data.len();
+        data.extend_from_slice(
+            format!(
+                "xref\n0 3\n0000000000 65535 f \n{offset_1:010} 00000 n \n{offset_2:010} 00000 n \ntrailer\n<< /Size 3 /Root 1 0 R >>\nstartxref\n{xref_offset}\n%%EOF\n"
+            )
+            .as_bytes(),
+        );
+
+        data
+    }
+
+    // See https://github.com/LaurenzV/hayro/issues/1347.
+    #[test]
+    fn deeply_nested_arrays() {
+        let _ = Pdf::new(nested_pdf("[", "]", 10_000));
+    }
+
+    #[test]
+    fn deeply_nested_dicts() {
+        let _ = Pdf::new(nested_pdf("<< /A ", " >>", 10_000));
+    }
+
+    #[test]
+    fn deeply_nested_garbage_dicts() {
+        let _ = Pdf::new(nested_pdf("<< ", " >>", 10_000));
+    }
+
+    #[test]
+    fn moderately_nested_arrays() {
+        let pdf = Pdf::new(nested_pdf("[", "]", 100)).unwrap();
+        let catalog = pdf
+            .xref()
+            .get::<crate::object::Dict<'_>>(pdf.xref().root_id())
+            .unwrap();
+
+        assert!(catalog.get::<crate::object::Array<'_>>(b"Nested").is_some());
+    }
 }
