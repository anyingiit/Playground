+def _add_opacity_column(args):
+    """
+    If `opacity` was given as a per-point array, store it as a hidden column of
+    `args["data_frame"]` so that it is split along with the rest of the data when
+    traces are grouped (e.g. by `color`) or reordered. The column name is recorded
+    in `args["opacity_col"]` and picked up in `make_trace_kwargs`.
+    """
+    args["opacity_col"] = None
+    opacity = args.get("opacity")
+    if opacity is None or isinstance(opacity, (str, Number)):
+        return
+    df: nw.DataFrame = args["data_frame"]
+    opacity = nw.from_native(opacity, series_only=True, pass_through=True)
+    if isinstance(opacity, nw.Series):
+        values = opacity.to_list()
+    elif hasattr(opacity, "__len__"):
+        values = list(opacity)
+    else:
+        return
+    if len(values) != len(df):
+        return
+    col_name = _escape_col_name(df.columns, "_px_opacity", [])
+    args["data_frame"] = df.with_columns(
+        to_named_series(values, col_name, nw.get_native_namespace(df))
+    )
+    args["opacity_col"] = col_name
+
+
 def make_figure(args, constructor, trace_patch=None, layout_patch=None):
     trace_patch = trace_patch or {}
     layout_patch = layout_patch or {}
@@ -2546,6 +2586,8 @@ def make_figure(args, constructor, trace_patch=None, layout_patch=None):
         constructor = go.Bar
         args = process_dataframe_timeline(args)
 
+    _add_opacity_column(args)
+
     # If we have marginal histograms, set barmode to "overlay"
     if "histogram" in [args.get("marginal_x"), args.get("marginal_y")]:
         layout_patch["barmode"] = "overlay"
