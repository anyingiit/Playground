+def test_opacity_array_split_by_group(constructor):
+    # https://github.com/plotly/plotly.py/issues/4580
+    data = constructor(dict(y=[1, 2, 3, 4], c=["r", "b", "r", "b"]))
+    opacity = [1.0, 0.2, 0.3, 0.4]
+    fig = px.scatter(data, y="y", color="c", opacity=opacity)
+    assert len(fig.data) == 2
+    assert list(fig.data[0].y) == [1, 3]
+    assert list(fig.data[0].marker.opacity) == [1.0, 0.3]
+    assert list(fig.data[1].y) == [2, 4]
+    assert list(fig.data[1].marker.opacity) == [0.2, 0.4]
+
+
+@pytest.mark.parametrize(
+    "opacity", [[1.0, 0.2, 0.3, 0.4], np.array([1.0, 0.2, 0.3, 0.4])]
+)
+def test_opacity_array_split_by_facet_and_symbol(opacity):
+    fig = px.scatter(
+        y=[1, 2, 3, 4],
+        symbol=["a", "a", "b", "b"],
+        facet_col=["x", "y", "x", "y"],
+        opacity=opacity,
+    )
+    by_y = {}
+    for trace in fig.data:
+        by_y.update(zip(trace.y, trace.marker.opacity))
+    assert by_y == {1: 1.0, 2: 0.2, 3: 0.3, 4: 0.4}
+    # the per-point opacity must not leak into the hover label
+    assert all("opacity" not in trace.hovertemplate for trace in fig.data)
+
+
+def test_opacity_scalar_unchanged():
+    fig = px.scatter(y=[1, 2, 3, 4], color=["r", "b", "r", "b"], opacity=0.5)
+    assert all(trace.marker.opacity == 0.5 for trace in fig.data)
+
+
+def test_opacity_array_scatter_matrix_dimensions():
+    df = pd.DataFrame(dict(a=[1, 2, 3], b=[4, 5, 6], c=["r", "b", "r"]))
+    fig = px.scatter_matrix(df, color="c", opacity=[0.1, 0.2, 0.3])
+    assert [d.label for d in fig.data[0].dimensions] == ["a", "b", "c"]
+    assert list(fig.data[0].marker.opacity) == [0.1, 0.3]
+    assert list(fig.data[1].marker.opacity) == [0.2]
