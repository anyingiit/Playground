From 4cf1e2388a3e0551e86d95759e35d9ecfaf9690e Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 23:35:53 +0000
Subject: [PATCH] getfacl: implement --absolute-names

By default, strip leading '/' characters from the file name shown in the
'# file:' header (printing a one-time warning to stderr, like GNU getfacl)
and drop a leading './'. With -p/--absolute-names the name is kept as given.

Fixes #21
---
 src/uu/getfacl/src/getfacl.rs | 34 +++++++++++++++++-
 tests/by-util/test_getfacl.rs | 68 +++++++++++++++++++++++++++++++++++
 2 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/src/uu/getfacl/src/getfacl.rs b/src/uu/getfacl/src/getfacl.rs
index 7b5f0f8..56cced5 100644
--- a/src/uu/getfacl/src/getfacl.rs
+++ b/src/uu/getfacl/src/getfacl.rs
@@ -14,6 +14,7 @@ use uzers::{get_group_by_gid, get_user_by_uid};
 struct Config {
     omit_header: bool,
     show_access: bool,
+    absolute_names: bool,
 }
 
 impl Config {
@@ -23,6 +24,7 @@ impl Config {
             omit_header: matches.get_flag("omit-header"),
             // Always show access ACL (either by default or when --access flag is set)
             show_access: true,
+            absolute_names: matches.get_flag("absolute-names"),
         }
     }
 }
@@ -57,6 +59,34 @@ fn print_file_acl(metadata: &Metadata) -> std::io::Result<()> {
     Ok(())
 }
 
+/// Compute the name shown in the `# file:` header.
+///
+/// Like GNU getfacl, unless `--absolute-names` is given, leading slashes are
+/// stripped (with a one-time warning) and a leading `./` is removed. An empty
+/// result is shown as `.`.
+fn display_name<'a>(file_path: &'a str, config: &Config, warned: &mut bool) -> &'a str {
+    if config.absolute_names {
+        return file_path;
+    }
+
+    let name = if file_path.starts_with('/') {
+        if !*warned {
+            eprintln!(
+                "{}: Removing leading '/' from absolute path names",
+                uucore::util_name()
+            );
+            *warned = true;
+        }
+        file_path.trim_start_matches('/')
+    } else if let Some(rest) = file_path.strip_prefix("./") {
+        rest.trim_start_matches('/')
+    } else {
+        file_path
+    };
+
+    if name.is_empty() { "." } else { name }
+}
+
 fn print_header(file_path: &str, metadata: &Metadata) -> std::io::Result<()> {
     // Fetching owner and group names
     let owner = get_user_by_uid(metadata.uid())
@@ -93,13 +123,15 @@ pub fn uumain(args: impl uucore::Args) -> UResult<()> {
 
     // Parse configuration from command-line arguments
     let config = Config::from_matches(&matches);
+    let mut warned_absolute = false;
 
     // Handle file arguments
     if let Some(files) = matches.get_many::<String>("file") {
         for file in files {
             let metadata = fs::metadata(file)?;
 
-            print_output(file, &config, &metadata)?;
+            let name = display_name(file, &config, &mut warned_absolute);
+            print_output(name, &config, &metadata)?;
 
             // Implement the logic to fetch and display the ACLs using xattr
             match xattr::list(file) {
diff --git a/tests/by-util/test_getfacl.rs b/tests/by-util/test_getfacl.rs
index 2e4ff58..22e924d 100644
--- a/tests/by-util/test_getfacl.rs
+++ b/tests/by-util/test_getfacl.rs
@@ -74,3 +74,71 @@ fn test_basic_output_with_file_with_access_flag() {
     assert!(stdout.contains("group:"));
     assert!(stdout.contains("other:"));
 }
+
+#[test]
+fn test_strips_leading_slash_by_default() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+    at.touch("test_file");
+    let abs = at.plus_as_string("test_file");
+    assert!(abs.starts_with('/'));
+
+    let res = scene.ucmd().arg(&abs).succeeds();
+    res.stderr_is("getfacl: Removing leading '/' from absolute path names\n");
+    let stdout = res.stdout_str();
+    let expected = format!("# file: {}\n", abs.trim_start_matches('/'));
+    assert!(stdout.contains(&expected), "stdout was: {stdout}");
+}
+
+#[test]
+fn test_leading_slash_warning_printed_once() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+    at.touch("a");
+    at.touch("b");
+
+    scene
+        .ucmd()
+        .arg(at.plus_as_string("a"))
+        .arg(at.plus_as_string("b"))
+        .succeeds()
+        .stderr_is("getfacl: Removing leading '/' from absolute path names\n");
+}
+
+#[test]
+fn test_root_is_shown_as_dot() {
+    let res = new_ucmd!().arg("/").succeeds();
+    res.stderr_is("getfacl: Removing leading '/' from absolute path names\n");
+    assert!(res.stdout_str().starts_with("# file: .\n"));
+}
+
+#[test]
+fn test_absolute_names_keeps_leading_slash() {
+    for flag in ["-p", "--absolute-names"] {
+        let scene = TestScenario::new(util_name!());
+        let at = &scene.fixtures;
+        at.touch("test_file");
+        let abs = at.plus_as_string("test_file");
+
+        let res = scene.ucmd().arg(flag).arg(&abs).succeeds();
+        let stdout = res.no_stderr().stdout_str();
+        assert!(
+            stdout.contains(&format!("# file: {abs}\n")),
+            "stdout was: {stdout}"
+        );
+    }
+}
+
+#[test]
+fn test_relative_name_unchanged() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+    at.touch("test_file");
+
+    let res = scene.ucmd().arg("./test_file").succeeds();
+    let stdout = res.no_stderr().stdout_str();
+    assert!(
+        stdout.contains("# file: test_file\n"),
+        "stdout was: {stdout}"
+    );
+}
