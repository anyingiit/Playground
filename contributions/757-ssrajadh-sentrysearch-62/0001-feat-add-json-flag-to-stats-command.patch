diff --git a/sentrysearch/cli.py b/sentrysearch/cli.py
index 7489892..5408c3d 100644
--- a/sentrysearch/cli.py
+++ b/sentrysearch/cli.py
@@ -1,5 +1,6 @@
 """Click-based CLI entry point."""
 
+import json
 import os
 import platform
 import shutil
@@ -1478,7 +1479,9 @@ def overlay(video, output):
 # -----------------------------------------------------------------------
 
 @cli.command()
-def stats():
+@click.option("--json", "as_json", is_flag=True,
+              help="Print stats as a single JSON object (for scripting).")
+def stats(as_json):
     """Print index statistics."""
     from .store import SentryStore, detect_index
 
@@ -1488,6 +1491,19 @@ def stats():
     store = SentryStore(backend=backend, model=model)
     s = store.get_stats()
 
+    if as_json:
+        click.echo(json.dumps({
+            "backend": store.get_backend(),
+            "model": model,
+            "total_chunks": s["total_chunks"],
+            "unique_source_files": s["unique_source_files"],
+            "source_files": s["source_files"],
+            "missing_files": [
+                f for f in s["source_files"] if not os.path.exists(f)
+            ],
+        }, indent=2))
+        return
+
     if s["total_chunks"] == 0:
         click.echo("Index is empty. Run `sentrysearch index <directory>` first.")
         return
