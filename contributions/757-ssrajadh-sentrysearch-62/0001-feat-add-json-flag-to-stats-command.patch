diff --git a/README.md b/README.md
index d596f10..94bb6ae 100644
--- a/README.md
+++ b/README.md
@@ -414,6 +414,10 @@ sentryblur prompt --last "road signs"   # → match_<...>_blurred.mp4
 # Show index info (files marked [missing] no longer exist on disk)
 sentrysearch stats
 
+# Same info as JSON for scripts (keys: backend, model, total_chunks,
+# unique_source_files, source_files, missing_files)
+sentrysearch stats --json | jq .total_chunks
+
 # Remove specific files by path substring
 sentrysearch remove path/to/footage
 
diff --git a/README.zh.md b/README.zh.md
index 3fa2e55..3c93ea4 100644
