 """Tests for sentrysearch.cli (Click CLI)."""
 
+import json
 import os
 import subprocess
 from unittest.mock import ANY, MagicMock, patch
@@ -94,6 +95,78 @@ class TestStatsCommand:
             assert "10" in result.output
