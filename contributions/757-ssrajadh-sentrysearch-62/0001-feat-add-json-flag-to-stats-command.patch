+    def test_stats_json_with_data(self, runner, tmp_path):
+        present = tmp_path / "video1.mp4"
+        present.write_bytes(b"")
+        missing = str(tmp_path / "gone" / "video2.mp4")
+        with patch("sentrysearch.store.SentryStore") as MockStore, \
+             patch("sentrysearch.store.detect_index", return_value=("local", "qwen2b")):
+            inst = MagicMock()
+            inst.get_stats.return_value = {
+                "total_chunks": 10,
+                "unique_source_files": 2,
+                "source_files": [str(present), missing],
+            }
+            inst.get_backend.return_value = "local"
+            MockStore.return_value = inst
+            result = runner.invoke(cli, ["stats", "--json"])
+            assert result.exit_code == 0, result.output
+            data = json.loads(result.output)
+            assert data == {
+                "backend": "local",
+                "model": "qwen2b",
+                "total_chunks": 10,
+                "unique_source_files": 2,
+                "source_files": [str(present), missing],
+                "missing_files": [missing],
+            }
+
+    def test_stats_json_empty(self, runner):
+        with patch("sentrysearch.store.SentryStore") as MockStore, \
+             patch("sentrysearch.store.detect_index", return_value=(None, None)):
+            inst = MagicMock()
+            inst.get_stats.return_value = {
+                "total_chunks": 0, "unique_source_files": 0, "source_files": [],
+            }
+            inst.get_backend.return_value = "gemini"
+            MockStore.return_value = inst
+            result = runner.invoke(cli, ["stats", "--json"])
+            assert result.exit_code == 0, result.output
+            data = json.loads(result.output)
+            assert data == {
+                "backend": "gemini",
+                "model": None,
+                "total_chunks": 0,
+                "unique_source_files": 0,
+                "source_files": [],
+                "missing_files": [],
+            }
+
+    def test_stats_without_json_is_human_readable(self, runner):
+        with patch("sentrysearch.store.SentryStore") as MockStore, \
+             patch("sentrysearch.store.detect_index", return_value=("local", "qwen2b")), \
+             patch("sentrysearch.cli.os.path.exists",
+                   side_effect=lambda p: p == "/a/video1.mp4"):
+            inst = MagicMock()
+            inst.get_stats.return_value = {
+                "total_chunks": 10,
+                "unique_source_files": 2,
+                "source_files": ["/a/video1.mp4", "/b/video2.mp4"],
+            }
+            inst.get_backend.return_value = "local"
+            MockStore.return_value = inst
+            result = runner.invoke(cli, ["stats"])
+            assert result.exit_code == 0
+            assert result.output == (
+                "Total chunks:  10\n"
+                "Source files:  2\n"
+                "Backend:       local (qwen2b)\n"
+                "\n"
+                "Indexed files:\n"
+                "  /a/video1.mp4\n"
+                "  /b/video2.mp4  [missing]\n"
+            )
+
 
 class TestSearchCommand:
     def test_search_empty_index(self, runner):
