diff --git a/crates/fresh-editor/src/services/remote/tests.rs b/crates/fresh-editor/src/services/remote/tests.rs
index eb267fb..c6ca573 100644
--- a/crates/fresh-editor/src/services/remote/tests.rs
+++ b/crates/fresh-editor/src/services/remote/tests.rs
@@ -354,6 +354,53 @@ mod agent_integration {
         assert!(result.get("dir").and_then(|v| v.as_bool()).unwrap_or(false));
     }
 
+    /// The agent reports whether the remote user may write a path, so the
+    /// client doesn't have to guess from uid/gid that belong to another host
+    /// (#2944).
+    #[test]
+    fn test_agent_stat_reports_writable() {
+        let Some((mut stdin, mut stdout)) = spawn_agent() else {
+            eprintln!("Skipping test: Python3 not available");
+            return;
+        };
+
+        let mut line = String::new();
+        stdout.read_line(&mut line).unwrap();
+
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("notes.txt");
+        std::fs::write(&file, "x").unwrap();
+        let path = file.to_string_lossy().into_owned();
+
+        let writable = |stdin: &mut std::process::ChildStdin,
+                        stdout: &mut BufReader<std::process::ChildStdout>| {
+            send_request(stdin, stdout, "stat", serde_json::json!({ "path": path }))
+                .and_then(|resp| resp.result)
+                .and_then(|result| result.get("writable").and_then(|v| v.as_bool()))
+        };
+
+        assert_eq!(writable(&mut stdin, &mut stdout), Some(true));
+
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&file, std::fs::Permissions::from_mode(0o444)).unwrap();
+            // Root may write a read-only file, so ask the kernel what this
+            // user may do and expect the agent to agree.
+            let c_path = std::ffi::CString::new(path.as_bytes()).unwrap();
+            // SAFETY: `c_path` is a valid NUL-terminated path for the call.
+            let kernel = unsafe {
+                libc::faccessat(
+                    libc::AT_FDCWD,
+                    c_path.as_ptr(),
+                    libc::W_OK,
+                    libc::AT_EACCESS,
+                )
+            } == 0;
+            assert_eq!(writable(&mut stdin, &mut stdout), Some(kernel));
+        }
+    }
+
     #[test]
     fn test_agent_exists_command() {
         let Some((mut stdin, mut stdout)) = spawn_agent() else {
