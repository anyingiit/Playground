     fn test_convert_dir_entry() {
         let re = RemoteDirEntry {
diff --git a/crates/fresh-editor/src/services/remote/protocol.rs b/crates/fresh-editor/src/services/remote/protocol.rs
index d5a5671..d4d15b0 100644
--- a/crates/fresh-editor/src/services/remote/protocol.rs
+++ b/crates/fresh-editor/src/services/remote/protocol.rs
@@ -108,6 +108,11 @@ pub struct RemoteMetadata {
     pub file: bool,
     #[serde(default)]
     pub link: bool,
+    /// Whether the remote user may write the path, as the agent's
+    /// `os.access` decides it on the remote host. `None` from an agent that
+    /// doesn't report it.
+    #[serde(default)]
