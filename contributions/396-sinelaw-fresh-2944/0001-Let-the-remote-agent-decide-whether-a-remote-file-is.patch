diff --git a/crates/fresh-editor/src/services/remote/agent.py b/crates/fresh-editor/src/services/remote/agent.py
index ac9c877..b2d6d5d 100644
--- a/crates/fresh-editor/src/services/remote/agent.py
+++ b/crates/fresh-editor/src/services/remote/agent.py
@@ -172,6 +172,12 @@ def cmd_stat(id, p):
             "dir": stat.S_ISDIR(st.st_mode),
             "file": stat.S_ISREG(st.st_mode),
             "link": is_link,
+            # Whether this host's user may write the path. The client can't
+            # tell from uid/gid: its own ids mean nothing on this host. The
+            # kernel's answer also covers ACLs and read-only mounts.
+            "writable": os.access(
+                path, os.W_OK, effective_ids=os.access in os.supports_effective_ids
+            ),
         },
     )
 
diff --git a/crates/fresh-editor/src/services/remote/filesystem.rs b/crates/fresh-editor/src/services/remote/filesystem.rs
index 5aac6da..7a21170 100644
--- a/crates/fresh-editor/src/services/remote/filesystem.rs
+++ b/crates/fresh-editor/src/services/remote/filesystem.rs
@@ -163,14 +163,24 @@ impl RemoteFileSystem {
         let is_hidden = name.starts_with('.');
         let permissions = FilePermissions::from_mode(rm.mode);
 
-        #[cfg(unix)]
-        let is_readonly = {
-            let (euid, user_groups) =
-                crate::model::filesystem::StdFileSystem::current_user_groups();
-            permissions.is_readonly_for_user(euid, rm.uid, rm.gid, &user_groups)
+        // The agent decides writability as the remote user. Comparing the
+        // file's uid/gid with this process's ids is only a fallback: the two
+        // hosts' ids need not match (#2944).
+        let is_readonly = match rm.writable {
+            Some(writable) => !writable,
+            None => {
+                #[cfg(unix)]
+                {
+                    let (euid, user_groups) =
+                        crate::model::filesystem::StdFileSystem::current_user_groups();
+                    permissions.is_readonly_for_user(euid, rm.uid, rm.gid, &user_groups)
+                }
+                #[cfg(not(unix))]
+                {
+                    permissions.is_readonly()
+                }
+            }
         };
-        #[cfg(not(unix))]
-        let is_readonly = permissions.is_readonly();
 
         let mut meta = FileMetadata::new(rm.size)
             .with_hidden(is_hidden)
@@ -1030,6 +1040,7 @@ mod tests {
             dir: false,
             file: true,
             link: false,
+            writable: None,
         };
 
         let meta = RemoteFileSystem::convert_metadata(&rm, "test.txt");
@@ -1041,6 +1052,44 @@ mod tests {
         assert!(meta.is_hidden);
     }
 
+    /// Writability comes from the agent, which checks it as the remote user:
+    /// the remote file's uid/gid say nothing about this process's ids (#2944).
+    #[test]
+    fn test_convert_metadata_uses_the_agents_writable() {
+        #[cfg(unix)]
+        let (own_uid, own_gid) = {
+            let (euid, groups) = crate::model::filesystem::StdFileSystem::current_user_groups();
+            (euid, *groups.first().unwrap_or(&0u32))
+        };
+        #[cfg(not(unix))]
+        let (own_uid, own_gid) = (1000u32, 1000u32);
+
+        // Owned by another uid and only owner-writable, the way a file of
+        // the SSH user looks from a local user with a different uid.
+        let theirs = RemoteMetadata {
+            size: 1,
+            mtime: 0,
+            mode: 0o100644,
+            uid: own_uid.wrapping_add(4242),
+            gid: own_gid.wrapping_add(4242),
+            dir: false,
+            file: true,
+            link: false,
+            writable: Some(true),
+        };
+        assert!(!RemoteFileSystem::convert_metadata(&theirs, "notes.txt").is_readonly);
+
+        // And the other way round: the ids match ours, but the remote user
+        // may not write it.
+        let denied = RemoteMetadata {
+            uid: own_uid,
+            gid: own_gid,
+            writable: Some(false),
+            ..theirs
+        };
+        assert!(RemoteFileSystem::convert_metadata(&denied, "notes.txt").is_readonly);
+    }
+
