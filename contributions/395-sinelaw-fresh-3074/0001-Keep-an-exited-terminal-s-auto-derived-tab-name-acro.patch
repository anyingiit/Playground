diff --git a/crates/fresh-editor/tests/e2e/restart_exited_terminal.rs b/crates/fresh-editor/tests/e2e/restart_exited_terminal.rs
index fd84959..69f77fc 100644
--- a/crates/fresh-editor/tests/e2e/restart_exited_terminal.rs
+++ b/crates/fresh-editor/tests/e2e/restart_exited_terminal.rs
@@ -534,3 +534,111 @@ fn test_terminal_tab_title_survives_an_editor_restart() {
         harness.assert_screen_not_contains("*Terminal");
     }
 }
+
+/// An auto-named terminal that had already exited keeps the name it had
+/// derived from its process across an editor restart.
+///
+/// Only explicit titles were persisted, and an auto-named tab re-derives its
+/// name from the live process after restore — but a restored dead terminal
+/// has no process, so it came back as a bare `*Terminal N*`, and two dead
+/// shells from different directories could no longer be told apart.
+///
+/// Linux-only, like the other auto-naming tests: the foreground process is
+/// read via `tcgetpgrp` + `/proc`.
+#[cfg(target_os = "linux")]
+#[test]
+fn test_exited_auto_named_terminal_keeps_its_name_across_an_editor_restart() {
+    if !pty_available() {
+        eprintln!("Skipping terminal-restart test: PTY not available");
+        return;
+    }
+
+    let temp_dir = TempDir::new().unwrap();
+    let project_dir = temp_dir.path().join("project");
+    std::fs::create_dir(&project_dir).unwrap();
+    let dir_context = DirectoryContext::for_testing(temp_dir.path());
+
+    let session = |dir_context: &DirectoryContext| {
+        let mut harness = EditorTestHarness::create(
+            120,
+            30,
+            HarnessOptions::new()
+                .with_config(terminal_config())
+                .with_working_dir(project_dir.clone())
+                .with_shared_dir_context(dir_context.clone())
+                .without_empty_plugins_dir(),
+        )
+        .unwrap();
+        // The harness turns auto-naming off for deterministic tabs elsewhere.
+        let mut config = harness.editor().config().clone();
+        config.editor.terminal_auto_title = true;
+        harness.editor_mut().set_config(config);
+        harness
+    };
+
+    // What the tab auto-names to: the shell the terminal runs (plus, with a
+    // prompt that sets one, the shell's OSC title). Derived from the same
+    // `detect_shell()` the spawn uses, so the test knows it independently.
+    let shell = fresh::services::terminal::detect_shell();
+    let shell = std::path::Path::new(&shell)
+        .file_name()
+        .expect("shell path has a file name")
+        .to_string_lossy()
+        .to_string();
+
+    // ---- Session 1: a plain shell names its tab, then exits. ----
+    {
+        let mut harness = session(&dir_context);
+        harness.editor_mut().set_session_mode(true);
+        harness.editor_mut().open_terminal();
+        harness.render().unwrap();
+        harness
+            .wait_until(|h| h.get_tab_bar().contains(&shell))
+            .expect("the tab should auto-name from the shell");
+        harness.type_text("exit").unwrap();
+        harness
+            .send_key(KeyCode::Enter, KeyModifiers::NONE)
+            .unwrap();
+        harness
+            .wait_until(|h| h.get_tab_bar().contains("(exited)"))
+            .expect("the shell should exit");
+        assert!(
+            harness.get_tab_bar().contains(&shell),
+            "the exited tab keeps its name in this session\nTab bar: {}",
+            harness.get_tab_bar()
+        );
+        harness.shutdown(true).unwrap();
+    }
+
+    // ---- Session 2: reopen. ----
+    {
+        let mut harness = session(&dir_context);
+        assert!(
+            harness.startup(true, &[]).unwrap(),
+            "the workspace should have been restored"
+        );
+        harness.render().unwrap();
+        harness
+            .wait_until(|h| h.get_tab_bar().contains("(exited)"))
+            .expect("the dead shell's tab should be restored");
+        let tab_bar = harness.get_tab_bar();
+        assert!(
+            tab_bar.contains(&shell),
+            "the restored dead tab should keep its derived name\nTab bar: {tab_bar}"
+        );
+        assert!(
+            !tab_bar.contains("*Terminal"),
+            "not the generic fallback\nTab bar: {tab_bar}"
+        );
+
+        // It is still auto-named: restarting it names the tab from the new
+        // shell again.
+        click_restart_indicator(&mut harness, "⟳ Restart");
+        harness
+            .wait_until(|h| {
+                let tab_bar = h.get_tab_bar();
+                tab_bar.contains(&shell) && !tab_bar.contains("(exited)")
+            })
+            .expect("the restarted shell should name its tab again");
+    }
+}
