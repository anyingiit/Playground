     }
 
@@ -1736,12 +1737,19 @@ impl Editor {
                 // no live process left to read a name from, so it gets the
                 // marker on its current name and stops being auto-updated
                 // (`sync_terminal_titles` only walks live `terminal_buffers`).
-                record.title = window
-                    .terminal_explicit_titles
-                    .contains(&buffer_id)
-                    .then(|| window.buffer_metadata.get(&buffer_id))
-                    .flatten()
+                let name = window
+                    .buffer_metadata
+                    .get(&buffer_id)
                     .map(|meta| meta.display_name.clone());
+                if window.terminal_explicit_titles.contains(&buffer_id) {
+                    record.title = name;
+                } else {
+                    // Keep the auto-derived name so a saved workspace can
+                    // put it back on the restored dead tab; the generic
+                    // `*Terminal N*` is regenerated on restore anyway.
+                    let fallback = format!("*Terminal {}*", terminal_id.0);
+                    record.auto_title = name.filter(|n| *n != fallback);
+                }
                 if let Some(meta) = window.buffer_metadata.get_mut(&buffer_id) {
                     meta.display_name =
                         t!("terminal.tab_exited", name = meta.display_name).to_string();
