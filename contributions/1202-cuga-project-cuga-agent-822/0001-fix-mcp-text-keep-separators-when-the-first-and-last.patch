From 17d49820bf861b0d280f732a1d90b02a1eb96a66 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 23:13:22 +0000
Subject: [PATCH] fix(mcp-text): keep separators when the first and last chunk
 text match

_chunk_recursive decided whether a piece was the last one with the
identity check `part is not parts[-1]`. When the first and last pieces
are equal one-character or empty strings, CPython hands back the same
cached object for both, so the first piece was treated as the last and
lost its separator, and the chunks no longer joined back to the input:

    _chunk_recursive("a\n\nbbbbb\n\na", 6, 0, ...)
    -> ['a', 'bbbbb\n\n', 'a']   (expected ['a\n\n', 'bbbbb\n\n', 'a'])

    _chunk_recursive("\n\nbbbbbbbb\n\n", 6, 0, ...)
    -> ['bbbbbbbb\n']            (leading "\n\n" and one "\n" lost)

Use the loop index instead, and add an mcp-text integration test for
both inputs.

Fixes cuga-project/cuga-agent#822

Signed-off-by: anyingiit <49945850+anyingiit@users.noreply.github.com>
---
 cuga-apps/mcp_servers/text/server.py |  4 ++--
 cuga-apps/tests/test_mcp_tools.py    | 17 +++++++++++++++++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/cuga-apps/mcp_servers/text/server.py b/cuga-apps/mcp_servers/text/server.py
index aa0a7b1..a3f5588 100644
--- a/cuga-apps/mcp_servers/text/server.py
+++ b/cuga-apps/mcp_servers/text/server.py
@@ -57,8 +57,8 @@ def _chunk_recursive(text: str, size: int, overlap: int, seps: list[str]) -> lis
     chunks: list[str] = []
     buf: list[str] = []
     cur_len = 0
-    for part in parts:
-        piece = part + (sep if part is not parts[-1] else "")
+    for i, part in enumerate(parts):
+        piece = part + (sep if i < len(parts) - 1 else "")
         if cur_len + len(piece) > size and buf:
             chunks.append("".join(buf))
             tail_overlap = "".join(buf)[-overlap:] if overlap > 0 else ""
diff --git a/cuga-apps/tests/test_mcp_tools.py b/cuga-apps/tests/test_mcp_tools.py
index 8397ea1..2f7cd93 100644
--- a/cuga-apps/tests/test_mcp_tools.py
+++ b/cuga-apps/tests/test_mcp_tools.py
@@ -424,6 +424,23 @@ class TestMcpText:
         for piece in ("Section one", "Section two", "Section three"):
             assert piece in joined
 
+    def test_chunk_text_recursive_keeps_separators(self):
+        # First and last pieces are the same text (here "a", and "" when the text
+        # starts and ends with a separator): every separator must survive, so the
+        # chunks join back to the exact input when overlap is 0.
+        text = "a\n\nbbbbb\n\na"
+        data = _expect_ok(call_mcp_tool("text", "chunk_text", {
+            "text": text, "strategy": "recursive", "size": 6, "overlap": 0,
+        }))
+        assert data["chunks"] == ["a\n\n", "bbbbb\n\n", "a"]
+        assert "".join(data["chunks"]) == text
+
+        text = "\n\nbbbbbbbb\n\n"
+        data = _expect_ok(call_mcp_tool("text", "chunk_text", {
+            "text": text, "strategy": "recursive", "size": 6, "overlap": 0,
+        }))
+        assert "".join(data["chunks"]) == text
+
     def test_chunk_text_fixed_chars(self):
         text = "x" * 1000
         data = _expect_ok(call_mcp_tool("text", "chunk_text", {
