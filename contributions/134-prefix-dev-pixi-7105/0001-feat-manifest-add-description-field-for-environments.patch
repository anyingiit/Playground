+    #[test]
+    fn test_environment_description() {
+        let file_contents = r#"
+            [workspace]
+            name = "foo"
+            channels = []
+            platforms = []
+
+            [feature.test.dependencies]
+            pytest = "*"
+
+            [environments]
+            test = { features = ["test"], description = "Run the test suite" }
+            docs = { description = "Build the documentation" }
+            lint = ["test"]
+        "#;
+        let manifest = parse_pixi_toml(file_contents).manifest;
+
+        assert_eq!(manifest.default_environment().description, None);
+
+        let test_env = manifest.environment("test").unwrap();
+        assert_eq!(test_env.features, vec!["test"]);
+        assert_eq!(test_env.description.as_deref(), Some("Run the test suite"));
+
+        // A description on its own is enough to define an environment that
+        // only uses the default feature.
+        let docs_env = manifest.environment("docs").unwrap();
+        assert!(docs_env.features.is_empty());
+        assert!(!docs_env.no_default_feature);
+        assert_eq!(
+            docs_env.description.as_deref(),
+            Some("Build the documentation")
+        );
+
+        let lint_env = manifest.environment("lint").unwrap();
+        assert_eq!(lint_env.description, None);
+    }
+
+    #[test]
+    fn test_editing_environment_features_keeps_description() {
+        let contents = r#"
+[workspace]
+name = "foo"
+channels = []
+platforms = ["linux-64"]
+
+[feature.shared.dependencies]
+some-package = "*"
+
+[feature.extra.dependencies]
+other-package = "*"
+
+[environments]
+dev = { features = ["shared"], description = "Development environment" }
+"#;
+
+        let mut manifest = parse_pixi_toml(contents);
+        let mut manifest = manifest.editable();
+
+        manifest
+            .remove_feature(&FeatureName::from_str("shared").unwrap())
+            .unwrap();
+        let env = manifest.workspace.environment("dev").unwrap();
+        assert_eq!(env.description.as_deref(), Some("Development environment"));
+
+        let environment_name = EnvironmentName::from_str("dev").unwrap();
+        manifest
+            .update_environment_features(&environment_name, vec![FeatureName::from("extra")])
+            .unwrap();
+        let env = manifest.workspace.environment("dev").unwrap();
+        assert_eq!(env.features, vec![FeatureName::from("extra")]);
+        assert_eq!(env.description.as_deref(), Some("Development environment"));
+
+        // The description is kept in the document as well.
+        let reparsed = parse_pixi_toml(&manifest.document.to_string()).manifest;
+        assert_eq!(
+            reparsed.environment("dev").unwrap().description.as_deref(),
+            Some("Development environment")
+        );
+    }
