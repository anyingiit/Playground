+def test_pixi_info_environment_description(pixi: Path, tmp_pixi_workspace: Path) -> None:
+    manifest = tmp_pixi_workspace.joinpath("pixi.toml")
+    toml = """
+        [workspace]
+        name = "test"
+        channels = []
+        platforms = ["linux-64", "win-64", "osx-64"]
+
+        [feature.test.tasks]
+        test = "echo test"
+
+        [environments]
+        test = { features = ["test"], description = "Environment for running the tests" }
+        docs = { description = "Environment for building the docs" }
+        """
+    manifest.write_text(toml)
+    verify_cli_command(
+        [pixi, "info", "--manifest-path", manifest],
+        stdout_contains=[
+            "Description: Environment for running the tests",
+            "Description: Environment for building the docs",
+        ],
+    )
+
+    result = verify_cli_command([pixi, "info", "--manifest-path", manifest, "--json"])
+    environments = {env["name"]: env for env in json.loads(result.stdout)["environments_info"]}
+    assert environments["default"]["description"] is None
+    assert environments["test"]["description"] == "Environment for running the tests"
+    assert environments["docs"]["description"] == "Environment for building the docs"
+
