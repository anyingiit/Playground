         seed = _profile_urn(profile_id)
         if seed not in agent_profile_seed_urns(self._drg):
             return frozenset()
-        return profile_channel_reachable(self._drg, {seed})
+        reached: frozenset[str] = profile_channel_reachable(self._drg, {seed})
