+# Homebrew's alias for OS::Mac (os/mac.rb), which formulae use as `MacOS.version`.
+MacOS = OS::Mac
+
 class MacOSVersion
   include Comparable
 
@@ -691,7 +694,36 @@ FORMULA_DATA_CONTENT = end_marker_idx ? formula_raw[(formula_raw.index("\n", end
 ENV["HOMEBREW_PREFIX"] = ZEROBREW_PREFIX
