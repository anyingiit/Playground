index 0000000..c97d107
--- /dev/null
+++ b/.changes/1276-vinext-detected-as-next.md
@@ -0,0 +1,3 @@
+### Fixed
+
+- **`@reticlehq/init` — a Vinext app was detected as Next.js.** Vinext depends on `next` for the API surface but builds through Vite, so `init` wired `withReticle` into a `next.config` that Vinext never evaluates and the app never connected. A project that depends on `vinext` is now detected as a Vite app and gets the Vite plugin. Closes [#1276](https://github.com/reticlehq/reticle/issues/1276).
diff --git a/init/src/detect/detect.test.ts b/init/src/detect/detect.test.ts
index de14d26..57c6f03 100644
--- a/init/src/detect/detect.test.ts
+++ b/init/src/detect/detect.test.ts
@@ -57,6 +57,18 @@ describe('detect framework', () => {
       Framework.NEXT,
     );
   });
+  /**
+   * Vinext reimplements the Next.js API on Vite: it depends on `next` for the API surface but never
+   * runs Next's build, so `withReticle` in `next.config.*` is never evaluated and the app never
+   * connects. It builds through `vite.config.*`, where the Vite plugin does run.
+   */
+  it('detects a Vinext app as vite, not next, even with a next.config', () => {
+    const vinext = input({
+      pkg: { dependencies: { next: '15', vinext: '0.1.0', vite: '7' } },
+      configFiles: new Set(['next.config.ts', 'vite.config.ts']),
+    });
+    expect(detect(vinext).framework).toBe(Framework.VITE);
+  });
   it('detects SvelteKit from the @sveltejs/kit dep (even though it ships vite)', () => {
     expect(
       detect(input({ pkg: { devDependencies: { '@sveltejs/kit': '^2', vite: '^5' } } })).framework,
