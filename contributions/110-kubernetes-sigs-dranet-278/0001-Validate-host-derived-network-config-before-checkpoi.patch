 	}
 
+	// Let the provider validate the final configuration, including the state
+	// derived from the host, before it is persisted. On failure the interface
+	// stays in the host namespace and kubelet retries the preparation.
+	if err := np.netdb.ValidateNetworkConfig(result.Device, &deviceCfg.NetworkInterfaceConfigInPod); err != nil {
+		return fmt.Errorf("device %s: provider rejected the network configuration of interface %s: %w", result.Device, ifName, err)
+	}
+
