+// ValidateNetworkConfig lets the cloud provider validate the final network
+// configuration of a device before it is persisted. It is a no-op unless the
+// cloud provider implements cloudprovider.NetworkConfigValidator.
+func (db *DB) ValidateNetworkConfig(deviceName string, config *apis.NetworkConfig) error {
+	v, ok := db.instance.(cloudprovider.NetworkConfigValidator)
+	if !ok {
+		return nil
+	}
+
+	db.mu.RLock()
+	device, exists := db.deviceStore[deviceName]
+	db.mu.RUnlock()
+
+	if !exists {
+		return fmt.Errorf("device %s not found in inventory", deviceName)
+	}
+
+	return v.ValidateNetworkConfig(getDeviceIdentifiers(&device), config)
+}
