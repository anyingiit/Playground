diff --git a/pkg/cloudprovider/cloud.go b/pkg/cloudprovider/cloud.go
index 194d525..1355e47 100644
--- a/pkg/cloudprovider/cloud.go
+++ b/pkg/cloudprovider/cloud.go
@@ -54,3 +54,20 @@ type ProfileProvider interface {
 	// previously allocated for the given claim and profile.
 	ReleaseProfileConfig(id DeviceIdentifiers, claimUID types.UID, config *apis.NetworkConfig) error
 }
+
+// NetworkConfigValidator is an optional interface implemented by cloud providers
+// that need to verify the final network configuration of a device, including
+// the routes, rules and neighbors that DraNet derived from the host, before it
+// is persisted and later applied inside the Pod network namespace.
+//
+// This is useful on platforms where a host agent configures the network
+// asynchronously, so a snapshot taken during NodePrepareResources may be
+// incomplete. Implementations must be read-only: they must not modify the
+// given config nor the host network state. Returning an error fails the
+// preparation of the device, leaving the interface in the host network
+// namespace so that kubelet retries NodePrepareResources later.
+type NetworkConfigValidator interface {
+	// ValidateNetworkConfig returns an error if config is not a valid
+	// configuration for the device identified by id.
+	ValidateNetworkConfig(id DeviceIdentifiers, config *apis.NetworkConfig) error
+}
diff --git a/pkg/driver/dra_hooks.go b/pkg/driver/dra_hooks.go
