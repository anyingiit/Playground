+type validatingProvider struct {
+	mockCloudInstance
+	gotID     cloudprovider.DeviceIdentifiers
+	gotConfig *apis.NetworkConfig
+	err       error
+}
+
+func (p *validatingProvider) ValidateNetworkConfig(id cloudprovider.DeviceIdentifiers, config *apis.NetworkConfig) error {
+	p.gotID = id
+	p.gotConfig = config
+	return p.err
+}
+
+func TestValidateNetworkConfig(t *testing.T) {
+	device := resourceapi.Device{
+		Name: "pci-0000-00-01-0",
+		Attributes: map[resourceapi.QualifiedName]resourceapi.DeviceAttribute{
+			apis.AttrInterfaceName: {StringValue: ptr.To("eth1")},
+			apis.AttrMac:           {StringValue: ptr.To("00:11:22:33:44:55")},
+			apis.AttrPCIAddress:    {StringValue: ptr.To("0000:00:01.0")},
+		},
+	}
+	config := &apis.NetworkConfig{Interface: apis.InterfaceConfig{Name: "eth1"}}
+
+	t.Run("no cloud provider", func(t *testing.T) {
+		db := New()
+		db.updateDeviceStore([]resourceapi.Device{device})
+		if err := db.ValidateNetworkConfig(device.Name, config); err != nil {
+			t.Errorf("ValidateNetworkConfig() unexpected error: %v", err)
+		}
+	})
+
+	t.Run("provider without validator", func(t *testing.T) {
+		db := New(WithCloudInstance(&mockCloudInstance{}))
+		db.updateDeviceStore([]resourceapi.Device{device})
+		if err := db.ValidateNetworkConfig(device.Name, config); err != nil {
+			t.Errorf("ValidateNetworkConfig() unexpected error: %v", err)
+		}
+	})
+
+	t.Run("provider accepts the config", func(t *testing.T) {
+		provider := &validatingProvider{}
+		db := New(WithCloudInstance(provider))
+		db.updateDeviceStore([]resourceapi.Device{device})
+		if err := db.ValidateNetworkConfig(device.Name, config); err != nil {
+			t.Fatalf("ValidateNetworkConfig() unexpected error: %v", err)
+		}
+		wantID := cloudprovider.DeviceIdentifiers{Name: "eth1", MAC: "00:11:22:33:44:55", PCIAddress: "0000:00:01.0"}
+		if diff := cmp.Diff(wantID, provider.gotID); diff != "" {
+			t.Errorf("identifiers mismatch (-want +got):\n%s", diff)
+		}
+		if provider.gotConfig != config {
+			t.Errorf("provider got config %v, want %v", provider.gotConfig, config)
+		}
+	})
+
+	t.Run("provider rejects the config", func(t *testing.T) {
+		wantErr := errors.New("connected route not yet configured")
+		db := New(WithCloudInstance(&validatingProvider{err: wantErr}))
+		db.updateDeviceStore([]resourceapi.Device{device})
+		if err := db.ValidateNetworkConfig(device.Name, config); !errors.Is(err, wantErr) {
+			t.Errorf("ValidateNetworkConfig() error = %v, want %v", err, wantErr)
+		}
+	})
+
+	t.Run("device not in inventory", func(t *testing.T) {
+		provider := &validatingProvider{}
+		db := New(WithCloudInstance(provider))
+		if err := db.ValidateNetworkConfig(device.Name, config); err == nil {
+			t.Errorf("ValidateNetworkConfig() expected an error for a device missing from the inventory")
+		}
+		if provider.gotConfig != nil {
+			t.Errorf("provider was called for a device missing from the inventory")
+		}
+	})
+}
