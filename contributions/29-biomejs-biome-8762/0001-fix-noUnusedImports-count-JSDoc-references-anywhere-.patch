             }
-            WalkEvent::Leave(_) => {}
+            WalkEvent::Enter(_) | WalkEvent::Leave(_) => {}
         }
     }
 
@@ -552,9 +546,23 @@ impl Visitor for JsDocTypeCollectorVisitor {
