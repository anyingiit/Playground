 }
 
-fn load_jsdoc_types_from_node(model: &mut JsDocTypeModel, node: &SyntaxNode<JsLanguage>) {
-    JsdocComment::get_jsdocs(node)
-        .for_each(|comment| load_jsdoc_types_from_jsdoc_comment(model, comment.as_str()));
+/// Collects the types referenced by every JSDoc comment of the file.
+///
+/// Comments are trivia of the following (or preceding) token, so JSDoc comments placed
+/// before an import, before a non-declaration statement, or at the end of the file
+/// are collected too.
+fn load_jsdoc_types_from_root(model: &mut JsDocTypeModel, root: &SyntaxNode<JsLanguage>) {
+    for token in root.descendants_tokens(Direction::Next) {
+        for piece in token
+            .leading_trivia()
+            .pieces()
+            .chain(token.trailing_trivia().pieces())
+        {
+            if piece.is_comments() && JsdocComment::text_is_jsdoc_comment(piece.text()) {
+                load_jsdoc_types_from_jsdoc_comment(model, piece.text());
+            }
+        }
+    }
 }
 
