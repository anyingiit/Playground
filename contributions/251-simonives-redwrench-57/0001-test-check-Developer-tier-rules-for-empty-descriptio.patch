From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:30:12 +0000
Subject: [PATCH] test: check Developer tier rules for empty descriptions (#57)

no_tier_rule_has_an_empty_description was written before
TierName::Developer existed and only iterated Safe, Standard and
Unrestricted, so the DEVELOPER_TOOLS allows were never checked. Add
Developer to the iterated tiers.
---
 src/policy/tiers.rs | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/policy/tiers.rs b/src/policy/tiers.rs
index 6cfd4b3..f7187fb 100644
--- a/src/policy/tiers.rs
+++ b/src/policy/tiers.rs
@@ -796,7 +796,12 @@ mod tests {
 
     #[test]
     fn no_tier_rule_has_an_empty_description() {
-        for tier in [TierName::Safe, TierName::Standard, TierName::Unrestricted] {
+        for tier in [
+            TierName::Safe,
+            TierName::Standard,
+            TierName::Developer,
+            TierName::Unrestricted,
+        ] {
             for rule in rules_for_tier(&tier) {
                 assert!(
                     !rule.description.trim().is_empty(),
-- 
