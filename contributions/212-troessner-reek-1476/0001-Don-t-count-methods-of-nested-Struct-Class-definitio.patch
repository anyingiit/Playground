From 81cc160eceb1403a0cf0ca758560bd6ad9ecd4b2 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:52:55 +0000
Subject: [PATCH] Don't count methods of nested Struct/Class definitions in
 TooManyMethods

Methods defined in the block of a module-defining constant assignment,
e.g. `Foo = Struct.new(:bar) do ... end`, belong to the module created
there, not to the enclosing class. Exclude them from
ModuleContext#node_instance_methods, using the same defines_module? check
that ContextBuilder uses to open a separate module context. Other
constant assignments that contain a def are still counted.

Fixes #1476
---
 lib/reek/context/module_context.rb            |  9 ++-
 .../smell_detectors/too_many_methods_spec.rb  | 64 +++++++++++++++++++
 2 files changed, 72 insertions(+), 1 deletion(-)

diff --git a/lib/reek/context/module_context.rb b/lib/reek/context/module_context.rb
index 2a62b7a..5fa1d00 100644
--- a/lib/reek/context/module_context.rb
+++ b/lib/reek/context/module_context.rb
@@ -59,11 +59,18 @@ module Reek
         instance_method_calls.flat_map(&:method_name_called_to_call).compact
       end
 
+      #
+      # Methods defined in the block of a module-defining constant assignment,
+      # like `Foo = Struct.new(:bar) do ... end`, belong to the module created
+      # there and are not included.
       #
       # @deprecated use `defined_instance_methods` instead
       #
       def node_instance_methods
-        local_nodes(:def).to_a
+        nested_module_method_ids = local_nodes(:casgn).
+          select(&:defines_module?).
+          flat_map { |casgn| casgn.each_node(:def).map(&:object_id) }
+        local_nodes(:def).reject { |node| nested_module_method_ids.include?(node.object_id) }
       end
 
       def descriptively_commented?
diff --git a/spec/reek/smell_detectors/too_many_methods_spec.rb b/spec/reek/smell_detectors/too_many_methods_spec.rb
index 3143ae1..3552d3d 100644
--- a/spec/reek/smell_detectors/too_many_methods_spec.rb
+++ b/spec/reek/smell_detectors/too_many_methods_spec.rb
@@ -53,4 +53,68 @@ RSpec.describe Reek::SmellDetectors::TooManyMethods do
 
     expect(src).not_to reek_of(:TooManyMethods).with_config(config)
   end
+
+  it 'stops at a nested Struct definition' do
+    src = <<-RUBY
+      class Alfa
+        Hidden = Struct.new(:bravo) do
+          def charlie; end
+          def delta; end
+        end
+
+        def echo; end
+        def foxtrot; end
+      end
+    RUBY
+
+    expect(src).not_to reek_of(:TooManyMethods).with_config(config)
+  end
+
+  it 'stops at a nested Class.new definition' do
+    src = <<-RUBY
+      class Alfa
+        Hidden = Class.new do
+          def charlie; end
+          def delta; end
+        end
+
+        def echo; end
+        def foxtrot; end
+      end
+    RUBY
+
+    expect(src).not_to reek_of(:TooManyMethods).with_config(config)
+  end
+
+  it 'counts methods defined in other kinds of constant assignment' do
+    src = <<-RUBY
+      class Alfa
+        Bravo = class_eval do
+          def charlie; end
+          def delta; end
+        end
+        Echo = def foxtrot; end
+        def golf; end
+      end
+    RUBY
+
+    expect(src).to reek_of(:TooManyMethods, count: 4).with_config(config)
+  end
+
+  it 'counts an outer method that looks the same as one in a nested Struct' do
+    src = <<-RUBY
+      class Alfa
+        Hidden = Struct.new(:bravo) do
+          def charlie; end
+        end
+
+        def charlie; end
+        def delta; end
+        def echo; end
+        def foxtrot; end
+      end
+    RUBY
+
+    expect(src).to reek_of(:TooManyMethods, count: 4).with_config(config)
+  end
 end
