diff --git a/internal/httprule/parse.go b/internal/httprule/parse.go
index 65ffcf5..3ef0c9b 100644
--- a/internal/httprule/parse.go
+++ b/internal/httprule/parse.go
@@ -18,6 +18,50 @@ func (e InvalidTemplateError) Error() string {
 
 // Parse parses the string representation of path template
 func Parse(tmpl string) (Compiler, error) {
+	return parse(tmpl)
+}
+
+// Segment is a top-level segment of a parsed path template.
+type Segment struct {
+	// FieldPath is the field path bound by a variable segment, e.g. "name"
+	// for "{name=projects/*}". It is empty for literal and wildcard segments.
+	FieldPath string
+	// Value is the literal or wildcard ("*" or "**") of a non-variable
+	// segment, or the pattern of a variable segment, e.g. "projects/*" for
+	// "{name=projects/*}". A variable without an explicit pattern, such as
+	// "{name}", has the pattern "*".
+	Value string
+}
+
+// SplitTemplate parses the string representation of path template and
+// returns its top-level segments and its verb. The root template "/" has no
+// segments.
+func SplitTemplate(tmpl string) (segments []Segment, verb string, err error) {
+	t, err := parse(tmpl)
+	if err != nil {
+		return nil, "", err
+	}
+	for _, s := range t.segments {
+		switch s := s.(type) {
+		case literal:
+			if s == eof {
+				continue
+			}
+			segments = append(segments, Segment{Value: string(s)})
+		case variable:
+			pattern := make([]string, 0, len(s.segments))
+			for _, vs := range s.segments {
+				pattern = append(pattern, vs.String())
+			}
+			segments = append(segments, Segment{FieldPath: s.path, Value: strings.Join(pattern, "/")})
+		default:
+			segments = append(segments, Segment{Value: s.String()})
+		}
+	}
+	return segments, t.verb, nil
+}
+
+func parse(tmpl string) (template, error) {
 	if !strings.HasPrefix(tmpl, "/") {
 		return template{}, InvalidTemplateError{tmpl: tmpl, msg: "no leading /"}
 	}
diff --git a/internal/httprule/parse_test.go b/internal/httprule/parse_test.go
index 7bf11a3..91d54f9 100644
--- a/internal/httprule/parse_test.go
+++ b/internal/httprule/parse_test.go
@@ -436,3 +436,62 @@ func TestParseSegmentsWithErrors(t *testing.T) {
 		}
 	}
 }
+
+func TestSplitTemplate(t *testing.T) {
+	for _, spec := range []struct {
+		tmpl     string
+		segments []Segment
+		verb     string
+	}{
+		{
+			tmpl: "/",
+		},
+		{
+			tmpl: "/:verb",
+			verb: "verb",
+		},
+		{
+			tmpl: "/v1/a:b:verb",
+			segments: []Segment{
+				{Value: "v1"},
+				{Value: "a:b"},
+			},
+			verb: "verb",
+		},
+		{
+			tmpl: "/v1/*/**",
+			segments: []Segment{
+				{Value: "v1"},
+				{Value: "*"},
+				{Value: "**"},
+			},
+		},
+		{
+			tmpl: "/v1/{name}/{parent.name=projects/*/topics/**}:verb:with:colons",
+			segments: []Segment{
+				{Value: "v1"},
+				{FieldPath: "name", Value: "*"},
+				{FieldPath: "parent.name", Value: "projects/*/topics/**"},
+			},
+			verb: "verb:with:colons",
+		},
+	} {
+		segments, verb, err := SplitTemplate(spec.tmpl)
+		if err != nil {
+			t.Errorf("SplitTemplate(%q) failed with %v; want success", spec.tmpl, err)
+			continue
+		}
+		if !reflect.DeepEqual(segments, spec.segments) {
+			t.Errorf("SplitTemplate(%q) segments = %#v; want %#v", spec.tmpl, segments, spec.segments)
+		}
+		if verb != spec.verb {
+			t.Errorf("SplitTemplate(%q) verb = %q; want %q", spec.tmpl, verb, spec.verb)
+		}
+	}
+
+	for _, tmpl := range []string{"", "v1", "/v1/", "/v1/:verb", "/v1/{name"} {
+		if _, _, err := SplitTemplate(tmpl); err == nil {
+			t.Errorf("SplitTemplate(%q) succeeded; want an error", tmpl)
+		}
+	}
+}
