+package org.openrewrite.cucumber.jvm;
+
+import org.junit.jupiter.api.Test;
+import org.openrewrite.DocumentExample;
+import org.openrewrite.InMemoryExecutionContext;
+import org.openrewrite.Issue;
+import org.openrewrite.java.JavaParser;
+import org.openrewrite.test.RecipeSpec;
+import org.openrewrite.test.RewriteTest;
+
+import static org.openrewrite.java.Assertions.java;
+
+@Issue("https://github.com/openrewrite/rewrite-cucumber-jvm/issues/63")
+class AddTestContextToScenariosTest implements RewriteTest {
+
+    @Override
+    public void defaults(RecipeSpec spec) {
+        spec.recipe(new AddTestContextToScenarios())
+          .parser(JavaParser.fromJavaVersion().classpathFromResources(new InMemoryExecutionContext(),
+            "cucumber-testng-7", "testng"));
+    }
+
+    @DocumentExample
+    @Test
+    void passTestContextToSuper() {
+        rewriteRun(
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+              import org.testng.annotations.DataProvider;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+
+                  @Override
+                  @DataProvider(parallel = true)
+                  public Object[][] scenarios() {
+                      return super.scenarios();
+                  }
+              }
+              """,
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+              import org.testng.ITestContext;
+              import org.testng.annotations.DataProvider;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+
+                  @Override
+                  @DataProvider(parallel = true)
+                  public Object[][] scenarios(ITestContext context) {
+                      return super.scenarios(context);
+                  }
+              }
+              """
+          )
+        );
+    }
+
+    @Test
+    void overrideInIntermediateBaseClass() {
+        rewriteRun(
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+
+              public abstract class BaseCucumberTest extends AbstractTestNGCucumberTests {
+              }
+              """
+          ),
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              import org.testng.annotations.DataProvider;
+
+              public class RunCucumberTest extends BaseCucumberTest {
+
+                  @Override
+                  @DataProvider(parallel = true)
+                  public Object[][] scenarios() {
+                      Object[][] scenarios = super.scenarios();
+                      return scenarios;
+                  }
+              }
+              """,
+            """
+              package com.example.app;
+
+              import org.testng.ITestContext;
+              import org.testng.annotations.DataProvider;
+
+              public class RunCucumberTest extends BaseCucumberTest {
+
+                  @Override
+                  @DataProvider(parallel = true)
+                  public Object[][] scenarios(ITestContext context) {
+                      Object[][] scenarios = super.scenarios(context);
+                      return scenarios;
+                  }
+              }
+              """
+          )
+        );
+    }
+
+    @Test
+    void avoidClashWithExistingContextVariable() {
+        rewriteRun(
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+              import org.testng.annotations.DataProvider;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+
+                  @Override
+                  @DataProvider(parallel = true)
+                  public Object[][] scenarios() {
+                      String context = "unused";
+                      return super.scenarios();
+                  }
+              }
+              """,
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+              import org.testng.ITestContext;
+              import org.testng.annotations.DataProvider;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+
+                  @Override
+                  @DataProvider(parallel = true)
+                  public Object[][] scenarios(ITestContext testContext) {
+                      String context = "unused";
+                      return super.scenarios(testContext);
+                  }
+              }
+              """
+          )
+        );
+    }
+
+    @Test
+    void overrideWithoutSuperCall() {
+        rewriteRun(
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+
+                  @Override
+                  public Object[][] scenarios() {
+                      return new Object[0][];
+                  }
+              }
+              """,
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+              import org.testng.ITestContext;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+
+                  @Override
+                  public Object[][] scenarios(ITestContext context) {
+                      return new Object[0][];
+                  }
+              }
+              """
+          )
+        );
+    }
+
+    @Test
+    void leaveUnrelatedScenariosMethodAlone() {
+        rewriteRun(
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              public class Scenarios {
+
+                  public Object[][] scenarios() {
+                      return new Object[0][];
+                  }
+              }
+              """
+          )
+        );
+    }
+
+    @Test
+    void leaveRunnerWithoutOverrideAlone() {
+        rewriteRun(
+          // language=java
+          java(
+            """
+              package com.example.app;
+
+              import io.cucumber.testng.AbstractTestNGCucumberTests;
+
+              public class RunCucumberTest extends AbstractTestNGCucumberTests {
+              }
+              """
+          )
+        );
+    }
+}
