+package org.openrewrite.cucumber.jvm;
+
+import lombok.Getter;
+import org.openrewrite.ExecutionContext;
+import org.openrewrite.Preconditions;
+import org.openrewrite.Recipe;
+import org.openrewrite.TreeVisitor;
+import org.openrewrite.java.JavaIsoVisitor;
+import org.openrewrite.java.JavaParser;
+import org.openrewrite.java.JavaTemplate;
+import org.openrewrite.java.MethodMatcher;
+import org.openrewrite.java.search.DeclaresMethod;
+import org.openrewrite.java.search.UsesMethod;
+import org.openrewrite.java.tree.J;
+import org.openrewrite.java.tree.JavaType;
+import org.openrewrite.java.tree.Space;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static java.util.Collections.singletonList;
+
+public class AddTestContextToScenarios extends Recipe {
+
+    private static final String ORG_TESTNG_ITEST_CONTEXT = "org.testng.ITestContext";
+    private static final MethodMatcher SCENARIOS = new MethodMatcher("io.cucumber.testng.AbstractTestNGCucumberTests scenarios()", true);
+
+    @Getter
+    final String displayName = "Pass `ITestContext` to `AbstractTestNGCucumberTests.scenarios()` overrides";
+
+    @Getter
+    final String description = "Cucumber-JVM 8.0.0 changed the `@DataProvider` of `AbstractTestNGCucumberTests` from `scenarios()` " +
+            "to `scenarios(ITestContext)`. Runners that override `scenarios()`, typically to run scenarios in parallel, " +
+            "no longer override anything, so add the `ITestContext` parameter and pass it on to `super.scenarios()`.";
+
+    @Override
+    public TreeVisitor<?, ExecutionContext> getVisitor() {
+        return Preconditions.check(Preconditions.or(new DeclaresMethod<>(SCENARIOS), new UsesMethod<>(SCENARIOS)), new JavaIsoVisitor<ExecutionContext>() {
+            @Override
+            public J.MethodDeclaration visitMethodDeclaration(J.MethodDeclaration method, ExecutionContext ctx) {
+                J.MethodDeclaration m = super.visitMethodDeclaration(method, ctx);
+                if (!SCENARIOS.matches(m.getMethodType()) || !(m.getParameters().get(0) instanceof J.Empty)) {
+                    return m;
+                }
+
+                String name = declaresVariable(m, "context") ? "testContext" : "context";
+                m = JavaTemplate.builder("ITestContext " + name)
+                        .imports(ORG_TESTNG_ITEST_CONTEXT)
+                        .javaParser(JavaParser.fromJavaVersion()
+                                .dependsOn("package org.testng; public interface ITestContext {}"))
+                        .build()
+                        .apply(updateCursor(m), m.getCoordinates().replaceParameters());
+                maybeAddImport(ORG_TESTNG_ITEST_CONTEXT);
+
+                J.Identifier context = ((J.VariableDeclarations) m.getParameters().get(0)).getVariables().get(0).getName();
+                return (J.MethodDeclaration) new JavaIsoVisitor<Integer>() {
+                    @Override
+                    public J.MethodInvocation visitMethodInvocation(J.MethodInvocation method, Integer p) {
+                        J.MethodInvocation mi = super.visitMethodInvocation(method, p);
+                        if (!SCENARIOS.matches(mi) ||
+                                !(mi.getSelect() instanceof J.Identifier) ||
+                                !"super".equals(((J.Identifier) mi.getSelect()).getSimpleName())) {
+                            return mi;
+                        }
+                        JavaType.Method methodType = mi.getMethodType() == null ? null : mi.getMethodType()
+                                .withParameterNames(singletonList(context.getSimpleName()))
+                                .withParameterTypes(singletonList(context.getType()));
+                        return mi.withArguments(singletonList(context.withPrefix(Space.EMPTY)))
+                                .withMethodType(methodType)
+                                .withName(mi.getName().withType(methodType));
+                    }
+                }.visitNonNull(m, 0, getCursor().getParentOrThrow());
+            }
+        });
+    }
+
+    private static boolean declaresVariable(J.MethodDeclaration method, String name) {
+        AtomicBoolean declared = new AtomicBoolean(false);
+        new JavaIsoVisitor<AtomicBoolean>() {
+            @Override
+            public J.VariableDeclarations.NamedVariable visitVariable(J.VariableDeclarations.NamedVariable variable, AtomicBoolean found) {
+                if (name.equals(variable.getSimpleName())) {
+                    found.set(true);
+                }
+                return super.visitVariable(variable, found);
+            }
+        }.visit(method.getBody(), declared);
+        return declared.get();
+    }
+}
