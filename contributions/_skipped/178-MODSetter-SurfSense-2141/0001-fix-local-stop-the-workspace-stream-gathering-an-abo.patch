From 1f6e133740f0fadffe5f3ddfa42c34cc6eccab3a Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 23:11:04 +0000
Subject: [PATCH] fix(local): stop the workspace stream gathering an abort
 listener per retry

wait() in workspace-changes.ts added an abort listener to the workspace's
signal on every retry and kept it when its timer fired first, so a stream
that keeps dropping, as it does while the API is down, held one more
listener per attempt until the last list left. It also waited out its
timer on an already-aborted signal, which fires no further abort event,
so a stream torn down between attempts took up to 10 seconds to stop.

The timer now removes the listener, as wait() in use-studio.ts does, and
an aborted signal resolves at once. The known-gaps entry goes with it.

Fixes #2141
---
 docs/architecture/overview.md                 |  1 -
 .../workspaces/workspace-changes.test.ts      | 60 +++++++++++++++++++
 .../features/workspaces/workspace-changes.ts  | 21 ++++---
 3 files changed, 72 insertions(+), 10 deletions(-)

diff --git a/docs/architecture/overview.md b/docs/architecture/overview.md
index b4f30e7..cce0ab3 100644
--- a/docs/architecture/overview.md
+++ b/docs/architecture/overview.md
@@ -125,4 +125,3 @@ The rules that keep the processes out of each other's way:
 ## Known gaps
 
 - The sources and Studio lists reload themselves on a workspace event rather than through TanStack Query: they are component state, so nothing else that shows a document or an artifact is invalidated by the same event.
-- The retry `wait()` in [`workspace-changes.ts`](../../surfsense_local/frontend/src/features/workspaces/workspace-changes.ts) never removes its `abort` listener when its timer fires, so a stream that keeps dropping, as it does while the API is down, adds one listener to the workspace's signal per attempt, about 360 an hour, until the last list leaves. It also waits out its timer when the signal is already aborted, so a stream torn down between attempts takes up to 10 seconds to stop.
diff --git a/surfsense_local/frontend/src/features/workspaces/workspace-changes.test.ts b/surfsense_local/frontend/src/features/workspaces/workspace-changes.test.ts
index 3da1cd9..ee54ba1 100644
--- a/surfsense_local/frontend/src/features/workspaces/workspace-changes.test.ts
+++ b/surfsense_local/frontend/src/features/workspaces/workspace-changes.test.ts
@@ -35,6 +35,33 @@ function apiStreaming(streams: Response[]) {
   return fetchMock
 }
 
+/** The API down: every attempt fails until the stream is closed. */
+function apiDown() {
+  const fetchMock = vi.fn<
+    (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>
+  >(async () => {
+    throw new TypeError("Failed to fetch")
+  })
+  vi.stubGlobal("fetch", fetchMock)
+  return fetchMock
+}
+
+/** A request that hangs until it is aborted, as fetch does. */
+function apiHanging() {
+  const fetchMock = vi.fn<
+    (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>
+  >(
+    (_input, init) =>
+      new Promise<Response>((_resolve, reject) => {
+        init?.signal?.addEventListener("abort", () =>
+          reject(new DOMException("Aborted", "AbortError"))
+        )
+      })
+  )
+  vi.stubGlobal("fetch", fetchMock)
+  return fetchMock
+}
+
 const unsubscribes: (() => void)[] = []
 
 function listen(workspaceId: number, kind: "documents" | "artifacts") {
@@ -46,6 +73,7 @@ function listen(workspaceId: number, kind: "documents" | "artifacts") {
 afterEach(() => {
   for (const unsubscribe of unsubscribes.splice(0)) unsubscribe()
   vi.unstubAllGlobals()
+  vi.useRealTimers()
 })
 
 describe("workspace changes", () => {
@@ -98,4 +126,36 @@ describe("workspace changes", () => {
       { timeout: 4000 }
     )
   })
+
+  it("removes each retry's abort listener once its wait is over", async () => {
+    vi.useFakeTimers()
+    const fetchMock = apiDown()
+
+    listen(1, "documents")
+    expect(fetchMock).toHaveBeenCalledOnce()
+    const signal = fetchMock.mock.calls[0][1]!.signal!
+    const added = vi.spyOn(signal, "addEventListener")
+    const removed = vi.spyOn(signal, "removeEventListener")
+    await vi.advanceTimersByTimeAsync(60_000)
+
+    expect(fetchMock.mock.calls.length).toBeGreaterThan(5)
+    // Only the wait still running holds a listener.
+    expect(removed).toHaveBeenCalledTimes(added.mock.calls.length - 1)
+  })
+
+  it("stops at once when the stream is closed between attempts", async () => {
+    vi.useFakeTimers()
+    const fetchMock = apiHanging()
+
+    listen(1, "documents")
+    expect(fetchMock).toHaveBeenCalledOnce()
+    const signal = fetchMock.mock.calls[0][1]!.signal!
+    const added = vi.spyOn(signal, "addEventListener")
+    unsubscribes.shift()?.()
+    await vi.advanceTimersByTimeAsync(0)
+
+    expect(signal.aborted).toBe(true)
+    expect(added).not.toHaveBeenCalled()
+    expect(vi.getTimerCount()).toBe(0)
+  })
 })
diff --git a/surfsense_local/frontend/src/features/workspaces/workspace-changes.ts b/surfsense_local/frontend/src/features/workspaces/workspace-changes.ts
index a6d63e9..742cf1a 100644
--- a/surfsense_local/frontend/src/features/workspaces/workspace-changes.ts
+++ b/surfsense_local/frontend/src/features/workspaces/workspace-changes.ts
@@ -15,17 +15,20 @@ const LAST_RETRY_MS = 10_000
 // One stream per workspace, however many lists listen to it.
 const subscriptions = new Map<number, Subscription>()
 
+// Drops its listener when the timer fires: the signal outlives every retry.
 function wait(milliseconds: number, signal: AbortSignal) {
   return new Promise<void>((resolve) => {
-    const timeout = window.setTimeout(resolve, milliseconds)
-    signal.addEventListener(
-      "abort",
-      () => {
-        window.clearTimeout(timeout)
-        resolve()
-      },
-      { once: true }
-    )
+    // An aborted signal fires no more `abort`; a listener would wait out the timer.
+    if (signal.aborted) return resolve()
+    const onAbort = () => {
+      window.clearTimeout(timeout)
+      resolve()
+    }
+    const timeout = window.setTimeout(() => {
+      signal.removeEventListener("abort", onAbort)
+      resolve()
+    }, milliseconds)
+    signal.addEventListener("abort", onAbort, { once: true })
   })
 }
 
