 }
+
+func TestCheckFiles(t *testing.T) {
+	sc := NewSafeConfig(prometheus.NewRegistry())
+	if err := sc.ReloadConfig("testdata/check-files-good.yml", nil); err != nil {
+		t.Fatalf("Error loading config: %v", err)
+	}
+	if err := sc.C.CheckFiles(); err != nil {
+		t.Errorf("Expected no error for existing files, got: %v", err)
+	}
+
+	sc = NewSafeConfig(prometheus.NewRegistry())
+	if err := sc.ReloadConfig("testdata/check-files-missing.yml", nil); err != nil {
+		t.Fatalf("Error loading config: %v", err)
+	}
+	err := sc.C.CheckFiles()
+	if err == nil {
+		t.Fatal("Expected error for missing files, got none")
+	}
+	for _, want := range []string{
+		`module "http_post_body_file": http.body_file: open testdata/files/missing-body.txt: no such file or directory`,
+		`module "http_post_body_file": http.authorization.credentials_file: open testdata/files/missing-token: no such file or directory`,
+		`module "http_post_body_file": http.http_headers.X-Custom.files: open testdata/files/missing-header: no such file or directory`,
+		`module "tcp_tls": tcp.tls_config.cert_file: open testdata/files/missing.crt: no such file or directory`,
+		`module "tcp_tls": tcp.tls_config.key_file: open testdata/files/missing.key: no such file or directory`,
+		`module "websocket_auth": websocket.http_config.authorization.credentials_file: testdata/files is a directory`,
+	} {
+		if !strings.Contains(err.Error(), want) {
+			t.Errorf("Expected error to contain %q, got:\n%v", want, err)
+		}
+	}
+}
