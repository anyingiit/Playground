diff --git a/config/config.go b/config/config.go
index 3524edd..c540f0c 100644
--- a/config/config.go
+++ b/config/config.go
@@ -180,6 +180,96 @@ func (sc *SafeConfig) ReloadConfig(confFile string, logger *slog.Logger) (err er
 	return nil
 }
 
+// CheckFiles verifies that every local file referenced by the configuration
+// (for example body_file, TLS CA/certificate/key files and credential files)
+// exists and is readable. It does not perform any network operations.
+func (s *Config) CheckFiles() error {
+	names := make([]string, 0, len(s.Modules))
+	for name := range s.Modules {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+
+	var errs []error
+	for _, name := range names {
+		module := s.Modules[name]
+		check := func(field, path string) {
+			if path == "" {
+				return
+			}
+			if err := checkFileReadable(path); err != nil {
+				errs = append(errs, fmt.Errorf("module %q: %s: %w", name, field, err))
+			}
+		}
+
+		check("http.body_file", module.HTTP.BodyFile)
+		checkHTTPClientConfigFiles(check, "http.", &module.HTTP.HTTPClientConfig)
+		checkTLSConfigFiles(check, "tcp.tls_config.", &module.TCP.TLSConfig)
+		checkTLSConfigFiles(check, "unix.tls_config.", &module.Unix.TLSConfig)
+		checkTLSConfigFiles(check, "dns.tls_config.", &module.DNS.TLSConfig)
+		checkTLSConfigFiles(check, "grpc.tls_config.", &module.GRPC.TLSConfig)
+		checkHTTPClientConfigFiles(check, "websocket.http_config.", &module.Websocket.HTTPClientConfig)
+		checkHeadersFiles(check, "websocket.headers.", &module.Websocket.Headers)
+	}
+	return errors.Join(errs...)
+}
+
+func checkHTTPClientConfigFiles(check func(field, path string), prefix string, c *config.HTTPClientConfig) {
+	if c.BasicAuth != nil {
+		check(prefix+"basic_auth.username_file", c.BasicAuth.UsernameFile)
+		check(prefix+"basic_auth.password_file", c.BasicAuth.PasswordFile)
+	}
+	if c.Authorization != nil {
+		check(prefix+"authorization.credentials_file", c.Authorization.CredentialsFile)
+	}
+	if c.OAuth2 != nil {
+		check(prefix+"oauth2.client_secret_file", c.OAuth2.ClientSecretFile)
+		check(prefix+"oauth2.client_certificate_key_file", c.OAuth2.ClientCertificateKeyFile)
+		checkTLSConfigFiles(check, prefix+"oauth2.tls_config.", &c.OAuth2.TLSConfig)
+	}
+	checkTLSConfigFiles(check, prefix+"tls_config.", &c.TLSConfig)
+	if c.HTTPHeaders != nil {
+		checkHeadersFiles(check, prefix+"http_headers.", c.HTTPHeaders)
+	}
+}
+
+func checkTLSConfigFiles(check func(field, path string), prefix string, c *config.TLSConfig) {
+	check(prefix+"ca_file", c.CAFile)
+	check(prefix+"cert_file", c.CertFile)
+	check(prefix+"key_file", c.KeyFile)
+}
+
+func checkHeadersFiles(check func(field, path string), prefix string, h *config.Headers) {
+	names := make([]string, 0, len(h.Headers))
+	for name := range h.Headers {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		for _, path := range h.Headers[name].Files {
+			check(prefix+name+".files", path)
+		}
+	}
+}
+
+// checkFileReadable returns an error if path does not exist, is a directory
+// or cannot be opened for reading.
+func checkFileReadable(path string) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	if info.IsDir() {
+		return fmt.Errorf("%s is a directory", path)
+	}
+	return nil
+}
+
 // CELProgram encapsulates a cel.Program and makes it YAML marshalable.
 type CELProgram struct {
 	cel.Program
