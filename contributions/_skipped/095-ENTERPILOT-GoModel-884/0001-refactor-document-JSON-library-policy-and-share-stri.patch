diff --git a/internal/storage/sqlutil/sqlutil.go b/internal/storage/sqlutil/sqlutil.go
index 7de6258..01ac690 100644
--- a/internal/storage/sqlutil/sqlutil.go
+++ b/internal/storage/sqlutil/sqlutil.go
@@ -98,6 +98,37 @@ func NullableString(value string) any {
 	return value
 }
 
+// EncodeJSONStrings marshals values to a JSON array for a NOT NULL JSON
+// column; nil and empty both encode as "[]". Unlike NullableJSONStrings it
+// returns the error so the write fails instead of storing NULL.
+func EncodeJSONStrings(values []string) (string, error) {
+	if values == nil {
+		values = []string{}
+	}
+	data, err := json.Marshal(values)
+	if err != nil {
+		return "", err
+	}
+	return string(data), nil
+}
+
+// DecodeJSONStrings parses a JSON array column written by EncodeJSONStrings.
+// Empty input and an empty array both decode as nil. Unlike StringsFromJSON
+// it returns malformed values as an error instead of logging and dropping them.
+func DecodeJSONStrings(raw []byte) ([]string, error) {
+	if len(raw) == 0 {
+		return nil, nil
+	}
+	var values []string
+	if err := json.Unmarshal(raw, &values); err != nil {
+		return nil, err
+	}
+	if len(values) == 0 {
+		return nil, nil
+	}
+	return values, nil
+}
+
 // NullableJSONStrings marshals values to a JSON array for binding to a JSON
 // column. Returns nil (SQL NULL) when values is empty or marshaling fails;
 // failures are logged with ref identifying the row.
diff --git a/internal/storage/sqlutil/sqlutil_test.go b/internal/storage/sqlutil/sqlutil_test.go
index d3c4895..2ffcc46 100644
--- a/internal/storage/sqlutil/sqlutil_test.go
+++ b/internal/storage/sqlutil/sqlutil_test.go
@@ -47,6 +47,62 @@ func TestStringsFromJSON(t *testing.T) {
 	}
 }
 
+func TestEncodeJSONStrings(t *testing.T) {
+	tests := []struct {
+		name   string
+		values []string
+		want   string
+	}{
+		{name: "nil encodes as empty array", values: nil, want: "[]"},
+		{name: "empty encodes as empty array", values: []string{}, want: "[]"},
+		{name: "values marshal to a JSON array", values: []string{"openai/*", "/team"}, want: `["openai/*","/team"]`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := EncodeJSONStrings(tt.values)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestDecodeJSONStrings(t *testing.T) {
+	tests := []struct {
+		name    string
+		raw     string
+		want    []string
+		wantErr bool
+	}{
+		{name: "empty column yields nil", raw: "", want: nil},
+		{name: "empty array yields nil", raw: "[]", want: nil},
+		{name: "array parses", raw: `["openai/*","/team"]`, want: []string{"openai/*", "/team"}},
+		{name: "malformed value is an error", raw: "{not-json", wantErr: true},
+		{name: "wrong JSON type is an error", raw: `{"a":1}`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := DecodeJSONStrings([]byte(tt.raw))
+			if tt.wantErr {
+				require.Error(t, err)
+				assert.Nil(t, got)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestJSONStringsRoundTrip(t *testing.T) {
+	for _, values := range [][]string{nil, {"a"}, {"openai/gpt-4o", "anthropic/*"}} {
+		encoded, err := EncodeJSONStrings(values)
+		require.NoError(t, err)
+		decoded, err := DecodeJSONStrings([]byte(encoded))
+		require.NoError(t, err)
+		assert.Equal(t, values, decoded)
+	}
+}
+
