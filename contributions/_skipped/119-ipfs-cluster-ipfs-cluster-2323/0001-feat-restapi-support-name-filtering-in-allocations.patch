 	}
 
+	opts.Name = "aaa"
 	out <- api.PinWithOpts(Cid1, opts)
-	out <- api.PinCid(Cid2)
+	pin2 := api.PinCid(Cid2)
+	pin2.Name = "bbb"
+	out <- pin2
+	opts.Name = "ccc"
 	out <- api.PinWithOpts(Cid3, opts)
 	close(out)
 	return nil
