From d3053c761c497a4fc06da8ef4c334530ed7820a1 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:29:27 +0000
Subject: [PATCH] Sample SPOP and SRANDMEMBER members without copying the whole
 set

SPOP and SRANDMEMBER copied every member into a slice to return one, so a
plain call was O(n) and SPOP held the shard's write lock for the whole copy;
draining a large set with SPOP was O(n^2).

A count of 1 now takes the first key of a map range (O(1), like RANDOMKEY,
relying on Go's randomised map iteration, so random but not perfectly uniform).
A count between 1 and the set size uses reservoir sampling, which is uniform
and allocates only count slots. A count that covers the whole set, or a
negative count, still copies the members.

Adds an allocation regression test and benchmarks on a large set.

Fixes #63
---
 docs/commands.md             |  4 +-
 internal/store/set.go        | 61 +++++++++++++++--------
 internal/store/store_test.go | 96 ++++++++++++++++++++++++++++++++++++
 3 files changed, 139 insertions(+), 22 deletions(-)

diff --git a/docs/commands.md b/docs/commands.md
index f4353ce..9b91680 100644
--- a/docs/commands.md
+++ b/docs/commands.md
@@ -101,8 +101,8 @@ LINSERT q BEFORE b Z   # insert Z before the first "b"; returns new length, or -
 | `SINTER <key> [key ...]` | Members present in every set; a missing key is an empty set. |
 | `SUNION <key> [key ...]` | Distinct members across all the sets. |
 | `SDIFF <key> [key ...]` | Members of the first set that are in none of the rest. |
-| `SPOP <key> [count]` | Remove and return one random member, or an array of up to `count`. |
-| `SRANDMEMBER <key> [count]` | Return random member(s) without removing; a negative `count` allows repeats, capped at 2^20 per call. |
+| `SPOP <key> [count]` | Remove and return one random member, or an array of up to `count`. A single member is picked in O(1) from Go's randomised map order, so it is random but not perfectly uniform; with a `count` the pick is uniform. |
+| `SRANDMEMBER <key> [count]` | Return random member(s) without removing; a negative `count` allows repeats, capped at 2^20 per call. Like `SPOP`, a single member is picked in O(1) and is not perfectly uniform. |
 
 ## Sorted sets
 
diff --git a/internal/store/set.go b/internal/store/set.go
index 64ec38f..9b34ea2 100644
--- a/internal/store/set.go
+++ b/internal/store/set.go
@@ -238,20 +238,49 @@ func (s *Store) SDiff(keys []string) ([]string, error) {
 	return out, nil
 }
 
-// sampleMembers picks members per Redis SPOP/SRANDMEMBER count rules: count >= 0
-// yields that many DISTINCT members (at most all of them); count < 0 yields
-// exactly -count members WITH repetition. members may be reordered in place.
-func sampleMembers(members []string, count int64) []string {
-	n := len(members)
+// sampleSet picks members of set per Redis SPOP/SRANDMEMBER count rules:
+// count >= 0 yields that many DISTINCT members (at most all of them); count < 0
+// yields exactly -count members WITH repetition.
+//
+// The common single-member case takes the first key of a map range, which is
+// O(1) and allocates only the result. Like RandomKey, it relies on Go's
+// randomised map iteration, so the pick is random but not perfectly uniform
+// across members. A count above one but below the set size uses reservoir
+// sampling, which is uniform and allocates only count slots. Only a count that
+// covers the whole set, or a negative count (which needs random access for
+// repeats), copies the members.
+func sampleSet(set map[string]struct{}, count int64) []string {
+	n := len(set)
 	if n == 0 || count == 0 {
 		return []string{}
 	}
-	if count > 0 {
-		if count >= int64(n) {
-			return append([]string(nil), members...)
+	if count == 1 {
+		for m := range set {
+			return []string{m}
 		}
-		rand.Shuffle(n, func(i, j int) { members[i], members[j] = members[j], members[i] })
-		return append([]string(nil), members[:count]...)
+	}
+	if count > 1 && count < int64(n) {
+		k := int(count)
+		out := make([]string, 0, k)
+		seen := 0
+		for m := range set {
+			if seen < k {
+				out = append(out, m)
+			} else if j := rand.Intn(seen + 1); j < k {
+				out[j] = m
+			}
+			seen++
+		}
+		// The reservoir fills in iteration order; shuffle so the order is random too.
+		rand.Shuffle(k, func(i, j int) { out[i], out[j] = out[j], out[i] })
+		return out
+	}
+	members := make([]string, 0, n)
+	for m := range set {
+		members = append(members, m)
+	}
+	if count > 0 {
+		return members
 	}
 	// count < 0: with repetition. The caller bounds the magnitude, so -count is
 	// safe to convert and cannot overflow.
@@ -277,11 +306,7 @@ func (s *Store) SPop(key string, count int64) ([]string, error) {
 	if err != nil {
 		return nil, err
 	}
-	members := make([]string, 0, len(set))
-	for m := range set {
-		members = append(members, m)
-	}
-	picked := sampleMembers(members, count)
+	picked := sampleSet(set, count)
 	for _, m := range picked {
 		delete(set, m)
 	}
@@ -312,9 +337,5 @@ func (s *Store) SRandMember(key string, count int64) ([]string, error) {
 	if count < -maxSampleReps {
 		return nil, ErrSampleCount
 	}
-	members := make([]string, 0, len(set))
-	for m := range set {
-		members = append(members, m)
-	}
-	return sampleMembers(members, count), nil
+	return sampleSet(set, count), nil
 }
diff --git a/internal/store/store_test.go b/internal/store/store_test.go
