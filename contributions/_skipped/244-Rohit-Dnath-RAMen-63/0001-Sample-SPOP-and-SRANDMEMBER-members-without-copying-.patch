 	"strconv"
 	"strings"
 	"sync"
@@ -1056,6 +1057,101 @@ func TestSetPopRandom(t *testing.T) {
 	}
 }
 
+// bigSet fills key with n members m0..m(n-1).
+func bigSet(s *Store, key string, n int) {
+	members := make([]string, n)
+	for i := range members {
+		members[i] = "m" + strconv.Itoa(i)
+	}
+	s.SAdd(key, members...)
+}
+
+// bytesPerCall reports the average heap bytes f allocates per call.
+func bytesPerCall(calls int, f func()) uint64 {
+	var before, after runtime.MemStats
+	runtime.GC()
+	runtime.ReadMemStats(&before)
+	for i := 0; i < calls; i++ {
+		f()
+	}
+	runtime.ReadMemStats(&after)
+	return (after.TotalAlloc - before.TotalAlloc) / uint64(calls)
+}
+
+// A plain SPOP / SRANDMEMBER (count 1) or a small count must not copy the
+// whole set: on 100k members a copy is ~1.6 MB per call.
+func TestSetSampleDoesNotCopyWholeSet(t *testing.T) {
+	s := New()
+	bigSet(s, "big", 100_000)
+	const limit = 4 << 10
+
+	if b := bytesPerCall(100, func() { s.SRandMember("big", 1) }); b > limit {
+		t.Fatalf("SRANDMEMBER count 1 allocates %d bytes per call, want <= %d", b, limit)
+	}
+	if b := bytesPerCall(100, func() { s.SRandMember("big", 5) }); b > limit {
+		t.Fatalf("SRANDMEMBER count 5 allocates %d bytes per call, want <= %d", b, limit)
+	}
+	if b := bytesPerCall(100, func() { s.SPop("big", 1) }); b > limit {
+		t.Fatalf("SPOP count 1 allocates %d bytes per call, want <= %d", b, limit)
+	}
+	if b := bytesPerCall(100, func() { s.SPop("big", 5) }); b > limit {
+		t.Fatalf("SPOP count 5 allocates %d bytes per call, want <= %d", b, limit)
+	}
+	if n, _ := s.SCard("big"); n != 100_000-100-500 {
+		t.Fatalf("SCARD after pops = %d, want %d", n, 100_000-100-500)
+	}
+}
+
+// Reservoir sampling for 1 < count < size must still reach every member and
+// return distinct members of the set.
+func TestSRandMemberCountReachesEveryMember(t *testing.T) {
+	s := New()
+	bigSet(s, "s", 10)
+	hits := make(map[string]int)
+	for i := 0; i < 2000; i++ {
+		r, err := s.SRandMember("s", 3)
+		if err != nil || len(r) != 3 || hasDup(r) {
+			t.Fatalf("SRandMember 3 = %v %v", r, err)
+		}
+		for _, m := range r {
+			hits[m]++
+		}
+	}
+	if len(hits) != 10 {
+		t.Fatalf("SRandMember 3 reached %d of 10 members: %v", len(hits), hits)
+	}
+	// Each member is expected 600 times; a fair sampler stays far from 0 or 2000.
+	for m, c := range hits {
+		if c < 300 || c > 900 {
+			t.Fatalf("member %s picked %d times in 2000 draws of 3, want about 600", m, c)
+		}
+	}
+}
+
+func BenchmarkSRandMember(b *testing.B) {
+	s := New()
+	bigSet(s, "big", 1_000_000)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		s.SRandMember("big", 1)
+	}
+}
+
+func BenchmarkSPop(b *testing.B) {
+	s := New()
+	bigSet(s, "big", 1_000_000)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if r, _ := s.SPop("big", 1); len(r) == 0 {
+			b.StopTimer()
+			bigSet(s, "big", 1_000_000)
+			b.StartTimer()
+		}
+	}
+}
