+// Escape a value for a GitHub-flavored Markdown table cell: pipes would split
+// the cell and newlines would end the row, so escape the former and flatten
+// the latter to spaces.
+export function escapeMarkdownCell(value: unknown): string {
+  if (value === null || value === undefined) {
+    return ''
+  }
+
+  const stringValue = typeof value === 'object' ? JSON.stringify(value) : String(value)
+
+  return stringValue.replace(/\|/g, '\\|').replace(/\r\n|\r|\n/g, ' ')
+}
+
+export function exportToMarkdown(data: ExportData): string {
+  const toRow = (cells: string[]): string => `| ${cells.join(' | ')} |`
+  const header = toRow(data.columns.map((col) => escapeMarkdownCell(col.name)))
+  const separator = toRow(data.columns.map(() => '---'))
+  const rows = data.rows.map((row) =>
+    toRow(data.columns.map((col) => escapeMarkdownCell(row[col.name])))
+  )
+  return [header, separator, ...rows].join('\n')
+}
+
