diff --git a/internal/storage/v2/elasticsearch/tracestore/core/dbmodel/model.go b/internal/storage/v2/elasticsearch/tracestore/core/dbmodel/model.go
index 88bde1d..ac1f796 100644
--- a/internal/storage/v2/elasticsearch/tracestore/core/dbmodel/model.go
+++ b/internal/storage/v2/elasticsearch/tracestore/core/dbmodel/model.go
@@ -7,7 +7,6 @@ package dbmodel
 import (
 	"encoding/hex"
 	"fmt"
-	"strings"
 	"time"
 
 	"go.opentelemetry.io/collector/pdata/pcommon"
@@ -25,41 +24,27 @@ type TraceID string
 // SpanID is the id of a span
 type SpanID string
 
-// ToOTEL decodes the hex trace ID into its pdata form, left-padding a shorter
-// (e.g. 64-bit) id with zeros.
+// ToOTEL decodes the 32-character hex trace ID into its pdata form.
 func (t TraceID) ToOTEL() (pcommon.TraceID, error) {
-	var traceID [16]byte
-	traceIDHex := string(t)
-	if len(traceIDHex) > 32 {
-		return pcommon.TraceID{}, fmt.Errorf("trace ID from DB is too long: %d chars", len(traceIDHex))
+	var traceID pcommon.TraceID
+	if len(t) != 2*len(traceID) {
+		return pcommon.TraceID{}, fmt.Errorf("trace ID from DB must be %d hex chars, got %d", 2*len(traceID), len(t))
 	}
-	if len(traceIDHex) < 32 {
-		traceIDHex = strings.Repeat("0", 32-len(traceIDHex)) + traceIDHex
-	}
-	traceBytes, err := hex.DecodeString(traceIDHex)
-	if err != nil {
+	if _, err := hex.Decode(traceID[:], []byte(t)); err != nil {
 		return pcommon.TraceID{}, err
 	}
-	copy(traceID[:], traceBytes)
 	return traceID, nil
 }
 
-// ToOTEL decodes the hex span ID into its pdata form, left-padding a shorter id
-// with zeros.
+// ToOTEL decodes the 16-character hex span ID into its pdata form.
 func (s SpanID) ToOTEL() (pcommon.SpanID, error) {
-	var spanID [8]byte
-	spanIDHex := string(s)
-	if len(spanIDHex) > 16 {
-		return pcommon.SpanID{}, fmt.Errorf("span ID from DB is too long: %d chars", len(spanIDHex))
-	}
-	if len(spanIDHex) < 16 {
-		spanIDHex = strings.Repeat("0", 16-len(spanIDHex)) + spanIDHex
+	var spanID pcommon.SpanID
+	if len(s) != 2*len(spanID) {
+		return pcommon.SpanID{}, fmt.Errorf("span ID from DB must be %d hex chars, got %d", 2*len(spanID), len(s))
 	}
-	spanIDBytes, err := hex.DecodeString(spanIDHex)
-	if err != nil {
+	if _, err := hex.Decode(spanID[:], []byte(s)); err != nil {
 		return pcommon.SpanID{}, err
 	}
-	copy(spanID[:], spanIDBytes)
 	return spanID, nil
 }
 
