+// preloadAlias returns the join alias for the side-th side of a preloaded
+// relationship joined from the parent alias.
+//
+// The alias is derived only from the position of the join in the preload tree
+// (parent alias, relationship name and side index), so building the same query
+// twice produces the same SQL. This keeps the query text stable across
+// executions, which drivers with statement caching (e.g. pgx) rely on.
+// Distinct relationships, or the same relationship reached through different
+// parents, get distinct aliases.
+func preloadAlias(to, parent, relName string, side int) string {
+	h := fnv.New64a()
+	h.Write([]byte(parent))
+	h.Write([]byte{0})
+	h.Write([]byte(relName))
+	h.Write([]byte{0})
+	h.Write([]byte(strconv.Itoa(side)))
+
+	return to + "_" + strconv.FormatUint(h.Sum64(), 36)
+}
+
