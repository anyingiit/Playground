--- /dev/null
+++ b/orm/load_alias_test.go
@@ -0,0 +1,123 @@
+package orm_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/stephenafamo/bob/dialect/psql"
+	"github.com/stephenafamo/bob/dialect/psql/sm"
+)
+
+type aliasTestTable string
+
+func (t aliasTestTable) NameExpr() psql.Expression {
+	return psql.Quote(string(t))
+}
+
+func (t aliasTestTable) Alias() string {
+	return string(t)
+}
+
+type aliasTestModel struct {
+	ID int64 `db:"id"`
+}
+
+func (*aliasTestModel) Preload(string, any) error { return nil }
+
+type aliasTestModelSlice []*aliasTestModel
+
+func aliasTestPreload(name, from, to, fromCol, toCol string, opts ...psql.PreloadOption) psql.Preloader {
+	return psql.Preload[*aliasTestModel, aliasTestModelSlice](psql.PreloadRel{
+		Name: name,
+		Sides: []psql.PreloadSide{{
+			From:        aliasTestTable(from),
+			To:          aliasTestTable(to),
+			FromColumns: []string{fromCol},
+			ToColumns:   []string{toCol},
+		}},
+	}, []string{"id"}, nil, opts...)
+}
+
+func buildAliasTestQuery(t *testing.T) string {
+	t.Helper()
+
+	q := psql.Select(
+		sm.From("posts"),
+		aliasTestPreload("Author", "posts", "users", "author_id", "id",
+			aliasTestPreload("Pets", "users", "pets", "id", "owner_id"),
+		),
+		aliasTestPreload("Editor", "posts", "users", "editor_id", "id",
+			aliasTestPreload("Pets", "users", "pets", "id", "owner_id"),
+		),
+	)
+
+	query, _, err := q.Build(context.Background())
+	if err != nil {
+		t.Fatalf("build: %v", err)
+	}
+
+	return query
+}
+
+// Preload join aliases must be the same every time a query is built so that
+// drivers caching statements by their SQL text (e.g. pgx) can reuse them.
+// See https://github.com/stephenafamo/bob/issues/741
+func TestPreloadAliasesAreDeterministic(t *testing.T) {
+	first := buildAliasTestQuery(t)
+	for range 3 {
+		if again := buildAliasTestQuery(t); again != first {
+			t.Fatalf("preload SQL differs between builds:\n%s\n%s", first, again)
+		}
+	}
+}
+
+func TestPreloadAliasesAreUniqueWithinQuery(t *testing.T) {
+	query := buildAliasTestQuery(t)
+
+	joins := strings.Split(query, "LEFT JOIN ")[1:]
+	aliases := make([]string, 0, len(joins))
+	for _, part := range joins {
+		// LEFT JOIN "users" AS "users_xxx" ON ...
+		_, rest, ok := strings.Cut(part, ` AS "`)
+		if !ok {
+			t.Fatalf("unexpected join %q", part)
+		}
+		alias, _, _ := strings.Cut(rest, `"`)
+		aliases = append(aliases, alias)
+	}
+
+	if len(aliases) != 4 {
+		t.Fatalf("expected 4 joins, got %d: %s", len(aliases), query)
+	}
+
+	seen := make(map[string]bool, len(aliases))
+	for _, alias := range aliases {
+		if seen[alias] {
+			t.Fatalf("duplicate preload alias %q in %s", alias, query)
+		}
+		seen[alias] = true
+	}
+
+	for i, prefix := range []string{"users_", "pets_", "users_", "pets_"} {
+		if !strings.HasPrefix(aliases[i], prefix) {
+			t.Errorf("alias %d = %q, want prefix %q", i, aliases[i], prefix)
+		}
+	}
+}
+
+func TestPreloadAsKeepsStaticAlias(t *testing.T) {
+	q := psql.Select(
+		sm.From("posts"),
+		aliasTestPreload("Author", "posts", "users", "author_id", "id", psql.PreloadAs("author")),
+	)
+
+	query, _, err := q.Build(context.Background())
+	if err != nil {
+		t.Fatalf("build: %v", err)
+	}
+
+	if !strings.Contains(query, `LEFT JOIN "users" AS "author" ON "posts"."author_id" = "author"."id"`) {
+		t.Fatalf("PreloadAs alias not used: %s", query)
+	}
+}
