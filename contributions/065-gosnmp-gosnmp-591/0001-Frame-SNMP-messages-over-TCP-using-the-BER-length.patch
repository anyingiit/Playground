From 58c2a8a7338c87e43aea652cb2365afa3814d07e Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 19:15:50 +0000
Subject: [PATCH] Frame SNMP messages over TCP using the BER length

TCP is a byte stream, so a single SNMP response may arrive split over
several segments and several responses may arrive in one segment.
receive() treated each Read like a UDP datagram, which made large
responses fail with "error verifying packet sanity: Got 1448
Expected: 2611" (or "invalid packet header" for the following read).

For TCP transports, read the outer SEQUENCE header first and then
exactly the announced number of bytes (RFC 3430), so each call returns
one complete message and never consumes bytes of the next one.

Fixes #591
---
 marshal.go      |  56 +++++++++++++++++++
 marshal_test.go | 142 ++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 198 insertions(+)

diff --git a/marshal.go b/marshal.go
index 30cc652..a9dcc55 100644
--- a/marshal.go
+++ b/marshal.go
@@ -1320,6 +1320,10 @@ func (x *GoSNMP) unmarshalVBL(packet []byte, response *SnmpPacket) error {
 
 // receive response from network and read into a byte array
 func (x *GoSNMP) receive() ([]byte, error) {
+	if _, ok := x.Conn.(net.PacketConn); !ok && strings.HasPrefix(x.Transport, tcp) {
+		return x.receiveStream()
+	}
+
 	var n int
 	var err error
 	// If we are using UDP and unconnected socket, read the packet and
@@ -1345,6 +1349,58 @@ func (x *GoSNMP) receive() ([]byte, error) {
 	return resp, nil
 }
 
+// receiveStream reads exactly one SNMP message from a stream transport (TCP).
+//
+// Unlike UDP, TCP does not preserve message boundaries: a single SNMP message
+// may arrive split over several segments, and several messages may arrive in
+// one segment. As described in RFC 3430, the message framing is therefore
+// taken from the BER length of the outer SEQUENCE: the header is read first,
+// then exactly the announced number of bytes, so no bytes of a following
+// message are consumed.
+func (x *GoSNMP) receiveStream() ([]byte, error) {
+	buf := x.rxBuf[:]
+
+	// Tag and first length octet. A clean EOF here is returned as io.EOF
+	// so that the caller can reconnect.
+	if _, err := io.ReadFull(x.Conn, buf[:2]); err != nil {
+		if err == io.EOF {
+			return nil, err
+		}
+		return nil, fmt.Errorf("error reading from socket: %w", err)
+	}
+	if PDUType(buf[0]) != Sequence {
+		return nil, fmt.Errorf("invalid packet header")
+	}
+
+	headerLen := 2
+	if buf[1] > 0x80 {
+		numOctets := int(buf[1] & 0x7f)
+		if numOctets > 4 {
+			return nil, ErrInvalidPacketLength
+		}
+		headerLen += numOctets
+		if _, err := io.ReadFull(x.Conn, buf[2:headerLen]); err != nil {
+			return nil, fmt.Errorf("error reading from socket: %w", err)
+		}
+	}
+
+	length, _, err := parseLength(buf[:headerLen])
+	if err != nil {
+		return nil, err
+	}
+	if length > rxBufSize {
+		return nil, fmt.Errorf("response buffer too small")
+	}
+
+	if _, err := io.ReadFull(x.Conn, buf[headerLen:length]); err != nil {
+		return nil, fmt.Errorf("error reading from socket: %w", err)
+	}
+
+	resp := make([]byte, length)
+	copy(resp, buf[:length])
+	return resp, nil
+}
