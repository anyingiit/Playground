@@ -795,6 +806,7 @@ class Svg
 			$this->mpdf->gradients[$n]['extend'] = ['true', 'true'];
 			if ($trans) {
 				$this->mpdf->gradients[$n]['trans'] = true;
+				$this->usesTransparency = true;
 				$return .= ' /TGS' . ($n) . ' gs ';
 			}
 			$return .= ' /Sh' . ($n) . ' sh ';
@@ -1026,6 +1038,7 @@ class Svg
 			$this->mpdf->gradients[$n]['extend'] = ['true', 'true'];
 			if (isset($trans) && $trans) {
 				$this->mpdf->gradients[$n]['trans'] = true;
