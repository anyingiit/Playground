 			}
 			$return .= ' /Sh' . ($n) . ' sh ';
@@ -1512,6 +1525,9 @@ class Svg
 			} elseif ($critere_style['fill-opacity'] < 0) {
 				$opacity = 0;
 			}
+			if ($opacity < 1) {
