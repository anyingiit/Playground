From e827fe5e994fc5dbaea925514e1bcacdb85b9e39 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:18:32 +0000
Subject: [PATCH] fix(web): name the response deadline when an invitation
 expires before renewal

An open payer-transfer invitation expires at the earlier of its consent
deadline and its renewal date, but the inbox always explained the expiry as
the renewal boundary passing. When the response deadline comes first the
renewal date has not arrived yet, so the copy was wrong.

Report which deadline closed the invitation and show matching copy. The
expiry calculation, the timer and the removal of the action buttons are
unchanged.

Closes #696

Signed-off-by: anyingiit <49945850+anyingiit@users.noreply.github.com>
---
 web/src/PayerTransferInbox.tsx                | 16 ++++++---
 .../__tests__/PayerTransferJourneys.test.tsx  | 36 ++++++++++++++++++-
 2 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/web/src/PayerTransferInbox.tsx b/web/src/PayerTransferInbox.tsx
index f8f3238..96af045 100644
--- a/web/src/PayerTransferInbox.tsx
+++ b/web/src/PayerTransferInbox.tsx
@@ -32,11 +32,15 @@ function payer(kind: string, organizationId: string | null): string {
   return kind === "personal" ? "personal billing" : `organisation ${organizationId ?? "billing"}`;
 }
 
-function stateCopy(state: string, expiredInvitation = false): string {
+// Which deadline closed an open invitation: the response deadline or the renewal boundary, whichever came first.
+type InvitationExpiry = "response_deadline" | "renewal";
+
+function stateCopy(state: string, invitationExpiry: InvitationExpiry | null = null): string {
   switch (state) {
-    case "awaiting_consent": return expiredInvitation
-      ? "This invitation expired at the renewal boundary. Ask the initiator to start a new request."
-      : "Waiting for the other payer to respond.";
+    case "awaiting_consent":
+      if (invitationExpiry === "renewal") return "This invitation expired at the renewal boundary. Ask the initiator to start a new request.";
+      if (invitationExpiry === "response_deadline") return "This invitation expired because its response deadline passed. Ask the initiator to start a new request.";
+      return "Waiting for the other payer to respond.";
     case "pending": return "Accepted. The billing change is being prepared; it is not complete yet.";
     case "destination_prepared": return "The change is being prepared for the renewal date.";
     case "destination_paid":
@@ -214,6 +218,8 @@ export function PayerTransferInbox() {
         const incoming = transfer.participantRole === "counterparty";
         const invitationExpired = transfer.state === "awaiting_consent"
           && Math.floor(Date.now() / 1000) >= Math.min(transfer.consentExpiresAtEpoch, transfer.effectiveFrom);
+        const invitationExpiry: InvitationExpiry | null = !invitationExpired ? null
+          : transfer.consentExpiresAtEpoch < transfer.effectiveFrom ? "response_deadline" : "renewal";
         const actionable = transfer.state === "awaiting_consent" && !invitationExpired;
         const setupRequired = transfer.state === "pending"
           && transfer.destinationKind === "personal"
@@ -225,7 +231,7 @@ export function PayerTransferInbox() {
           <span className="meta">{payer(transfer.sourceKind, transfer.sourceOrganizationId)} → {payer(transfer.destinationKind, transfer.destinationOrganizationId)}</span>
           <p>{pounds(transfer.amountPence)} per {transfer.interval}; renewal {date(transfer.effectiveFrom)}.</p>
           {actionable && <p className="muted">Respond by {date(Math.min(transfer.consentExpiresAtEpoch, transfer.effectiveFrom))}.</p>}
-          <p className="muted">{stateCopy(transfer.state, invitationExpired)}</p>
+          <p className="muted">{stateCopy(transfer.state, invitationExpiry)}</p>
           {transfer.state === "unknown" && <p className="muted">Contact Sotto support before making another billing change.</p>}
           {actionable && incoming && transfer.destinationKind === "personal" && !setupAvailable
             && <p className="muted">Personal payment setup is not available on this server yet. The request has not been accepted.</p>}
diff --git a/web/src/__tests__/PayerTransferJourneys.test.tsx b/web/src/__tests__/PayerTransferJourneys.test.tsx
index 7dc25e2..ce4a36a 100644
--- a/web/src/__tests__/PayerTransferJourneys.test.tsx
+++ b/web/src/__tests__/PayerTransferJourneys.test.tsx
@@ -183,13 +183,47 @@ describe("payer transfer journeys", () => {
 
       await act(async () => { await vi.advanceTimersByTimeAsync(1_000); });
       expect(screen.getAllByRole("button", { name: "Accept transfer request" })).toHaveLength(1);
-      expect(screen.getByText(/expired at the renewal boundary/i)).toBeInTheDocument();
+      // The response deadline passed 99 seconds before renewal, so the copy must not blame renewal.
+      expect(screen.getByText(/expired because its response deadline passed/i)).toBeInTheDocument();
+      expect(screen.queryByText(/expired at the renewal boundary/i)).not.toBeInTheDocument();
       expect(api.fetchPayerTransfers).toHaveBeenCalledTimes(1);
     } finally {
       vi.useRealTimers();
     }
   });
 
+  it("expires an open invitation at the renewal boundary when renewal comes first", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(2_000_000_000_000);
+    try {
+      vi.mocked(api.fetchPayerTransfers).mockResolvedValue({
+        transfers: [transfer({ consentExpiresAtEpoch: 2_000_000_600, effectiveFrom: 2_000_000_001 })],
+        nextCursor: null,
+      });
+      render(<PayerTransferInbox />);
+      await act(async () => { await vi.advanceTimersByTimeAsync(0); });
+      expect(screen.getByRole("button", { name: "Accept transfer request" })).toBeInTheDocument();
+
+      await act(async () => { await vi.advanceTimersByTimeAsync(1_000); });
+      expect(screen.queryByRole("button", { name: "Accept transfer request" })).not.toBeInTheDocument();
+      expect(screen.getByText(/expired at the renewal boundary/i)).toBeInTheDocument();
+      expect(screen.queryByText(/response deadline passed/i)).not.toBeInTheDocument();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("shows invitations loaded after their response deadline as expired without blaming renewal", async () => {
+    vi.mocked(api.fetchPayerTransfers).mockResolvedValue({
+      transfers: [transfer({ consentExpiresAtEpoch: 1, effectiveFrom: 2 })],
+      nextCursor: null,
+    });
+    render(<PayerTransferInbox />);
+    expect(await screen.findByText(/expired because its response deadline passed/i)).toBeInTheDocument();
+    expect(screen.queryByText(/expired at the renewal boundary/i)).not.toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Accept transfer request" })).not.toBeInTheDocument();
+  });
+
   it("keeps personal payer invitations unaccepted until setup is available", async () => {
     vi.mocked(api.fetchPayerTransferCapabilities).mockResolvedValue({ available: true, setupAvailable: false });
     vi.mocked(api.fetchPayerTransfers).mockResolvedValue({ transfers: [transfer({
