@@ -822,6 +822,24 @@ func TestTraceReader_FindTraceSummaries_Success(t *testing.T) {
 	assert.Equal(t, "frontend", got[0].Services[0].Name)
 }
 
+func TestTraceReader_FindTraceSummaries_ShortTraceID(t *testing.T) {
+	ts := &testServer{summaries: []*storage.TraceSummary{
+		{TraceId: []byte{1, 2, 3, 4, 5, 6, 7, 8}},
+	}}
+	conn := startTestServer(t, ts)
+	reader := NewTraceReader(conn)
+
+	var got []tracestore.TraceSummary
+	for chunk, err := range reader.FindTraceSummaries(context.Background(), tracestore.TraceQueryParams{
+		Attributes: pcommon.NewMap(),
+	}) {
+		require.NoError(t, err)
+		got = append(got, chunk.Results...)
+	}
+	require.Len(t, got, 1)
+	assert.Equal(t, pcommon.TraceID([16]byte{8: 1, 2, 3, 4, 5, 6, 7, 8}), got[0].TraceID)
+}
