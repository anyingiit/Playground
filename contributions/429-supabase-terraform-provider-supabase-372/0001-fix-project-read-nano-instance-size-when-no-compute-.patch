From 01f1efdecf89caaa28a80efdb03ca37e1536d4f2 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:21:12 +0000
Subject: [PATCH] fix(project): read nano instance size when no compute addon
 is selected

Nano is the base compute size rather than an addon, so the billing addons
endpoint returns no compute_instance addon for nano projects. readProject
then set instance_size to null, and creating a project with
instance_size = "nano" failed with "Provider produced inconsistent result
after apply".

Default instance_size to nano when no compute_instance addon is
selected, and add an acceptance test for creating and importing a nano
project.

Fixes #372
---
 internal/provider/project_resource.go      |  4 +-
 internal/provider/project_resource_test.go | 76 ++++++++++++++++++++++
 2 files changed, 79 insertions(+), 1 deletion(-)

diff --git a/internal/provider/project_resource.go b/internal/provider/project_resource.go
index b932b81..f3649f2 100644
--- a/internal/provider/project_resource.go
+++ b/internal/provider/project_resource.go
@@ -335,7 +335,9 @@ func readProject(ctx context.Context, data *ProjectResourceModel, client *api.Cl
 	data.OrganizationId = types.StringValue(project.OrganizationId)
 	data.Name = types.StringValue(project.Name)
 	data.Region = types.StringValue(project.Region)
-	data.InstanceSize = types.StringNull()
+	// Nano is the base compute size rather than an addon, so a project
+	// without a compute_instance addon runs on nano.
+	data.InstanceSize = types.StringValue(string(api.V1CreateProjectBodyDesiredInstanceSizeNano))
 
 	legacyKeysResp, err := client.V1GetProjectLegacyApiKeysWithResponse(ctx, project.Id)
 	if err != nil {
diff --git a/internal/provider/project_resource_test.go b/internal/provider/project_resource_test.go
index 326d969..69f3b2d 100644
--- a/internal/provider/project_resource_test.go
+++ b/internal/provider/project_resource_test.go
@@ -360,6 +360,82 @@ func TestAccProjectResource(t *testing.T) {
 	})
 }
 
+// TestAccProjectResource_NanoInstanceSize covers projects on the nano compute
+// size, which is the base tier rather than an addon: the billing addons
+// endpoint returns no compute_instance addon for them.
+func TestAccProjectResource_NanoInstanceSize(t *testing.T) {
+	defer gock.OffAll()
+	gock.New(defaultApiEndpoint).
+		Post(projectsApiPath).
+		Reply(http.StatusCreated).
+		JSON(api.V1ProjectResponse{
+			Id:   testProjectRef,
+			Name: "foo",
+		})
+	gock.New(defaultApiEndpoint).
+		Put(legacyApiKeysApiPath).
+		MatchParam("enabled", "false").
+		Reply(http.StatusOK)
+	gock.New(defaultApiEndpoint).
+		Get(projectApiPath).
+		Persist().
+		Reply(http.StatusOK).
+		JSON(api.V1ProjectWithDatabaseResponse{
+			Id:             testProjectRef,
+			Name:           "foo",
+			OrganizationId: "continued-brown-smelt",
+			Region:         "us-east-1",
+			Status:         api.V1ProjectWithDatabaseResponseStatusACTIVEHEALTHY,
+		})
+	gock.New(defaultApiEndpoint).
+		Get(legacyApiKeysApiPath).
+		Persist().
+		Reply(http.StatusOK).
+		JSON(map[string]any{"enabled": false})
+	gock.New(defaultApiEndpoint).
+		Get(billingApiPath).
+		Persist().
+		Reply(http.StatusOK).
+		JSON(map[string]any{
+			"selected_addons":  []map[string]any{},
+			"available_addons": []map[string]any{},
+		})
+	gock.New(defaultApiEndpoint).
+		Delete(projectApiPath).
+		Reply(http.StatusOK).
+		JSON(api.V1ProjectRefResponse{
+			Id:   1,
+			Ref:  testProjectRef,
+			Name: "foo",
+		})
+
+	resource.Test(t, resource.TestCase{
+		PreCheck:                 func() { testAccPreCheck(t) },
+		ProtoV6ProviderFactories: testAccProtoV6ProviderFactories,
+		Steps: []resource.TestStep{
+			{
+				Config: projectResourceConfig(ProjectResourceModel{
+					OrganizationId:   types.StringValue("continued-brown-smelt"),
+					Name:             types.StringValue("foo"),
+					DatabasePassword: types.StringValue("barbaz"),
+					Region:           types.StringValue("us-east-1"),
+					InstanceSize:     types.StringValue("nano"),
+				}),
+				Check: resource.ComposeAggregateTestCheckFunc(
+					resource.TestCheckResourceAttr("supabase_project.test", "id", testProjectRef),
+					resource.TestCheckResourceAttr("supabase_project.test", "instance_size", "nano"),
+				),
+			},
+			{
+				ResourceName:            "supabase_project.test",
+				ImportState:             true,
+				ImportStateVerify:       true,
+				ImportStateVerifyIgnore: []string{"database_password"},
+			},
+		},
+	})
+}
+
 func projectResourceConfig(p ProjectResourceModel) string {
 	rv := fmt.Sprintf(`resource "supabase_project" "test" {
   organization_id         = "%s"
-- 
