@@ -1337,6 +1368,7 @@ private function configureOptions(OptionsResolver $resolver): void
             'server_name' => gethostname(),
             'ignore_exceptions' => [],
             'ignore_transactions' => [],
+            'trace_ignore_status_codes' => [],
             'before_send' => static function (Event $event): Event {
                 return $event;
             },
@@ -1536,6 +1568,34 @@ private function validateContextLinesOption(?int $contextLines): bool
         return $contextLines === null || $contextLines >= 0;
     }
 
+    /**
+     * Validates that the value passed to the "trace_ignore_status_codes" option
+     * only contains status codes or inclusive `[min, max]` ranges of status codes.
+     *
+     * @param array<mixed> $statusCodes The value to validate
+     */
+    private function validateTraceIgnoreStatusCodesOption(array $statusCodes): bool
+    {
+        /**
+         * @var mixed $statusCode
+         */
+        foreach ($statusCodes as $statusCode) {
+            if (\is_int($statusCode)) {
+                continue;
+            }
+
+            if (!\is_array($statusCode) || \count($statusCode) !== 2 || !isset($statusCode[0], $statusCode[1])) {
+                return false;
+            }
+
+            if (!\is_int($statusCode[0]) || !\is_int($statusCode[1]) || $statusCode[0] > $statusCode[1]) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
     /**
      * Validates that the value passed to the "log_flush_threshold" option is valid.
      *
diff --git a/src/Tracing/Transaction.php b/src/Tracing/Transaction.php
index 5e4d727..f41249a 100644
--- a/src/Tracing/Transaction.php
+++ b/src/Tracing/Transaction.php
@@ -159,6 +159,10 @@ public function finish(?float $endTimestamp = null): ?EventId
 
         parent::finish($endTimestamp);
 
+        if ($this->sampled === true && $this->shouldIgnoreStatusCode()) {
+            $this->sampled = false;
+        }
+
         if ($this->sampled !== true) {
             return null;
         }
@@ -192,4 +196,50 @@ public function finish(?float $endTimestamp = null): ?EventId
 
         return $this->hub->captureEvent($event);
     }
+
+    /**
+     * Checks whether the `http.response.status_code` of this transaction
+     * matches an entry of the `trace_ignore_status_codes` option.
+     */
+    private function shouldIgnoreStatusCode(): bool
+    {
+        /**
+         * @var int|string|null $statusCode
+         */
+        $statusCode = $this->data['http.response.status_code'] ?? null;
+
+        if (\is_string($statusCode) && ctype_digit($statusCode)) {
+            $statusCode = (int) $statusCode;
+        }
+
+        if (!\is_int($statusCode)) {
+            return false;
+        }
+
+        $client = $this->hub->getClient();
+
+        if ($client === null) {
+            return false;
+        }
+
+        $options = $client->getOptions();
+
+        foreach ($options->getTraceIgnoreStatusCodes() as $ignoredStatusCode) {
+            if (\is_array($ignoredStatusCode)) {
+                $matches = $statusCode >= $ignoredStatusCode[0] && $statusCode <= $ignoredStatusCode[1];
+            } else {
+                $matches = $statusCode === $ignoredStatusCode;
+            }
+
+            if ($matches) {
+                $options->getLoggerOrNullLogger()->info(
+                    \sprintf('Transaction [%s] will be discarded because its HTTP status code %d matches an entry in "trace_ignore_status_codes".', (string) $this->getTraceId(), $statusCode)
+                );
+
+                return true;
+            }
+        }
+
+        return false;
+    }
 }
