diff --git a/tests/Tracing/TransactionTest.php b/tests/Tracing/TransactionTest.php
index 76a2c3a..8efa740 100644
--- a/tests/Tracing/TransactionTest.php
+++ b/tests/Tracing/TransactionTest.php
@@ -182,4 +182,79 @@ public function parentTransactionContextDataProviderDisabled(): \Generator
             false,
         ];
     }
+
+    /**
+     * @dataProvider traceIgnoreStatusCodesDataProvider
+     *
+     * @param array<int|array{int, int}> $traceIgnoreStatusCodes
+     * @param mixed                      $statusCode
+     */
+    public function testFinishRespectsTraceIgnoreStatusCodesOption(array $traceIgnoreStatusCodes, $statusCode, bool $expectedSampled): void
+    {
+        $client = $this->createMock(ClientInterface::class);
+        $client->expects($this->any())
+            ->method('getOptions')
+            ->willReturn(new Options(['trace_ignore_status_codes' => $traceIgnoreStatusCodes]));
+
+        $hub = $this->createMock(HubInterface::class);
+        $hub->expects($this->any())
+            ->method('getClient')
+            ->willReturn($client);
+
+        $hub->expects($expectedSampled ? $this->once() : $this->never())
+            ->method('captureEvent')
+            ->willReturn(EventId::generate());
+
+        $transactionContext = TransactionContext::make()
+            ->setSampled(true);
+
+        $transaction = new Transaction($transactionContext, $hub);
+        $transaction->setData(['http.response.status_code' => $statusCode]);
+        $transaction->finish();
+
+        $this->assertSame($expectedSampled, $transaction->getSampled());
+    }
+
+    public static function traceIgnoreStatusCodesDataProvider(): \Generator
+    {
+        yield 'default does not ignore anything' => [[], 404, true];
+
+        yield 'exact match' => [[404], 404, false];
+
+        yield 'no match' => [[404], 200, true];
+
+        yield 'numeric string status code' => [[404], '404', false];
+
+        yield 'inside range' => [[[301, 303], [305, 399]], 350, false];
+
+        yield 'range lower bound is inclusive' => [[[301, 303]], 301, false];
+
+        yield 'range upper bound is inclusive' => [[[301, 303]], 303, false];
+
+        yield 'outside range' => [[[301, 303], [305, 399]], 304, true];
+
+        yield 'mixed codes and ranges' => [[[500, 599], 404], 404, false];
+    }
+
+    public function testFinishIgnoresTraceIgnoreStatusCodesOptionWithoutStatusCode(): void
+    {
+        $client = $this->createMock(ClientInterface::class);
+        $client->expects($this->any())
+            ->method('getOptions')
+            ->willReturn(new Options(['trace_ignore_status_codes' => [[100, 599]]]));
+
+        $hub = $this->createMock(HubInterface::class);
+        $hub->expects($this->any())
+            ->method('getClient')
+            ->willReturn($client);
+
+        $hub->expects($this->once())
+            ->method('captureEvent')
+            ->willReturn(EventId::generate());
+
+        $transaction = new Transaction(TransactionContext::make()->setSampled(true), $hub);
+        $transaction->finish();
+
+        $this->assertTrue($transaction->getSampled());
+    }
