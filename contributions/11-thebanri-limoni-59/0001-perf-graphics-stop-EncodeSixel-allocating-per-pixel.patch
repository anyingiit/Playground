-func buildPalette(img image.Image, maxColors int) color.Palette {
+// buildPalette creates a dynamic color palette from image pixels with a maximum
+// of maxColors, in order of first appearance, and returns each colour's index.
+// Pixels are read with rgbaAt, so building it does not allocate per pixel.
+func buildPalette(img image.Image, maxColors int) ([]color.RGBA, map[color.RGBA]int) {
 	bounds := img.Bounds()
-	var pal color.Palette
-	colorMap := make(map[color.RGBA]bool)
+	var pal []color.RGBA
+	index := make(map[color.RGBA]int)
 
 	for y := bounds.Min.Y; y < bounds.Max.Y; y++ {
 		for x := bounds.Min.X; x < bounds.Max.X; x++ {
-			c := color.RGBAModel.Convert(img.At(x, y)).(color.RGBA)
-			if !colorMap[c] {
-				if len(pal) < maxColors {
-					pal = append(pal, c)
-					colorMap[c] = true
-				}
+			if len(pal) >= maxColors {
+				return pal, index
+			}
+			r, g, b, a := rgbaAt(img, x, y)
+			c := color.RGBA{R: uint8(r >> 8), G: uint8(g >> 8), B: uint8(b >> 8), A: uint8(a >> 8)}
+			if _, ok := index[c]; !ok {
+				index[c] = len(pal)
+				pal = append(pal, c)
 			}
 		}
 	}
-	return pal
+	return pal, index
+}
+
+// paletteIndex returns the index of the palette colour closest to the 16-bit
+// premultiplied pixel r, g, b, a. It is color.Palette.Index without the
+// color.Color boxing: an exact 8-bit match is looked up in index, anything
+// else (a pixel with more than 8 bits of precision, or a colour that did not
+// fit in the palette) takes the same nearest-colour search, so the chosen
+// index is identical.
+func paletteIndex(pal []color.RGBA, index map[color.RGBA]int, r, g, b, a uint32) int {
+	c := color.RGBA{R: uint8(r >> 8), G: uint8(g >> 8), B: uint8(b >> 8), A: uint8(a >> 8)}
+	if r == uint32(c.R)*0x101 && g == uint32(c.G)*0x101 && b == uint32(c.B)*0x101 && a == uint32(c.A)*0x101 {
+		if idx, ok := index[c]; ok {
+			return idx
+		}
+	}
+	ret, bestSum := 0, uint32(1<<32-1)
+	for i, v := range pal {
+		vr, vg, vb, va := v.RGBA()
+		sum := sqDiff(r, vr) + sqDiff(g, vg) + sqDiff(b, vb) + sqDiff(a, va)
+		if sum < bestSum {
+			if sum == 0 {
+				return i
+			}
+			ret, bestSum = i, sum
+		}
+	}
+	return ret
+}
+
+// sqDiff is image/color's: the squared difference of two 16-bit values,
+// shifted right by 2 so that four of them add up without overflowing.
+func sqDiff(x, y uint32) uint32 {
+	d := x - y
+	return (d * d) >> 2
 }
 
