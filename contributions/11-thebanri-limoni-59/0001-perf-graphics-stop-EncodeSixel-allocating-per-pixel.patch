+
+// Building the Sixel palette and quantising each band used to read every
+// pixel through image.Image.At, which boxes a color.Color: ~51,000
+// allocations for BenchmarkEncodeSixel's 160×160 frame. What is left is
+// the resize, the output buffer growing and the palette map: 41 for a
+// 480×384 frame, and it must not grow with the number of pixels.
+func TestEncodeSixelDoesNotAllocatePerPixel(t *testing.T) {
+	img := image.NewRGBA(image.Rect(0, 0, 480, 384))
+	for y := 0; y < 384; y++ {
+		for x := 0; x < 480; x++ {
+			img.SetRGBA(x, y, color.RGBA{R: uint8(x / 32 * 16), G: uint8(y / 32 * 20), B: 128, A: 255})
+		}
+	}
+	// 60×24 cells of 8×16 pixels: a 480×384 frame, 184,320 pixels.
+	allocs := testing.AllocsPerRun(5, func() { _ = EncodeSixel(img, 60, 24, 8, 16, false) })
+	if allocs > 100 {
+		t.Fatalf("EncodeSixel made %.0f allocations for a 480×384 frame; it should not allocate per pixel", allocs)
+	}
+}
