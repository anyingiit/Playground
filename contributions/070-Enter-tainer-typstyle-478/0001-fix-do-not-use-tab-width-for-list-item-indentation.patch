From aad92cff4fede84c9534b78e47b52822dc97f4c6 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Fri, 23 Oct 2026 02:51:49 +0800
Subject: [PATCH] fix: do not use tab-width for list item indentation

List, enum and term item bodies were nested by the configured
tab_spaces, so with --tab-width=4 wrapped lines and nested items got a
four-space hanging indent. Use a fixed two-space indent (the width of
`- `) for item bodies; tab_spaces keeps applying to code.

Closes #478
---
 CHANGELOG.md                                  |  7 ++
 crates/typstyle-core/src/pretty/markup.rs     | 15 ++-
 .../fixtures/unit/markup/list-indent-tab4.typ | 14 +++
 .../markup/snap/list-indent-tab4.typ-0.snap   | 91 +++++++++++++++++++
 .../markup/snap/list-indent-tab4.typ-120.snap | 18 ++++
 .../markup/snap/list-indent-tab4.typ-40.snap  | 29 ++++++
 .../markup/snap/list-indent-tab4.typ-80.snap  | 21 +++++
 7 files changed, 192 insertions(+), 3 deletions(-)
 create mode 100644 tests/fixtures/unit/markup/list-indent-tab4.typ
 create mode 100644 tests/fixtures/unit/markup/snap/list-indent-tab4.typ-0.snap
 create mode 100644 tests/fixtures/unit/markup/snap/list-indent-tab4.typ-120.snap
 create mode 100644 tests/fixtures/unit/markup/snap/list-indent-tab4.typ-40.snap
 create mode 100644 tests/fixtures/unit/markup/snap/list-indent-tab4.typ-80.snap

diff --git a/CHANGELOG.md b/CHANGELOG.md
index e8333bc..9f2b35e 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -4,6 +4,13 @@
 
 - Fix: Recognize enum markers with numbers up to `u64::MAX` on 32-bit targets, matching the Typst lexer, so text wrapping no longer breaks before them.
   ([#506](https://github.com/typstyle-rs/typstyle/issues/506))
+- Fix: list, enum and term items no longer use the configured `tab_spaces` (`--tab-width`) as the hanging indent of their wrapped lines and nested content. Item bodies are now always indented by two spaces, so the output with `--tab-width=4` looks like:
+  ```typst
+  - this is a wrapped list item
+    with a tab-width of 4
+    - nested item
+  ```
+  ([#478](https://github.com/typstyle-rs/typstyle/issues/478))
 
 ## v0.15.2 - [2026-10-11]
 
diff --git a/crates/typstyle-core/src/pretty/markup.rs b/crates/typstyle-core/src/pretty/markup.rs
index 5b8916a..1491c68 100644
--- a/crates/typstyle-core/src/pretty/markup.rs
+++ b/crates/typstyle-core/src/pretty/markup.rs
@@ -184,11 +184,11 @@ impl<'a> PrettyPrinter<'a> {
             }
             _ => FlowItem::none(),
         });
-        self.indent(body)
+        self.indent_item(body)
     }
 
     /// Converts the body shared by list, enum, and term items: the marker followed by
-    /// the content in [`MarkupScope::Item`] scope, indented one level.
+    /// the content in [`MarkupScope::Item`] scope, indented as an item body.
     fn convert_list_item_like(&'a self, ctx: Context, item: &'a SyntaxNode) -> ArenaDoc<'a> {
         let body = self.convert_flow_like(ctx, item, |ctx, child, _| match child.kind() {
             SyntaxKind::ListMarker | SyntaxKind::EnumMarker | SyntaxKind::TermMarker => {
@@ -212,7 +212,16 @@ impl<'a> PrettyPrinter<'a> {
             }
             _ => FlowItem::none(),
         });
-        self.indent(body)
+        self.indent_item(body)
+    }
+
+    /// Indents the body of a list/enum/term item.
+    ///
+    /// Item bodies use a fixed hanging indent of two spaces (the width of `- `),
+    /// independent of the configured `tab_spaces`, which only applies to code.
+    fn indent_item(&'a self, body: ArenaDoc<'a>) -> ArenaDoc<'a> {
+        const ITEM_INDENT: isize = 2;
+        body.nest(ITEM_INDENT)
     }
 
     /// Converts a markup node, honoring the given [`MarkupScope`].
diff --git a/tests/fixtures/unit/markup/list-indent-tab4.typ b/tests/fixtures/unit/markup/list-indent-tab4.typ
new file mode 100644
index 0000000..8a9cf7d
--- /dev/null
+++ b/tests/fixtures/unit/markup/list-indent-tab4.typ
@@ -0,0 +1,14 @@
+/// typstyle: tab_spaces=4 wrap_text
+
+- this is the formatting of a wrapped list item with a tab-width of 4, which should keep a hanging indent of two spaces
+  - nested item
+    - deeper nested item
+
++ an enum item that is long enough to be wrapped onto the next line when the width is small
++ another
+
+/ Term: a term item whose description is long enough to be wrapped onto the next line too
+
+#{
+  [- a list item inside code with a long enough body to get wrapped somewhere]
+}
