From 22604576ce95c4cf31625be0023caccd386ea80f Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:35:26 +0000
Subject: [PATCH] fix: shell completion follow-ups from #250 review (#259)

- zsh: exclusion groups now match the binary. --json/--jsonl and
  --table/--no-table may be combined (the last one wins); only --markdown
  conflicts with --json, --jsonl and --no-header.
- zsh: --root completes a comma-separated directory list, like bash.
- tests/completions_test.zig: a flag only counts when it is named by a
  completion spec, so a mention in a comment, in another option's
  exclusion group or in a description no longer satisfies the drift test.
- README: macOS Terminal reads ~/.bash_profile; the zsh steps create the
  directory and add it to fpath before compinit.
---
 README.md                  |  8 +++-
 completions/_csvql         | 14 +++----
 tests/completions_test.zig | 82 ++++++++++++++++++++++++++++++++++----
 3 files changed, 88 insertions(+), 16 deletions(-)

diff --git a/README.md b/README.md
index f471854..c56f627 100644
--- a/README.md
+++ b/README.md
@@ -162,11 +162,15 @@ sudo cp zig-out/bin/csvql /usr/local/bin/
 **Shell completions** for bash and zsh live in [`completions/`](completions/). They complete the flags in `csvql --help`, the `install` subcommand and file paths.
 
 ```bash
-# bash: add to ~/.bashrc
+# bash: add to ~/.bashrc (on macOS, Terminal opens login shells, so use ~/.bash_profile)
 source /path/to/csvql/completions/csvql.bash
 
-# zsh: put _csvql on your fpath before compinit
+# zsh: put _csvql in a directory on your fpath
+mkdir -p ~/.zsh/completions
 cp completions/_csvql ~/.zsh/completions/_csvql
+# then in ~/.zshrc, before compinit runs:
+#   fpath=(~/.zsh/completions $fpath)
+#   autoload -Uz compinit && compinit
 ```
 
 ## Performance
diff --git a/completions/_csvql b/completions/_csvql
index e799fb9..3249279 100644
--- a/completions/_csvql
+++ b/completions/_csvql
@@ -17,21 +17,21 @@ fi
 _arguments -S \
     '(- *)'{-h,--help}'[show help]' \
     '(- *)'{-v,--version}'[show version]' \
-    '--no-header[suppress header row in output]' \
+    '(--markdown)--no-header[suppress header row in output]' \
     '--no-input-header[treat the first row as data, name columns c1..cN]' \
     '(-o --output)'{-o,--output}'[write results to a file instead of stdout]:output file:_files' \
