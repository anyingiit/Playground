From 89ece6e3504ce61959ae78ac3df3451150e3205a Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 17:33:13 +0000
Subject: [PATCH] fix(ui): report unreadable counts as corrupt in
 /api/project-health

handle_project_health passed the results of cbm_store_count_nodes and
cbm_store_count_edges straight into the response. Since the count
helpers return CBM_STORE_ERR (-1) on a failed read, a store whose nodes
or edges table is missing or damaged was reported as
{"status":"healthy","nodes":-1,"edges":-1,...}.

Treat a negative count as a failed read, as index_status already does,
and answer {"status":"corrupt","reason":"cannot read <table>"} naming
the table(s) that could not be read. "corrupt" is already a state the
graph UI's StatsTab renders.

Fixes #2232

Signed-off-by: anyingiit <49945850+anyingiit@users.noreply.github.com>
---
 src/ui/http_server.c | 15 ++++++++++++++
 tests/test_httpd.c   | 48 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 63 insertions(+)

diff --git a/src/ui/http_server.c b/src/ui/http_server.c
index 66f1aff..7da2de1 100644
--- a/src/ui/http_server.c
+++ b/src/ui/http_server.c
@@ -1368,6 +1368,21 @@ static void handle_project_health(cbm_http_conn_t *c, const cbm_http_req_t *req)
     int edge_count = cbm_store_count_edges(store, name);
     cbm_store_close(store);
 
+    /* A negative count is a failed read (CBM_STORE_ERR), e.g. a store whose
+     * nodes or edges table is missing or damaged. That is not a healthy
+     * project with -1 rows; report it as corrupt and name what failed. */
+    const bool nodes_unreadable = node_count < 0;
+    const bool edges_unreadable = edge_count < 0;
+    if (nodes_unreadable || edges_unreadable) {
+        const char *what = "edges";
+        if (nodes_unreadable) {
+            what = edges_unreadable ? "nodes and edges" : "nodes";
+        }
+        cbm_http_replyf(c, 200, g_cors_json,
+                        "{\"status\":\"corrupt\",\"reason\":\"cannot read %s\"}", what);
+        return;
+    }
+
     int64_t size = cbm_file_size(db_path);
 
     cbm_http_replyf(c, 200, g_cors_json,
diff --git a/tests/test_httpd.c b/tests/test_httpd.c
index 322130c..40d5d66 100644
--- a/tests/test_httpd.c
+++ b/tests/test_httpd.c
@@ -1430,6 +1430,53 @@ TEST(ui_server_delete_mutation_guard_balances_success) {
     PASS();
 }
 
+static int ui_project_health_request(th_server_t *ts, const char *project, char *resp,
+                                     size_t respsz) {
+    char req[512];
+    int req_len =
+        snprintf(req, sizeof(req), "GET /api/project-health?name=%s HTTP/1.1\r\n\r\n", project);
+    if (req_len < 0 || (size_t)req_len >= sizeof(req))
+        return 0;
+    return th_http(cbm_http_server_port(ts->srv), req, resp, respsz);
+}
+
+/* #2232: a store whose nodes/edges tables cannot be read must not be reported
+ * as healthy with -1 counts. */
+TEST(ui_server_project_health_reports_unreadable_counts_issue2232) {
+    ui_delete_fixture_t fx;
+    ASSERT_EQ(ui_delete_fixture_init(&fx), 0);
+    char db_path[1024];
+    ui_delete_db_path(&fx, "ui-health", db_path, sizeof(db_path));
+    cbm_store_t *store = cbm_store_open_path(db_path);
+    ASSERT_NOT_NULL(store);
+
+    th_server_t ts;
+    ASSERT_EQ(th_server_start(&ts), 0);
+    char resp[4096];
+
+    /* Intact schema: healthy. */
+    int n = ui_project_health_request(&ts, "ui-health", resp, sizeof(resp));
+    ASSERT_GT(n, 0);
+    ASSERT_EQ(th_status(resp), 200);
+    ASSERT_NOT_NULL(strstr(resp, "\"status\":\"healthy\""));
+
+    ASSERT_EQ(cbm_store_exec(store, "DROP TABLE nodes;"), 0);
+    ASSERT_EQ(cbm_store_exec(store, "DROP TABLE edges;"), 0);
+    cbm_store_close(store);
+
+    n = ui_project_health_request(&ts, "ui-health", resp, sizeof(resp));
+    ASSERT_GT(n, 0);
+    ASSERT_EQ(th_status(resp), 200);
+    ASSERT_NULL(strstr(resp, "healthy"));
+    ASSERT_NULL(strstr(resp, "-1"));
+    ASSERT_NOT_NULL(strstr(resp, "\"status\":\"corrupt\""));
+    ASSERT_NOT_NULL(strstr(resp, "\"reason\":\"cannot read nodes and edges\""));
+
+    th_server_stop(&ts);
+    ui_delete_fixture_cleanup(&fx);
+    PASS();
+}
+
 TEST(ui_server_delete_project_unwatches_after_delete) {
     ui_delete_fixture_t fx;
     ASSERT_EQ(ui_delete_fixture_init(&fx), 0);
@@ -2471,6 +2518,7 @@ SUITE(httpd) {
     RUN_TEST(ui_server_adr_mutation_guard_balances_success);
     RUN_TEST(ui_server_delete_mutation_guard_busy_preserves_project);
     RUN_TEST(ui_server_delete_mutation_guard_balances_success);
+    RUN_TEST(ui_server_project_health_reports_unreadable_counts_issue2232);
     RUN_TEST(ui_server_delete_project_unwatches_after_delete);
     RUN_TEST(ui_server_delete_project_unwatches_missing_db);
     RUN_TEST(ui_server_delete_project_no_watcher_still_deletes);
