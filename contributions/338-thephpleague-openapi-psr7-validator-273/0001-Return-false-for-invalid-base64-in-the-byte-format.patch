From 1ff0ac497def9cf52f08e3cdd59fffe2b58bdca8 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:10:26 +0000
Subject: [PATCH] Return false for invalid base64 in the byte format

base64_decode() returns false in strict mode when the input is not valid
base64, and passing that to base64_encode() throws a TypeError on PHP 8
instead of failing the format check.

Fixes #273
---
 src/Schema/TypeFormats/StringByte.php       |  7 ++-
 tests/Schema/TypeFormats/StringByteTest.php | 50 +++++++++++++++++++++
 2 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 tests/Schema/TypeFormats/StringByteTest.php

diff --git a/src/Schema/TypeFormats/StringByte.php b/src/Schema/TypeFormats/StringByte.php
index 769f085..31dde2a 100644
--- a/src/Schema/TypeFormats/StringByte.php
+++ b/src/Schema/TypeFormats/StringByte.php
@@ -16,6 +16,11 @@ class StringByte
     {
         //base64-encoded characters, for example, U3dhZ2dlciByb2Nrcw==
 
-        return base64_encode(base64_decode($value, true)) === $value;
+        $decoded = base64_decode($value, true);
+        if ($decoded === false) {
+            return false;
+        }
+
+        return base64_encode($decoded) === $value;
     }
 }
diff --git a/tests/Schema/TypeFormats/StringByteTest.php b/tests/Schema/TypeFormats/StringByteTest.php
new file mode 100644
index 0000000..7b674a2
--- /dev/null
+++ b/tests/Schema/TypeFormats/StringByteTest.php
@@ -0,0 +1,50 @@
+<?php
+
+declare(strict_types=1);
+
+namespace League\OpenAPIValidation\Tests\Schema\TypeFormats;
+
+use League\OpenAPIValidation\Schema\TypeFormats\StringByte;
+use PHPUnit\Framework\TestCase;
+
+class StringByteTest extends TestCase
+{
+    /**
+     * @return array<array<string>>
+     */
+    public function greenByteDataProvider(): array
+    {
+        return [
+            'padded' => ['U3dhZ2dlciByb2Nrcw=='],
+            'empty string' => [''],
+        ];
+    }
+
+    /**
+     * @return array<array<string>>
+     */
+    public function redByteDataProvider(): array
+    {
+        return [
+            'invalid characters' => ['%%%'],
+            'whitespace' => ['U3dh Z2dlcg=='],
+            'misplaced padding' => ['U3=dhZ2dlcg='],
+        ];
+    }
+
+    /**
+     * @dataProvider greenByteDataProvider
+     */
+    public function testGreenByteFormat(string $value): void
+    {
+        $this->assertTrue((new StringByte())($value));
+    }
+
+    /**
+     * @dataProvider redByteDataProvider
+     */
+    public function testRedByteFormat(string $value): void
+    {
+        $this->assertFalse((new StringByte())($value));
+    }
+}
