From 36c1f5fff25500ab9b8b6ed7b19dde8b113ee3a0 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 21:37:22 +0000
Subject: [PATCH] Show account creation date on profile
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Display "Joined {Month} {Year}" next to the herd update date on a user's
herd page, and shorten the existing label to "Herd updated" so the line
reads "Joined March 2021 • Herd updated 2 days ago".

Closes #347
---
 .../views/components/user-profile.blade.php   | 11 ++++++++--
 resources/views/herd/show.blade.php           |  2 +-
 tests/Feature/ExampleTest.php                 | 21 ++++++++++++++++++-
 3 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/resources/views/components/user-profile.blade.php b/resources/views/components/user-profile.blade.php
index 2e5e762..e42075c 100644
--- a/resources/views/components/user-profile.blade.php
+++ b/resources/views/components/user-profile.blade.php
@@ -4,6 +4,7 @@
     'nameAsLink' => false,
     'compact' => false,
     'lastUpdated' => null,
+    'showJoined' => false,
 ])
 
 @php
@@ -26,10 +27,16 @@
             <flux:heading size="xl" level="1" class="text-zinc-600 dark:text-zinc-300">{{ $user->name }}</flux:heading>
         @endif
         <x-country-with-flag :country="$country" />
-        @if($lastUpdated)
+        @php
+            $profileDates = array_filter([
+                $showJoined && $user->created_at ? 'Joined ' . $user->created_at->format('F Y') : null,
+                $lastUpdated ? 'Herd updated ' . \Carbon\Carbon::parse($lastUpdated)->diffForHumans() : null,
+            ]);
+        @endphp
+        @if($profileDates)
             <flux:text class="{{ $compact ? 'text-sm text-zinc-500 dark:text-zinc-400' : '' }} mt-1 flex items-center gap-1">
                 <flux:icon icon="calendar" variant="outline" class="size-4" />
-                Herd last updated {{ \Carbon\Carbon::parse($lastUpdated)->diffForHumans() }}
+                {{ implode(' • ', $profileDates) }}
             </flux:text>
         @endif
         @if($user->x_handle)
diff --git a/resources/views/herd/show.blade.php b/resources/views/herd/show.blade.php
index 4a1a43d..480e4b6 100644
--- a/resources/views/herd/show.blade.php
+++ b/resources/views/herd/show.blade.php
@@ -3,7 +3,7 @@
 @section('content')
     <div class="space-y-6">
         <div class="flex flex-wrap items-start gap-4 py-6 md:py-8">
-            <x-user-profile :user="$user" :countries="$countries" :last-updated="$herdLastUpdated" />
+            <x-user-profile :user="$user" :countries="$countries" :last-updated="$herdLastUpdated" show-joined />
         </div>
 
         <div id="stats">
diff --git a/tests/Feature/ExampleTest.php b/tests/Feature/ExampleTest.php
index 25030ce..2eb2afa 100644
--- a/tests/Feature/ExampleTest.php
+++ b/tests/Feature/ExampleTest.php
@@ -38,7 +38,26 @@ test('herd show displays the last herd update', function () {
     $response = $this->get(route('herds.show', $user->username));
 
     $response->assertSuccessful();
-    $response->assertSee('Herd last updated');
+    $response->assertSee('Herd updated');
+});
+
+test('herd show displays when the user joined alongside the last herd update', function () {
+    $user = User::factory()->create(['created_at' => '2021-03-15 10:00:00']);
+    $elephpant = Elephpant::factory()->create();
+    $user->elephpants()->attach($elephpant->id, ['quantity' => 1]);
+
+    $this->get(route('herds.show', $user->username))
+        ->assertSuccessful()
+        ->assertSeeInOrder(['Joined March 2021', '•', 'Herd updated']);
+});
+
+test('herd show displays when the user joined even without any elephpants', function () {
+    $user = User::factory()->create(['created_at' => '2019-11-02 08:30:00']);
+
+    $this->get(route('herds.show', $user->username))
+        ->assertSuccessful()
+        ->assertSee('Joined November 2019')
+        ->assertDontSee('Herd updated');
 });
 
 test('herd show with authenticated user includes contact section', function () {
-- 
2.43.0

