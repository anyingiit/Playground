From b709e98229f59ab80f8aec04b2c1347e25ab3c24 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:53:19 +0000
Subject: [PATCH] Coerce struct attributes individually in the struct extension

When a struct class was given to `value`/`hash`, the extension defined
the nested schema from the struct's attributes, which already coerces
each key, and then also wrapped the key's type in a constructor that
coerced the whole hash through the struct's schema. That constructor
either coerced every attribute or, if any single attribute failed,
none of them. So one invalid attribute left the other values
uncoerced, and attributes with coercible types (e.g. JSON decimals or
dates) were reported as invalid too.

Drop the extra constructor and rely on the per-key types of the nested
schema.

Fixes #468
---
 CHANGELOG.md                        |  2 +
 lib/dry/schema/extensions/struct.rb |  1 -
 spec/extensions/struct_spec.rb      | 75 +++++++++++++++++++++++++++++
 3 files changed, 77 insertions(+), 1 deletion(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index b08ada5..2cdb7cd 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -17,6 +17,8 @@ and this project adheres to [Break Versioning](https://www.taoensso.com/break-ve
 
 ### Fixed
 
+- With the struct extension, coerce each struct attribute on its own. Previously, the whole struct was also coerced at once, so a single invalid attribute stopped every other attribute from being coerced, and valid attributes with coercible types (e.g. `Types::JSON::Decimal`) were reported as errors too. This also fixes coercion of struct elements in `array(Struct)` and accepting `nil` in `maybe(Struct)`. (@anyingiit)
+
 ### Security
 
 [Unreleased]: https://github.com/dry-rb/dry-schema/compare/v1.16.0...main
diff --git a/lib/dry/schema/extensions/struct.rb b/lib/dry/schema/extensions/struct.rb
index 24cb004..26e35fa 100644
--- a/lib/dry/schema/extensions/struct.rb
+++ b/lib/dry/schema/extensions/struct.rb
@@ -31,7 +31,6 @@ module Dry
             schema = struct_compiler.(struct_class)
 
             super(schema, *args.drop(1))
-            type(schema_dsl.types[name].constructor(schema))
           else
             super
           end
diff --git a/spec/extensions/struct_spec.rb b/spec/extensions/struct_spec.rb
index 4ef4ef9..61e9b5f 100644
--- a/spec/extensions/struct_spec.rb
+++ b/spec/extensions/struct_spec.rb
@@ -134,4 +134,79 @@ RSpec.describe "struct extension" do
       expect(schema.(input).errors.to_h).to eq({})
     end
   end
+
+  context "struct with coercible attributes" do
+    let(:struct) do
+      Class.new(Dry::Struct) do
+        attribute :date, Types::JSON::Date
+        attribute :number, Types::JSON::Decimal
+        attribute :string, Types::String
+      end
+    end
+
+    let(:schema) do
+      struct = self.struct
+
+      Dry::Schema.Params do
+        required(:foo).value(struct)
+      end
+    end
+
+    it "coerces valid attributes" do
+      result = schema.(foo: {date: "2023-09-07", number: "42", string: "Hi!"})
+
+      expect(result).to be_success
+      expect(result.to_h).to eq(foo: {date: Date.new(2023, 9, 7), number: BigDecimal("42"), string: "Hi!"})
+    end
+
+    it "reports errors only for invalid attributes" do
+      expect(schema.(foo: {date: "00", number: "42", string: "Hi!"}).errors.to_h).to eq(
+        foo: {date: ["must be a date"]}
+      )
+
+      expect(schema.(foo: {date: "2023-09-07", number: "42", string: 42}).errors.to_h).to eq(
+        foo: {string: ["must be a string"]}
+      )
+    end
+
+    context "as array elements" do
+      let(:schema) do
+        struct = self.struct
+
+        Dry::Schema.Params do
+          required(:foo).array(struct)
+        end
+      end
+
+      it "coerces valid attributes of each element" do
+        result = schema.(foo: [{date: "2023-09-07", number: "42", string: "Hi!"}])
+
+        expect(result).to be_success
+        expect(result.to_h).to eq(foo: [{date: Date.new(2023, 9, 7), number: BigDecimal("42"), string: "Hi!"}])
+      end
+    end
+
+    context "with maybe" do
+      let(:schema) do
+        struct = self.struct
+
+        Dry::Schema.Params do
+          required(:foo).maybe(struct)
+        end
+      end
+
+      it "accepts nil" do
+        result = schema.(foo: nil)
+
+        expect(result).to be_success
+        expect(result.to_h).to eq(foo: nil)
+      end
+    end
+
+    it "coerces valid attributes when other attributes are invalid" do
+      result = schema.(foo: {date: "00", number: "42", string: "Hi!"})
+
+      expect(result.to_h).to eq(foo: {date: "00", number: BigDecimal("42"), string: "Hi!"})
+    end
+  end
 end
