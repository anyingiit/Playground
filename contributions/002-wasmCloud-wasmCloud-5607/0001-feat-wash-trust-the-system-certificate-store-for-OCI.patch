+        wash_runtime::oci::set_trust_native_roots(true);
 
         let mut oci_config = OciConfig::new_with_cache(ctx.cache_dir().join(OCI_CACHE_DIR));
         oci_config.insecure = self.insecure;
@@ -60,6 +65,24 @@ impl RegistryArgs {
     }
 }
 
+/// Point at `--ca-path` when a registry's certificate was rejected because its
+/// issuer is not trusted: the underlying `UnknownIssuer` error says nothing
+/// about how to fix it.
+pub(crate) fn with_ca_hint(err: anyhow::Error) -> anyhow::Error {
+    let unknown_issuer = err
+        .chain()
+        .any(|cause| cause.to_string().contains("UnknownIssuer"));
+    if unknown_issuer {
+        err.context(
+            "the registry's TLS certificate is signed by a CA that is not trusted; pass its CA \
+             bundle with --ca-path <ca.pem> (or WASH_OCI_CA_PATHS), or add it to the system \
+             trust store or SSL_CERT_FILE",
+        )
+    } else {
+        err
+    }
+}
+
 /// Push or pull Wasm components to/from an OCI registry
 #[derive(Parser, Debug, Clone)]
 #[command(subcommand_required = true, arg_required_else_help = true)]
@@ -118,7 +141,8 @@ impl PullCommand {
             pull_policy: OciPullPolicy::Always,
         }
         .load(oci_config)
-        .await?;
+        .await
+        .map_err(with_ca_hint)?;
 
         // Resolve component path relative to project directory if not absolute
         let component_path = if self.component_path.is_absolute() {
@@ -227,7 +251,8 @@ impl PushCommand {
             oci_config,
             Some(all_annotations),
         )
-        .await?;
+        .await
+        .map_err(with_ca_hint)?;
 
         Ok(CommandOutput::ok(
             "OCI command executed successfully.".to_string(),
@@ -239,3 +264,32 @@ impl PushCommand {
         ))
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::with_ca_hint;
+
+    #[test]
+    fn unknown_issuer_errors_point_at_ca_path() {
+        let err = anyhow::anyhow!("invalid peer certificate: UnknownIssuer")
+            .context("client error (Connect)")
+            .context("failed to push component");
+
+        let hinted = with_ca_hint(err);
+
+        assert!(hinted.to_string().contains("--ca-path"));
+        assert!(
+            hinted
+                .chain()
+                .any(|cause| cause.to_string().contains("UnknownIssuer")),
+            "the original cause must be kept"
+        );
+    }
+
+    #[test]
+    fn other_errors_are_left_alone() {
+        let hinted = with_ca_hint(anyhow::anyhow!("manifest unknown"));
+
+        assert_eq!(hinted.to_string(), "manifest unknown");
+    }
+}
