 }
 
+/// Whether every OCI client in this process also trusts the platform's native
+/// certificate store (the OS trust store, honouring `SSL_CERT_FILE` and
+/// `SSL_CERT_DIR`), on top of the compiled-in webpki roots.
+///
+/// Off by default, so a host keeps the reproducible compiled-in roots and its
+/// egress trust is not widened by the environment it runs in. Interactive
+/// commands such as `wash oci push` turn it on, so a registry behind a private
+/// CA the machine already trusts works without a wash-specific flag.
+static TRUST_NATIVE_ROOTS: AtomicBool = AtomicBool::new(false);
+
+/// The platform's native root certificates, loaded once on first use.
+static NATIVE_CA_CERTIFICATES: OnceLock<Vec<Certificate>> = OnceLock::new();
+
+/// Also trust the platform's native certificate store for every subsequent OCI
+/// pull or push in this process. See [`TRUST_NATIVE_ROOTS`].
+pub fn set_trust_native_roots(enabled: bool) {
+    TRUST_NATIVE_ROOTS.store(enabled, Ordering::Relaxed);
+}
+
+/// Load the platform's native root certificates.
+///
+/// A store that fails to load, or a certificate in it that does not parse, is
+/// logged and skipped rather than failing the pull: the native store is an
+/// addition to the compiled-in roots, not a replacement for them.
+fn load_native_ca_certificates() -> Vec<Certificate> {
+    let native = rustls_native_certs::load_native_certs();
+    for err in &native.errors {
+        warn!(err = %err, "failed to load a native root certificate; skipping it");
+    }
+    let certs = usable_trust_roots(native.certs);
+    debug!(
+        count = certs.len(),
+        "trusting native root certificates for OCI"
+    );
+    certs
+}
+
+/// Keep only the certificates that are usable as trust roots, as DER.
+///
+/// Filtering here matters: `oci-client` falls back to a wholly default
+/// configuration when one certificate fails to parse (see
+/// [`load_ca_certificates`]), and an OS store routinely holds a few entries
+/// webpki rejects.
+fn usable_trust_roots(
+    certs: impl IntoIterator<Item = rustls::pki_types::CertificateDer<'static>>,
+) -> Vec<Certificate> {
+    certs
+        .into_iter()
+        .filter(|cert| rustls::RootCertStore::empty().add(cert.clone()).is_ok())
+        .map(|cert| Certificate {
+            encoding: CertificateEncoding::Der,
+            data: cert.to_vec(),
+        })
+        .collect()
+}
+
 /// The extra CA certificates configured for this process, for a `ClientConfig`.
 fn extra_ca_certificates() -> Vec<Certificate> {
-    EXTRA_CA_CERTIFICATES
+    let mut certs = EXTRA_CA_CERTIFICATES
         .get()
         .map(|trust| trust.certs.clone())
-        .unwrap_or_default()
+        .unwrap_or_default();
+    if TRUST_NATIVE_ROOTS.load(Ordering::Relaxed) {
+        certs.extend(
+            NATIVE_CA_CERTIFICATES
+                .get_or_init(load_native_ca_certificates)
+                .iter()
+                .cloned(),
+        );
+    }
+    certs
 }
 
 #[allow(deprecated)]
@@ -1048,6 +1116,23 @@ mod tests {
             .pem()
     }
 
+    /// Native roots are handed to `oci-client` as DER, and anything webpki
+    /// would reject is dropped first so one bad entry in the OS store cannot
+    /// make `oci-client` discard the whole client configuration.
+    #[test]
+    fn only_usable_native_roots_are_trusted() {
+        let good = rcgen::generate_simple_self_signed(vec!["native.test".to_string()])
+            .expect("generating a test certificate")
+            .cert;
+        let garbage = rustls::pki_types::CertificateDer::from(b"not a certificate".to_vec());
+
+        let roots = usable_trust_roots([good.der().clone(), garbage]);
+
+        assert_eq!(roots.len(), 1, "the unparsable certificate must be skipped");
+        assert!(matches!(roots[0].encoding, CertificateEncoding::Der));
+        assert_eq!(roots[0].data, good.der().to_vec());
+    }
+
