diff --git a/crates/wash/src/cli/oci.rs b/crates/wash/src/cli/oci.rs
index 9ede60b..be51e46 100644
--- a/crates/wash/src/cli/oci.rs
+++ b/crates/wash/src/cli/oci.rs
@@ -26,8 +26,9 @@ pub struct RegistryArgs {
     #[arg(short, long)]
