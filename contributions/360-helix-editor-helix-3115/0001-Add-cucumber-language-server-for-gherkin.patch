From f09017d160bd61a10206459fe96fe17eaf30f49a Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:23:09 +0000
Subject: [PATCH] Add cucumber-language-server for gherkin

---
 book/src/generated/lang-support.md | 2 +-
 languages.toml                     | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/book/src/generated/lang-support.md b/book/src/generated/lang-support.md
index eac6942..8789279 100644
--- a/book/src/generated/lang-support.md
+++ b/book/src/generated/lang-support.md
@@ -88,7 +88,7 @@
 | gas | ✓ | ✓ |  |  |  | `asm-lsp` |
 | gdscript | ✓ | ✓ | ✓ | ✓ | ✓ | `ncat` |
 | gemini | ✓ |  |  |  |  |  |
-| gherkin | ✓ |  |  |  |  |  |
+| gherkin | ✓ |  |  |  |  | `cucumber-language-server` |
 | ghostty | ✓ |  |  |  |  | `ghostty-ls` |
 | git-attributes | ✓ |  |  |  |  |  |
 | git-cliff-config | ✓ | ✓ |  |  | ✓ | `taplo`, `tombi` |
diff --git a/languages.toml b/languages.toml
index a5403e6..bf42e77 100644
--- a/languages.toml
+++ b/languages.toml
@@ -33,6 +33,7 @@ commit-lsp = { command = "commit-lsp", args = ["run"] }
 crystalline = { command = "crystalline", args = ["--stdio"] }
 cs = { command = "cs", args = ["launch", "--contrib", "smithy-language-server", "--", "0"] }
 csharp-ls = { command = "csharp-ls" }
+cucumber-language-server = { command = "cucumber-language-server", args = ["--stdio"] }
 cuelsp = { command = "cue", args = ["lsp", "serve"] }
 dart = { command = "dart", args = ["language-server", "--client-id=helix"] }
 debian-lsp = { command = "debian-lsp" }
@@ -4633,6 +4634,7 @@ scope = "source.feature"
 file-types = ["feature"]
 comment-token = "#"
 indent = { tab-width = 2, unit = "  " }
+language-servers = [ "cucumber-language-server" ]
 
 [[grammar]]
 name = "gherkin"
-- 
2.43.0

