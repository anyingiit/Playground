@@ -2581,6 +2587,76 @@ mod tests {
         assert!(cmd.detach);
     }
 
+    /// `SMOLVM_MACHINE_NAME` supplies `--name` for commands that act on an
+    /// existing machine. Kept in one test because it mutates the process
+    /// environment; no other parser test relies on these commands' env-less
+    /// default.
+    #[test]
+    fn machine_name_falls_back_to_env_var() {
+        fn name_of(args: &[&str]) -> Option<String> {
+            let mut argv = vec!["machine"];
+            argv.extend_from_slice(args);
+            match TestMachineCli::parse_from(argv).command {
+                MachineCmd::Exec(cmd) => cmd.name,
+                MachineCmd::Shell(cmd) => cmd.name,
+                MachineCmd::Start(cmd) => cmd.name,
+                MachineCmd::Stop(cmd) => cmd.name,
+                MachineCmd::Status(cmd) => cmd.name,
+                MachineCmd::EgressEvents(cmd) => cmd.name,
+                MachineCmd::Resize(cmd) => cmd.name,
+                MachineCmd::Sync(cmd) => cmd.name,
+                MachineCmd::Monitor(cmd) => cmd.name,
+                MachineCmd::NetworkTest(cmd) => cmd.name,
+                MachineCmd::Run(cmd) => cmd.name,
+                other => panic!("unexpected command: {other:?}"),
+            }
+        }
+        let commands: &[&[&str]] = &[
+            &["exec", "--", "true"],
+            &["shell"],
+            &["start"],
+            &["stop"],
+            &["status"],
+            &["egress-events"],
+            &["resize", "--storage", "50"],
+            &["sync"],
+            &["monitor"],
+            &["network-test"],
+        ];
+
+        let previous = std::env::var_os(MACHINE_NAME_ENV);
+        std::env::remove_var(MACHINE_NAME_ENV);
+        for args in commands {
+            assert_eq!(name_of(args), None, "no env, no flag: {args:?}");
+        }
+
+        std::env::set_var(MACHINE_NAME_ENV, "proj-vm");
+        for args in commands {
+            assert_eq!(
+                name_of(args),
+                Some("proj-vm".to_string()),
+                "env fallback: {args:?}"
+            );
+            let mut explicit = args.to_vec();
+            explicit.splice(1..1, ["--name", "other"]);
+            assert_eq!(
+                name_of(&explicit),
+                Some("other".to_string()),
+                "explicit --name wins: {explicit:?}"
+            );
+        }
+        // Ephemeral `run` must not silently pick up a persistent name, and
+        // commands that create or destroy a machine still require --name.
+        assert_eq!(name_of(&["run", "--image", "alpine"]), None);
+        assert!(TestMachineCli::try_parse_from(["machine", "delete"]).is_err());
+        assert!(TestMachineCli::try_parse_from(["machine", "update"]).is_err());
+
+        match previous {
+            Some(value) => std::env::set_var(MACHINE_NAME_ENV, value),
+            None => std::env::remove_var(MACHINE_NAME_ENV),
+        }
+    }
+
