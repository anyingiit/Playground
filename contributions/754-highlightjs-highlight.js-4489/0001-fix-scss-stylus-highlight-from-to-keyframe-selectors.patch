+  <span class="hljs-attribute">background</span>: <span class="hljs-built_in">linear-gradient</span>(to right, red, blue);
+}
+
+<span class="hljs-selector-class">.fade</span> {
+  &amp;-enter-from, &amp;-leave-to { <span class="hljs-attribute">opacity</span>: <span class="hljs-number">0</span>; }
+}
diff --git a/test/markup/scss/keyframes.txt b/test/markup/scss/keyframes.txt
new file mode 100644
index 0000000..8ec45b5
--- /dev/null
+++ b/test/markup/scss/keyframes.txt
@@ -0,0 +1,16 @@
+@keyframes fade {
+  from, 50% { opacity: 0; }
+  to { opacity: 1; }
+}
+
+@for $i from 1 through 3 {
+  .item-#{$i} { width: 2em * $i; }
+}
+
+.banner {
+  background: linear-gradient(to right, red, blue);
+}
+
+.fade {
+  &-enter-from, &-leave-to { opacity: 0; }
+}
