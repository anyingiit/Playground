diff --git a/pylint/extensions/exit_argument_names.py b/pylint/extensions/exit_argument_names.py
new file mode 100644
index 0000000..25599a0
--- /dev/null
+++ b/pylint/extensions/exit_argument_names.py
@@ -0,0 +1,76 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/pylint-dev/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/pylint-dev/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Optional checker for the argument names of ``__exit__`` and ``__aexit__``."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from astroid import nodes
+
+from pylint.checkers import BaseChecker, utils
+from pylint.interfaces import HIGH
+
+if TYPE_CHECKING:
+    from pylint.lint import PyLinter
+
+EXIT_METHODS = frozenset(("__exit__", "__aexit__"))
+EXPECTED_ARGUMENT_NAMES = ("exc_type", "exc_value", "traceback")
+
+
+class ExitArgumentNamesChecker(BaseChecker):
+    """Checks that ``__exit__`` and ``__aexit__`` use the argument names of the
+    Python data model documentation.
+    """
+
+    name = "exit-argument-names"
+    msgs = {
+        "C3801": (
+            "Arguments of %s should be named '%s' instead of '%s'",
+            "non-standard-exit-argument-names",
+            "Used when the three arguments of a ``__exit__`` or ``__aexit__`` method "
+            "are not named ``exc_type, exc_value, traceback``, as in the Python data "
+            "model documentation. Arguments matching ``ignored-argument-names`` are "
+            "not checked.",
+        ),
+    }
+
+    @utils.only_required_for_messages("non-standard-exit-argument-names")
+    def visit_functiondef(self, node: nodes.FunctionDef) -> None:
+        if node.name not in EXIT_METHODS or not node.is_method():
+            return
+        if node.type != "method":
+            # staticmethod / classmethod: the arguments are shifted, skip them.
+            return
+        arguments = node.args
+        if arguments.vararg or arguments.kwarg:
+            return
+        positional = [*arguments.posonlyargs, *arguments.args]
+        if len(positional) != 4:
+            # Wrong arity is reported by unexpected-special-method-signature.
+            return
+        names = [arg.name for arg in positional[1:]]
+        ignored = self.linter.config.ignored_argument_names
+        if all(
+            name == expected or (ignored and ignored.match(name))
+            for name, expected in zip(names, EXPECTED_ARGUMENT_NAMES)
+        ):
+            return
+        self.add_message(
+            "non-standard-exit-argument-names",
+            node=node,
+            args=(
+                node.name,
+                ", ".join(EXPECTED_ARGUMENT_NAMES),
+                ", ".join(names),
+            ),
+            confidence=HIGH,
+        )
+
+    visit_asyncfunctiondef = visit_functiondef
+
+
+def register(linter: PyLinter) -> None:
+    linter.register_checker(ExitArgumentNamesChecker(linter))
diff --git a/tests/functional/ext/exit_argument_names/exit_argument_names.py b/tests/functional/ext/exit_argument_names/exit_argument_names.py
new file mode 100644
index 0000000..106d31d
--- /dev/null
+++ b/tests/functional/ext/exit_argument_names/exit_argument_names.py
@@ -0,0 +1,94 @@
+"""Tests for non-standard-exit-argument-names."""
+
+# pylint: disable=missing-class-docstring,missing-function-docstring,too-few-public-methods
+# pylint: disable=unused-argument,invalid-name,unexpected-special-method-signature
+# pylint: disable=redefined-outer-name
+
+
+class Good:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        return None
+
+
+class AsyncGood:
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc_value, traceback):
+        return None
+
+
+class ShortNames:
+    def __exit__(self, t, v, tb):  # [non-standard-exit-argument-names]
+        return None
+
+
+class AbbreviatedNames:
+    def __exit__(self, exc_type, exc_val, exc_tb):  # [non-standard-exit-argument-names]
+        return None
+
+
+class AsyncBadNames:
+    async def __aexit__(self, typ, value, tb):  # [non-standard-exit-argument-names]
+        return None
+
+
+class PositionalOnly:
+    def __exit__(self, t, v, tb, /):  # [non-standard-exit-argument-names]
+        return None
+
+
+class IgnoredNames:
+    def __exit__(self, _, __, ___):
+        return None
+
+
+class PartlyIgnored:
+    def __exit__(self, exc_type, _exc_value, tb):  # [non-standard-exit-argument-names]
+        return None
+
+
+class StarArgs:
+    def __exit__(self, *args):
+        return None
+
+
+class StarArgsAfterNames:
+    def __exit__(self, t, v, tb, *args, **kwargs):
+        return None
+
+
+class DefaultValues:
+    def __exit__(self, t=None, v=None, tb=None):  # [non-standard-exit-argument-names]
+        return None
+
+
+class WrongArity:
+    def __exit__(self, exc_type, exc_value):
+        return None
+
+
+class StaticExit:
+    @staticmethod
+    def __exit__(t, v, tb):
+        return None
+
+
+def __exit__(t, v, tb):
+    """Module-level function, not a context manager method."""
+
+
+class Outer:
+    def method(self):
+        def __exit__(t, v, tb):
+            return None
+
+        return __exit__
+
+
+class NotExit:
+    def __enter__(self, t, v, tb):
+        return self
