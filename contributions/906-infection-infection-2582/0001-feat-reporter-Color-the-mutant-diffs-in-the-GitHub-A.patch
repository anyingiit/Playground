diff --git a/src/Reporter/GitHubActionsLogTextFileReporter.php b/src/Reporter/GitHubActionsLogTextFileReporter.php
index 0653014..75f900d 100644
--- a/src/Reporter/GitHubActionsLogTextFileReporter.php
+++ b/src/Reporter/GitHubActionsLogTextFileReporter.php
@@ -35,14 +35,18 @@ declare(strict_types=1);
 
 namespace Infection\Reporter;
 
+use function explode;
+use function implode;
 use Infection\Mutant\MutantExecutionResult;
 use Override;
 use const PHP_EOL;
 use function sprintf;
+use function str_starts_with;
 use function trim;
 
 /**
  * Uses the GitHub Actions line grouping feature to make the output more digestable and collapsable.
+ * The mutant diffs are colored with ANSI escape sequences, which the GitHub Actions log viewer renders.
  *
  * @see https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-commands#grouping-log-lines
  *
@@ -50,6 +54,14 @@ use function trim;
  */
 final readonly class GitHubActionsLogTextFileReporter extends BaseTextFileReporter
 {
+    private const string ANSI_RED = "\e[31m";
+
+    private const string ANSI_GREEN = "\e[32m";
+
+    private const string ANSI_CYAN = "\e[36m";
+
+    private const string ANSI_RESET = "\e[0m";
+
     protected function getHeadlineLines(string $headlinePrefix): string
     {
         return '';
@@ -72,4 +84,39 @@ final readonly class GitHubActionsLogTextFileReporter extends BaseTextFileReport
 
         return sprintf('::group::%s mutants' . PHP_EOL . '%s' . PHP_EOL . '::endgroup::' . PHP_EOL, $headlinePrefix, $results);
     }
+
+    #[Override]
+    protected function formatDiff(string $diff): string
+    {
+        $lines = explode("\n", $diff);
+
+        // The lines before the first hunk ("--- Original", "+++ New") are the
+        // diff header: they start with "-" or "+" but are not changes.
+        $inHeader = true;
+
+        foreach ($lines as $index => $line) {
+            if (str_starts_with($line, '@@')) {
+                $inHeader = false;
+                $lines[$index] = self::ANSI_CYAN . $line . self::ANSI_RESET;
+
+                continue;
+            }
+
+            if ($inHeader) {
+                continue;
+            }
+
+            if (str_starts_with($line, '-')) {
+                $lines[$index] = self::ANSI_RED . $line . self::ANSI_RESET;
+
+                continue;
+            }
+
+            if (str_starts_with($line, '+')) {
+                $lines[$index] = self::ANSI_GREEN . $line . self::ANSI_RESET;
+            }
+        }
+
+        return implode("\n", $lines);
+    }
 }
