diff --git a/pyproject.toml b/pyproject.toml
index 160bac3..caa0b8f 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -149,6 +149,69 @@ exclude = [
 [tool.hatch.build.targets.wheel]
 packages = ["src/pyhf"]
 
+[tool.tbump]
+github_url = "https://github.com/scikit-hep/pyhf/"
+
+[tool.tbump.version]
+current = "0.7.6"
+
+# Example of a semver regexp.
+# Make sure this matches current_version before
+# using tbump
+regex = '''
+  (?P<major>\d+)
+  \.
+  (?P<minor>\d+)
+  \.
+  (?P<patch>\d+)
+  (rc
+    (?P<candidate>\d+)
+  )?
+  '''
+
+[tool.tbump.git]
+# The current version will get updated when tbump is run
+message_template = "Bump version: 0.7.6 → {new_version}"
+tag_template = "v{new_version}"
+
+# For each file to patch, add a [[tool.tbump.file]] config
+# section containing the path of the file, relative to the
+# pyproject.toml location.
+[[tool.tbump.file]]
+src = "pyproject.toml"
+# Restrict search to make it explicit why pyproject.toml
+# is even included as a file to bump, as it will get
+# its tool.tbump.version.current attribute bumped anyway.
+search = "Bump version: {current_version} → "
+
+[[tool.tbump.file]]
+src = "src/pyhf/utils.py"
+# Guard SCHEMA_VERSION
+# This search is just identifying the line to restrict the
+# regex to, but all matches in the line will get bumped.
+search = "pyhf: v{current_version}"
+
+[[tool.tbump.file]]
+src = "README.rst"
+
+[[tool.tbump.file]]
+src = "src/pyhf/data/citation.bib"
+
+[[tool.tbump.file]]
+src = ".zenodo.json"
+
+[[tool.tbump.file]]
+src = "CITATION.cff"
+
+[[tool.tbump.file]]
+src = "docs/jupyterlite/jupyterlite.py"
+
+[[tool.tbump.field]]
+# the name of the field
+name = "candidate"
+# the default value to use, if there is no match
+default = ""
+
 [tool.pytest.ini_options]
 minversion = "6.0"
 xfail_strict = true
