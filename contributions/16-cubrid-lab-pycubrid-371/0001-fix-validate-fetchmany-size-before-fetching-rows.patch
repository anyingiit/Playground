+    async def test_fetchmany_rejects_invalid_size(self, size: object) -> None:
+        """Regression for #371: async cursor rejects a bad ``size`` like the sync one."""
+        conn = MagicMock()
+        conn._timing = None
+        conn._cursors = set()
+        cur = AsyncCursor(conn)
+        cur._description = (("id", 1, None, None, 0, 0, False),)
+        cur._rows = [(1,), (2,), (3,)]
+        cur._row_index = 0
+        cur._query_handle = None
+        cur._total_tuple_count = 3
+
+        with pytest.raises(ProgrammingError, match="fetchmany size"):
+            await cur.fetchmany(size)  # type: ignore[arg-type]
+        assert await cur.fetchall() == [(1,), (2,), (3,)]
