diff --git a/pycubrid/_cursor_common.py b/pycubrid/_cursor_common.py
index 5caf51b..217c9af 100644
--- a/pycubrid/_cursor_common.py
+++ b/pycubrid/_cursor_common.py
@@ -35,6 +35,24 @@ DML_BATCH_VERBS = frozenset({"INSERT", "UPDATE", "DELETE", "MERGE"})
 _RE_LEADING_COMMENTS = re.compile(r"^(\s*(/\*.*?\*/|--[^\n]*(\n|$)|//[^\n]*(\n|$)))*\s*", re.DOTALL)
 
 
+# ---- fetch helpers ---------------------------------------------------------
+
+
+def validate_fetch_size(size: object) -> int:
+    """Validate the ``size`` argument of ``fetchmany()`` and return it.
+
+    Mirrors the ``arraysize`` setter: ``size`` must be an ``int`` >= 1.
+    Floats (even integral ones such as ``2.0``), strings, and ``bool`` are
+    rejected rather than coerced, and a zero or negative value is rejected
+    instead of silently returning no rows.
+    """
+    if isinstance(size, bool) or not isinstance(size, int):
+        raise ProgrammingError(f"fetchmany size must be an int, got {type(size).__name__}")
+    if size < 1:
+        raise ProgrammingError(f"fetchmany size must be greater than zero, got {size}")
+    return size
+
+
 # ---- SQL parsing -----------------------------------------------------------
 
 
