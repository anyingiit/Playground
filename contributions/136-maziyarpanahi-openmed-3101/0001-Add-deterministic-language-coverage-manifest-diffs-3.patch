@@ -0,0 +1,435 @@
+"""Deterministic diffs of clinical language-pack coverage manifests.
+
+Release review needs to see language capability regressions between two
+versioned coverage manifests without loading models, fixtures, or evaluation
+data. This module compares two caller-supplied manifests by canonical locale
+and reports, per locale, whether coverage was added, removed, improved,
+regressed, or otherwise changed.
+
+A coverage manifest is a JSON-compatible mapping::
+
+    {
+        "version": "3.3.0",
+        "entries": [
+            {
+                "locale": "pt-BR",
+                "script": "Latn",
+                "identifier_classes": ["cpf", "phone"],
+                "surrogate_support": "full",
+                "evidence_digest": "sha256:<64 lowercase hex characters>",
+            },
+        ],
+    }
+
+Only these keys are accepted, so a manifest cannot carry fixture text, model
+paths, or raw evaluation examples into the diff. Locales are normalized with
+:func:`openmed.core.locale_tag.normalize_locale_tag` (optionally with explicit
+aliases), and identifier classes are closed lowercase tokens. Entry order and
+identifier-class order never affect the result.
+
+The diff is purely structural: it does not run evaluation, decide release
+gates, or measure translation quality.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any, Final
+
+from .locale_tag import LocaleTagError, normalize_locale_tag
+
+__all__ = [
+    "ADDED",
+    "CHANGED",
+    "IMPROVED",
+    "REGRESSED",
+    "REMOVED",
+    "SURROGATE_SUPPORT_LEVELS",
+    "LanguageCoverageDiff",
+    "LanguageCoverageDiffEntry",
+    "LanguageCoverageDiffError",
+    "LanguageCoverageEntry",
+    "LanguageCoverageManifest",
+    "diff_language_coverage",
+    "parse_language_coverage_manifest",
+]
+
+# Entry statuses, in stable display order.
+ADDED: Final[str] = "added"
+REMOVED: Final[str] = "removed"
+IMPROVED: Final[str] = "improved"
+REGRESSED: Final[str] = "regressed"
+CHANGED: Final[str] = "changed"
+_STATUSES: Final[tuple[str, ...]] = (ADDED, REMOVED, IMPROVED, REGRESSED, CHANGED)
+
+# Ordered from weakest to strongest surrogate support.
+SURROGATE_SUPPORT_LEVELS: Final[tuple[str, ...]] = ("none", "partial", "full")
+
+_MANIFEST_KEYS: Final[frozenset[str]] = frozenset({"version", "entries"})
+_ENTRY_KEYS: Final[frozenset[str]] = frozenset(
+    {
+        "locale",
+        "script",
+        "identifier_classes",
+        "surrogate_support",
+        "evidence_digest",
+    }
+)
+_VERSION: Final[re.Pattern[str]] = re.compile(r"[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}\Z")
+_SCRIPT: Final[re.Pattern[str]] = re.compile(r"[A-Za-z]{4}\Z")
+_IDENTIFIER_CLASS: Final[re.Pattern[str]] = re.compile(r"[a-z][a-z0-9_]{0,63}\Z")
+_DIGEST: Final[re.Pattern[str]] = re.compile(r"sha256:[0-9a-f]{64}\Z")
+
+
+class LanguageCoverageDiffError(ValueError):
+    """Stable, value-free failure for coverage manifest validation.
+
+    The message and ``category`` are identical constant strings; rejected
+    values are never embedded so that malformed input cannot leak through
+    error text or logs.
+    """
+
+    def __init__(self, category: str) -> None:
+        self.category = category
+        super().__init__(category)
+
+
+@dataclass(frozen=True)
+class LanguageCoverageEntry:
+    """Validated coverage for one canonical locale."""
+
+    locale: str
+    script: str
+    identifier_classes: tuple[str, ...]
+    surrogate_support: str
+    evidence_digest: str
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a JSON-serializable representation of the entry."""
+        return {
+            "locale": self.locale,
+            "script": self.script,
+            "identifier_classes": list(self.identifier_classes),
+            "surrogate_support": self.surrogate_support,
+            "evidence_digest": self.evidence_digest,
+        }
+
+
+@dataclass(frozen=True)
+class LanguageCoverageManifest:
+    """Validated coverage manifest with entries sorted by canonical locale."""
+
+    version: str
+    entries: tuple[LanguageCoverageEntry, ...]
+
+    def by_locale(self) -> dict[str, LanguageCoverageEntry]:
+        """Return entries keyed by canonical locale."""
+        return {entry.locale: entry for entry in self.entries}
+
+
+@dataclass(frozen=True)
+class LanguageCoverageDiffEntry:
+    """Coverage difference for one canonical locale.
+
+    ``before`` is ``None`` for added locales and ``after`` is ``None`` for
+    removed locales. ``identifier_classes_added`` and
+    ``identifier_classes_removed`` are sorted.
+    """
+
+    locale: str
+    status: str
+    before: LanguageCoverageEntry | None
+    after: LanguageCoverageEntry | None
+    identifier_classes_added: tuple[str, ...] = ()
+    identifier_classes_removed: tuple[str, ...] = ()
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a JSON-serializable representation of the diff entry."""
+        result: dict[str, Any] = {"locale": self.locale, "status": self.status}
+        if self.before is not None and self.after is not None:
+            changes: dict[str, Any] = {}
+            if self.identifier_classes_added:
+                changes["identifier_classes_added"] = list(
+                    self.identifier_classes_added
+                )
+            if self.identifier_classes_removed:
+                changes["identifier_classes_removed"] = list(
+                    self.identifier_classes_removed
+                )
+            for field in ("script", "surrogate_support", "evidence_digest"):
+                before = getattr(self.before, field)
+                after = getattr(self.after, field)
+                if before != after:
+                    changes[field] = {"before": before, "after": after}
+            result["changes"] = changes
+        else:
+            snapshot = _snapshot(self).to_dict()
+            del snapshot["locale"]
+            result["coverage"] = snapshot
+        return result
+
+
+@dataclass(frozen=True)
+class LanguageCoverageDiff:
+    """Deterministic diff between two coverage manifests."""
+
+    before_version: str
+    after_version: str
+    entries: tuple[LanguageCoverageDiffEntry, ...]
+    unchanged: tuple[str, ...]
+
+    @property
+    def has_regressions(self) -> bool:
+        """Whether any locale was removed or regressed."""
+        return any(entry.status in (REMOVED, REGRESSED) for entry in self.entries)
+
+    def counts(self) -> dict[str, int]:
+        """Return entry counts per status, including ``unchanged``."""
+        counts = {status: 0 for status in _STATUSES}
+        for entry in self.entries:
+            counts[entry.status] += 1
+        counts["unchanged"] = len(self.unchanged)
+        return counts
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a JSON-serializable representation of the diff."""
+        return {
+            "before_version": self.before_version,
+            "after_version": self.after_version,
+            "counts": self.counts(),
+            "entries": [entry.to_dict() for entry in self.entries],
+            "unchanged": list(self.unchanged),
+        }
+
+    def to_json(self) -> str:
+        """Render byte-stable JSON with sorted keys and a trailing newline."""
+        return json.dumps(self.to_dict(), indent=2, sort_keys=True) + "\n"
+
+    def to_markdown(self) -> str:
+        """Render a byte-stable Markdown summary of the diff."""
+        counts = self.counts()
+        lines = [
+            "# Language coverage diff",
+            "",
+            f"- Before: `{self.before_version}`",
+            f"- After: `{self.after_version}`",
+            "",
+            "| Status | Count |",
+            "| --- | ---: |",
+        ]
+        for status in (*_STATUSES, "unchanged"):
+            lines.append(f"| {status} | {counts[status]} |")
+        lines.append("")
+        if not self.entries:
+            lines.append("No coverage changes.")
+            return "\n".join(lines) + "\n"
+        lines.extend(["| Locale | Status | Details |", "| --- | --- | --- |"])
+        for entry in self.entries:
+            lines.append(
+                f"| `{entry.locale}` | {entry.status} | {_markdown_details(entry)} |"
+            )
+        return "\n".join(lines) + "\n"
+
+
+def parse_language_coverage_manifest(
+    manifest: Mapping[str, Any], *, aliases: Mapping[str, str] | None = None
+) -> LanguageCoverageManifest:
+    """Validate a coverage manifest mapping and return its canonical form.
+
+    Args:
+        manifest: Mapping with ``version`` and ``entries`` keys only.
+        aliases: Optional explicit locale aliases passed to
+            :func:`openmed.core.locale_tag.normalize_locale_tag`.
+
+    Returns:
+        A manifest whose entries are sorted by canonical locale and whose
+        identifier classes are sorted and de-duplicated.
+
+    Raises:
+        LanguageCoverageDiffError: With a constant ``category`` when the
+            manifest is malformed, has unknown keys, or lists the same
+            canonical locale twice.
+    """
+    if not isinstance(manifest, Mapping):
+        raise LanguageCoverageDiffError("coverage_manifest_invalid")
+    if set(manifest) != _MANIFEST_KEYS:
+        raise LanguageCoverageDiffError("coverage_manifest_keys_invalid")
+    version = manifest["version"]
+    if not isinstance(version, str) or not _VERSION.fullmatch(version):
+        raise LanguageCoverageDiffError("coverage_manifest_version_invalid")
+    raw_entries = manifest["entries"]
+    if isinstance(raw_entries, (str, bytes, Mapping)) or not isinstance(
+        raw_entries, (list, tuple)
+    ):
+        raise LanguageCoverageDiffError("coverage_manifest_entries_invalid")
+    entries: dict[str, LanguageCoverageEntry] = {}
+    for raw_entry in raw_entries:
+        entry = _parse_entry(raw_entry, aliases)
+        if entry.locale in entries:
+            raise LanguageCoverageDiffError("coverage_locale_duplicate")
+        entries[entry.locale] = entry
+    return LanguageCoverageManifest(
+        version=version,
+        entries=tuple(entries[locale] for locale in sorted(entries)),
+    )
+
+
+def diff_language_coverage(
+    before: Mapping[str, Any] | LanguageCoverageManifest,
+    after: Mapping[str, Any] | LanguageCoverageManifest,
+    *,
+    aliases: Mapping[str, str] | None = None,
+) -> LanguageCoverageDiff:
+    """Compare two coverage manifests by canonical locale.
+
+    A locale present in both manifests is ``regressed`` when it lost any
+    identifier class or its surrogate support decreased, ``improved`` when it
+    only gained identifier classes or surrogate support, and ``changed`` when
+    only its script or evidence digest differs. Regressions take precedence
+    over improvements so that a mixed change is never hidden.
+
+    Args:
+        before: Earlier manifest mapping or parsed manifest.
+        after: Later manifest mapping or parsed manifest.
+        aliases: Optional explicit locale aliases applied to both mappings.
+
+    Returns:
+        A diff whose entries are sorted by canonical locale.
+    """
+    old = _coerce(before, aliases)
+    new = _coerce(after, aliases)
+    old_by_locale = old.by_locale()
+    new_by_locale = new.by_locale()
+    entries: list[LanguageCoverageDiffEntry] = []
+    unchanged: list[str] = []
+    for locale in sorted(set(old_by_locale) | set(new_by_locale)):
+        old_entry = old_by_locale.get(locale)
+        new_entry = new_by_locale.get(locale)
+        if old_entry is None:
+            entries.append(LanguageCoverageDiffEntry(locale, ADDED, None, new_entry))
+            continue
+        if new_entry is None:
+            entries.append(LanguageCoverageDiffEntry(locale, REMOVED, old_entry, None))
+            continue
+        if old_entry == new_entry:
+            unchanged.append(locale)
+            continue
+        gained = tuple(
+            sorted(
+                set(new_entry.identifier_classes) - set(old_entry.identifier_classes)
+            )
+        )
+        lost = tuple(
+            sorted(
+                set(old_entry.identifier_classes) - set(new_entry.identifier_classes)
+            )
+        )
+        support_delta = SURROGATE_SUPPORT_LEVELS.index(
+            new_entry.surrogate_support
+        ) - SURROGATE_SUPPORT_LEVELS.index(old_entry.surrogate_support)
+        if lost or support_delta < 0:
+            status = REGRESSED
+        elif gained or support_delta > 0:
+            status = IMPROVED
+        else:
+            status = CHANGED
+        entries.append(
+            LanguageCoverageDiffEntry(
+                locale,
+                status,
+                old_entry,
+                new_entry,
+                identifier_classes_added=gained,
+                identifier_classes_removed=lost,
+            )
+        )
+    return LanguageCoverageDiff(
+        before_version=old.version,
+        after_version=new.version,
+        entries=tuple(entries),
+        unchanged=tuple(unchanged),
+    )
+
+
+def _coerce(
+    manifest: Mapping[str, Any] | LanguageCoverageManifest,
+    aliases: Mapping[str, str] | None,
+) -> LanguageCoverageManifest:
+    if isinstance(manifest, LanguageCoverageManifest):
+        return manifest
+    return parse_language_coverage_manifest(manifest, aliases=aliases)
+
+
+def _parse_entry(raw: Any, aliases: Mapping[str, str] | None) -> LanguageCoverageEntry:
+    if not isinstance(raw, Mapping):
+        raise LanguageCoverageDiffError("coverage_entry_invalid")
+    if set(raw) != _ENTRY_KEYS:
+        raise LanguageCoverageDiffError("coverage_entry_keys_invalid")
+    locale = raw["locale"]
+    if not isinstance(locale, str):
+        raise LanguageCoverageDiffError("coverage_locale_invalid")
+    try:
+        canonical_locale = normalize_locale_tag(locale, aliases=aliases)
+    except LocaleTagError as exc:
+        raise LanguageCoverageDiffError("coverage_locale_invalid") from exc
+    script = raw["script"]
+    if not isinstance(script, str) or not _SCRIPT.fullmatch(script):
+        raise LanguageCoverageDiffError("coverage_script_invalid")
+    classes = raw["identifier_classes"]
+    if isinstance(classes, (str, bytes, Mapping)) or not isinstance(
+        classes, (list, tuple)
+    ):
+        raise LanguageCoverageDiffError("coverage_identifier_classes_invalid")
+    for item in classes:
+        if not isinstance(item, str) or not _IDENTIFIER_CLASS.fullmatch(item):
+            raise LanguageCoverageDiffError("coverage_identifier_classes_invalid")
+    if len(set(classes)) != len(classes):
+        raise LanguageCoverageDiffError("coverage_identifier_class_duplicate")
+    support = raw["surrogate_support"]
+    if support not in SURROGATE_SUPPORT_LEVELS:
+        raise LanguageCoverageDiffError("coverage_surrogate_support_invalid")
+    digest = raw["evidence_digest"]
+    if not isinstance(digest, str) or not _DIGEST.fullmatch(digest):
+        raise LanguageCoverageDiffError("coverage_evidence_digest_invalid")
+    return LanguageCoverageEntry(
+        locale=canonical_locale,
+        script=script.title(),
+        identifier_classes=tuple(sorted(classes)),
+        surrogate_support=support,
+        evidence_digest=digest,
+    )
+
+
+def _snapshot(entry: LanguageCoverageDiffEntry) -> LanguageCoverageEntry:
+    snapshot = entry.after if entry.after is not None else entry.before
+    if snapshot is None:  # pragma: no cover - construction invariant
+        raise LanguageCoverageDiffError("coverage_diff_entry_invalid")
+    return snapshot
+
+
+def _markdown_details(entry: LanguageCoverageDiffEntry) -> str:
+    if entry.before is None or entry.after is None:
+        snapshot = _snapshot(entry)
+        classes = ", ".join(snapshot.identifier_classes) or "none"
+        return (
+            f"script `{snapshot.script}`; identifiers: {classes}; "
+            f"surrogates: {snapshot.surrogate_support}"
+        )
+    details: list[str] = []
+    if entry.identifier_classes_added:
+        details.append("+identifiers: " + ", ".join(entry.identifier_classes_added))
+    if entry.identifier_classes_removed:
+        details.append("-identifiers: " + ", ".join(entry.identifier_classes_removed))
+    if entry.before.surrogate_support != entry.after.surrogate_support:
+        details.append(
+            f"surrogates: {entry.before.surrogate_support} -> "
+            f"{entry.after.surrogate_support}"
+        )
+    if entry.before.script != entry.after.script:
+        details.append(f"script: `{entry.before.script}` -> `{entry.after.script}`")
+    if entry.before.evidence_digest != entry.after.evidence_digest:
+        details.append("evidence digest changed")
+    return "; ".join(details)
