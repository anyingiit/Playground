diff --git a/tests/unit/core/test_language_coverage_diff.py b/tests/unit/core/test_language_coverage_diff.py
new file mode 100644
index 0000000..f060fd9
--- /dev/null
+++ b/tests/unit/core/test_language_coverage_diff.py
@@ -0,0 +1,363 @@
+"""Offline golden tests for language-pack coverage manifest diffs."""
+
+from __future__ import annotations
+
+import json
+from types import MappingProxyType
+
+import pytest
+
+from openmed.core.language_coverage_diff import (
+    LanguageCoverageDiffError,
+    diff_language_coverage,
+    parse_language_coverage_manifest,
+)
+
+DIGEST_A = "sha256:" + "a" * 64
+DIGEST_B = "sha256:" + "b" * 64
+
+
+def _entry(locale, script, classes, support, digest=DIGEST_A):
+    return {
+        "locale": locale,
+        "script": script,
+        "identifier_classes": list(classes),
+        "surrogate_support": support,
+        "evidence_digest": digest,
+    }
+
+
+def _manifest(version, *entries):
+    return {"version": version, "entries": list(entries)}
+
+
+BEFORE = _manifest(
+    "3.2.0",
+    _entry("pt-BR", "Latn", ["cpf", "phone"], "full"),
+    _entry("hi", "Deva", ["aadhaar"], "partial"),
+    _entry("de", "Latn", ["phone"], "full"),
+    _entry("fr", "Latn", ["nir"], "partial"),
+    _entry("ar", "Arab", ["phone"], "none"),
+)
+AFTER = _manifest(
+    "3.3.0",
+    _entry("pt-BR", "Latn", ["cpf"], "full"),
+    _entry("hi", "Deva", ["aadhaar", "pan"], "full"),
+    _entry("fr", "Latn", ["nir"], "partial", DIGEST_B),
+    _entry("ar", "Arab", ["phone"], "none"),
+    _entry("sw", "Latn", ["phone"], "partial"),
+)
+
+GOLDEN_MIXED_MARKDOWN = """\
+# Language coverage diff
+
+- Before: `3.2.0`
+- After: `3.3.0`
+
+| Status | Count |
+| --- | ---: |
+| added | 1 |
+| removed | 1 |
+| improved | 1 |
+| regressed | 1 |
+| changed | 1 |
+| unchanged | 1 |
+
+| Locale | Status | Details |
+| --- | --- | --- |
+| `de` | removed | script `Latn`; identifiers: phone; surrogates: full |
+| `fr` | changed | evidence digest changed |
+| `hi` | improved | +identifiers: pan; surrogates: partial -> full |
+| `pt-BR` | regressed | -identifiers: phone |
+| `sw` | added | script `Latn`; identifiers: phone; surrogates: partial |
+"""
+
+GOLDEN_MIXED_DICT = {
+    "after_version": "3.3.0",
+    "before_version": "3.2.0",
+    "counts": {
+        "added": 1,
+        "changed": 1,
+        "improved": 1,
+        "regressed": 1,
+        "removed": 1,
+        "unchanged": 1,
+    },
+    "entries": [
+        {
+            "coverage": {
+                "evidence_digest": DIGEST_A,
+                "identifier_classes": ["phone"],
+                "script": "Latn",
+                "surrogate_support": "full",
+            },
+            "locale": "de",
+            "status": "removed",
+        },
+        {
+            "changes": {
+                "evidence_digest": {"after": DIGEST_B, "before": DIGEST_A},
+            },
+            "locale": "fr",
+            "status": "changed",
+        },
+        {
+            "changes": {
+                "identifier_classes_added": ["pan"],
+                "surrogate_support": {"after": "full", "before": "partial"},
+            },
+            "locale": "hi",
+            "status": "improved",
+        },
+        {
+            "changes": {"identifier_classes_removed": ["phone"]},
+            "locale": "pt-BR",
+            "status": "regressed",
+        },
+        {
+            "coverage": {
+                "evidence_digest": DIGEST_A,
+                "identifier_classes": ["phone"],
+                "script": "Latn",
+                "surrogate_support": "partial",
+            },
+            "locale": "sw",
+            "status": "added",
+        },
+    ],
+    "unchanged": ["ar"],
+}
+
+GOLDEN_EQUAL_MARKDOWN = """\
+# Language coverage diff
+
+- Before: `3.2.0`
+- After: `3.2.1`
+
+| Status | Count |
+| --- | ---: |
+| added | 0 |
+| removed | 0 |
+| improved | 0 |
+| regressed | 0 |
+| changed | 0 |
+| unchanged | 5 |
+
+No coverage changes.
+"""
+
+
+def test_mixed_manifests_have_stable_golden_json_and_markdown() -> None:
+    diff = diff_language_coverage(BEFORE, AFTER)
+
+    assert diff.to_dict() == GOLDEN_MIXED_DICT
+    assert diff.to_json() == (
+        json.dumps(GOLDEN_MIXED_DICT, indent=2, sort_keys=True) + "\n"
+    )
+    assert diff.to_markdown() == GOLDEN_MIXED_MARKDOWN
+    assert diff.has_regressions
+
+
+def test_equal_manifests_report_no_changes() -> None:
+    after = dict(BEFORE, version="3.2.1")
+    diff = diff_language_coverage(BEFORE, after)
+
+    assert diff.entries == ()
+    assert diff.unchanged == ("ar", "de", "fr", "hi", "pt-BR")
+    assert not diff.has_regressions
+    assert diff.to_markdown() == GOLDEN_EQUAL_MARKDOWN
+
+
+def test_added_only_and_removed_only_manifests() -> None:
+    empty = _manifest("0.1.0")
+    added = diff_language_coverage(empty, BEFORE)
+    removed = diff_language_coverage(BEFORE, empty)
+
+    assert [(e.locale, e.status) for e in added.entries] == [
+        ("ar", "added"),
+        ("de", "added"),
+        ("fr", "added"),
+        ("hi", "added"),
+        ("pt-BR", "added"),
+    ]
+    assert not added.has_regressions
+    assert [e.status for e in removed.entries] == ["removed"] * 5
+    assert removed.has_regressions
+    assert removed.counts()["removed"] == 5
+
+
+def test_reordered_manifests_are_byte_identical() -> None:
+    reordered_before = _manifest(
+        BEFORE["version"],
+        *[
+            dict(entry, identifier_classes=entry["identifier_classes"][::-1])
+            for entry in reversed(BEFORE["entries"])
+        ],
+    )
+    reordered_after = _manifest(AFTER["version"], *reversed(AFTER["entries"]))
+
+    reordered = diff_language_coverage(reordered_before, reordered_after)
+    baseline = diff_language_coverage(BEFORE, AFTER)
+
+    assert reordered.to_json() == baseline.to_json()
+    assert reordered.to_markdown() == GOLDEN_MIXED_MARKDOWN
+    assert diff_language_coverage(BEFORE, reordered_before).entries == ()
+
+
+def test_alias_and_case_variant_locales_match_canonical_entries() -> None:
+    aliases = MappingProxyType({"pt_BR": "pt-BR", "iw": "he"})
+    before = _manifest(
+        "1.0.0",
+        _entry("pt_BR", "latn", ["cpf"], "full"),
+        _entry("iw", "Hebr", ["teudat_zehut"], "partial"),
+    )
+    after = _manifest(
+        "1.1.0",
+        _entry("PT-br", "Latn", ["cpf"], "full"),
+        _entry("he", "Hebr", ["teudat_zehut"], "full"),
+    )
+
+    diff = diff_language_coverage(before, after, aliases=aliases)
+
+    assert diff.unchanged == ("pt-BR",)
+    assert [(e.locale, e.status) for e in diff.entries] == [("he", "improved")]
+    assert diff.to_markdown().endswith(
+        "| `he` | improved | surrogates: partial -> full |\n"
+    )
+    assert dict(aliases) == {"pt_BR": "pt-BR", "iw": "he"}
+
+
+def test_regression_takes_precedence_over_mixed_improvements() -> None:
+    before = _manifest("1", _entry("es", "Latn", ["dni"], "full"))
+    after = _manifest("2", _entry("es", "Latn", ["dni", "nie"], "partial"))
+
+    (entry,) = diff_language_coverage(before, after).entries
+
+    assert entry.status == "regressed"
+    assert entry.identifier_classes_added == ("nie",)
+    assert entry.to_dict()["changes"]["surrogate_support"] == {
+        "before": "full",
+        "after": "partial",
+    }
+
+
+def test_script_only_change_is_reported_as_changed() -> None:
+    before = _manifest("1", _entry("sr", "Cyrl", ["jmbg"], "full"))
+    after = _manifest("2", _entry("sr", "Latn", ["jmbg"], "full"))
+
+    (entry,) = diff_language_coverage(before, after).entries
+
+    assert entry.status == "changed"
+    assert entry.to_dict()["changes"] == {"script": {"before": "Cyrl", "after": "Latn"}}
+
+
+def test_parsed_manifests_are_accepted_and_sorted() -> None:
+    parsed = parse_language_coverage_manifest(AFTER)
+
+    assert [entry.locale for entry in parsed.entries] == [
+        "ar",
+        "fr",
+        "hi",
+        "pt-BR",
+        "sw",
+    ]
+    assert parsed.by_locale()["hi"].identifier_classes == ("aadhaar", "pan")
+    assert diff_language_coverage(BEFORE, parsed) == diff_language_coverage(
+        BEFORE, AFTER
+    )
+
+
+@pytest.mark.parametrize(
+    "manifest,category",
+    [
+        (["not", "a", "mapping"], "coverage_manifest_invalid"),
+        ({"version": "1"}, "coverage_manifest_keys_invalid"),
+        (
+            {"version": "1", "entries": [], "model_path": "/models/x"},
+            "coverage_manifest_keys_invalid",
+        ),
+        ({"version": "", "entries": []}, "coverage_manifest_version_invalid"),
+        ({"version": "1/../x", "entries": []}, "coverage_manifest_version_invalid"),
+        ({"version": "1", "entries": "en"}, "coverage_manifest_entries_invalid"),
+        (_manifest("1", "en"), "coverage_entry_invalid"),
+        (
+            _manifest("1", dict(_entry("en", "Latn", [], "none"), example="John")),
+            "coverage_entry_keys_invalid",
+        ),
+        (
+            _manifest("1", _entry("not a locale", "Latn", [], "none")),
+            "coverage_locale_invalid",
+        ),
+        (_manifest("1", _entry("en", "Latin", [], "none")), "coverage_script_invalid"),
+        (
+            _manifest("1", _entry("en", "Latn", ["Patient John"], "none")),
+            "coverage_identifier_classes_invalid",
+        ),
+        (
+            _manifest("1", _entry("en", "Latn", ["ssn", "ssn"], "none")),
+            "coverage_identifier_class_duplicate",
+        ),
+        (
+            _manifest("1", _entry("en", "Latn", [], "complete")),
+            "coverage_surrogate_support_invalid",
+        ),
+        (
+            _manifest("1", _entry("en", "Latn", [], "none", "sha256:ABC")),
+            "coverage_evidence_digest_invalid",
+        ),
+        (
+            _manifest(
+                "1",
+                _entry("en-us", "Latn", [], "none"),
+                _entry("EN-US", "Latn", [], "none"),
+            ),
+            "coverage_locale_duplicate",
+        ),
+    ],
+)
+def test_malformed_manifests_fail_with_value_free_categories(
+    manifest, category
+) -> None:
+    with pytest.raises(LanguageCoverageDiffError) as excinfo:
+        parse_language_coverage_manifest(manifest)
+
+    assert excinfo.value.category == category
+    assert str(excinfo.value) == category
+
+
+def test_diff_output_contains_only_coverage_metadata() -> None:
+    rendered = diff_language_coverage(BEFORE, AFTER).to_json()
+    payload = json.loads(rendered)
+
+    allowed_keys = {
+        "after",
+        "after_version",
+        "before",
+        "before_version",
+        "changes",
+        "counts",
+        "coverage",
+        "entries",
+        "evidence_digest",
+        "identifier_classes",
+        "identifier_classes_added",
+        "identifier_classes_removed",
+        "locale",
+        "script",
+        "status",
+        "surrogate_support",
+        "unchanged",
+        *("added", "changed", "improved", "regressed", "removed"),
+    }
+
+    def keys(value):
+        if isinstance(value, dict):
+            for key, item in value.items():
+                yield key
+                yield from keys(item)
+        elif isinstance(value, list):
+            for item in value:
+                yield from keys(item)
+
+    assert set(keys(payload)) <= allowed_keys
+    assert "/" not in rendered
