diff --git a/tests/test_config_only_commands_see_registered_kbs.py b/tests/test_config_only_commands_see_registered_kbs.py
new file mode 100644
index 0000000..af8bcfd
--- /dev/null
+++ b/tests/test_config_only_commands_see_registered_kbs.py
@@ -0,0 +1,210 @@
+"""A KB added with `pyrite kb add` is visible to the config-only commands (#363).
+
+`kb add` registers a KB in the index database. `get`, `index sync`, `link` and
+the task commands merge that registry into the config before use, but
+`search`, `kb validate`, `kb schema ...` and `schema validate` built their
+config with a bare `load_config()`, which knows only config.yaml. They answered
+KB_NOT_FOUND for a KB that `kb list`, `get` and `index sync` all accept.
+
+Each test patches the `load_config` name the command reads with a config that
+lists no KBs, and registers the KB only in the database, which is the state
+`pyrite kb add` leaves behind.
+"""
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+from typer.testing import CliRunner
+
+from pyrite.cli import app
+from pyrite.config import KBConfig, PyriteConfig, Settings
+from pyrite.storage.database import PyriteDB
+
+runner = CliRunner()
+
+KB_NAME = "reg-kb"
+
+
+@pytest.fixture
+def registered_kb(tmp_path: Path):
+    """A config.yaml with no KBs, plus one KB registered only in the database."""
+    kb_path = tmp_path / KB_NAME
+    kb_path.mkdir()
+    (kb_path / "kb.yaml").write_text(
+        f"name: {KB_NAME}\nkb_type: generic\ntypes:\n  note:\n    description: A note\n",
+        encoding="utf-8",
+    )
+    (kb_path / "hello.md").write_text(
+        "---\nid: hello\ntitle: Hello\ntype: note\n---\n\nhello world\n", encoding="utf-8"
+    )
+
+    db_path = tmp_path / "index.db"
+    db = PyriteDB(db_path)
+    try:
+        db.register_kb(name=KB_NAME, kb_type="generic", path=str(kb_path), description="")
+    finally:
+        db.close()
+
+    config = PyriteConfig(knowledge_bases=[], settings=Settings(index_path=db_path))
+    return config, kb_path
+
+
+def _invoke(target: str, config: PyriteConfig, args: list[str]):
+    with patch(target, return_value=config):
+        return runner.invoke(app, args)
+
+
+def _kb_commands(config, args):
+    return _invoke("pyrite.cli.kb_commands.load_config", config, args)
+
+
+def test_search_scoped_to_a_registered_kb(registered_kb):
+    config, _ = registered_kb
+
+    result = _invoke(
+        "pyrite.cli.search_commands.load_config",
+        config,
+        ["search", "hello", "-k", KB_NAME, "--format", "json"],
+    )
+
+    assert result.exit_code == 0, result.output
+    assert "KB_NOT_FOUND" not in result.output
+    assert "hello" in result.output
+
+
+def test_search_files_scoped_to_a_registered_kb(registered_kb):
+    config, _ = registered_kb
+
+    result = _invoke(
+        "pyrite.cli.search_commands.load_config",
+        config,
+        ["search", "hello", "-k", KB_NAME, "--files"],
+    )
+
+    assert result.exit_code == 0, result.output
+    assert "not found" not in result.output
+    assert "Search Results (1)" in result.output
+
+
+def test_search_files_across_all_kbs_includes_registered_kbs(registered_kb):
+    config, _ = registered_kb
+
+    result = _invoke(
+        "pyrite.cli.search_commands.load_config", config, ["search", "hello", "--files"]
+    )
+
+    assert result.exit_code == 0, result.output
+    assert "No knowledge bases configured" not in result.output
+    assert "Search Results (1)" in result.output
+
+
+def test_kb_validate_a_registered_kb(registered_kb):
+    config, _ = registered_kb
+
+    result = _kb_commands(config, ["kb", "validate", KB_NAME, "--format", "json"])
+
+    assert "KB_NOT_FOUND" not in result.output
+    assert result.exit_code == 0, result.output
+    data = json.loads(result.output)
+    assert [kb["name"] for kb in data["kbs"]] == [KB_NAME]
+
+
+def test_kb_validate_without_a_name_includes_registered_kbs(registered_kb):
+    config, _ = registered_kb
+
+    result = _kb_commands(config, ["kb", "validate", "--format", "json"])
+
+    assert result.exit_code == 0, result.output
+    data = json.loads(result.output)
+    assert KB_NAME in [kb["name"] for kb in data["kbs"]]
+
+
+def test_kb_schema_show_a_registered_kb(registered_kb):
+    config, _ = registered_kb
+
+    result = _kb_commands(config, ["kb", "schema", "show", KB_NAME, "--format", "json"])
+
+    assert result.exit_code == 0, result.output
+    assert "KB_NOT_FOUND" not in result.output
+    assert "note" in json.loads(result.output)["types"]
+
+
+def test_kb_schema_add_and_remove_type_on_a_registered_kb(registered_kb):
+    config, kb_path = registered_kb
+
+    added = _kb_commands(
+        config,
+        ["kb", "schema", "add-type", KB_NAME, "--type", "memo", "--format", "json"],
+    )
+    assert added.exit_code == 0, added.output
+    assert "memo" in (kb_path / "kb.yaml").read_text(encoding="utf-8")
+
+    removed = _kb_commands(
+        config,
+        ["kb", "schema", "remove-type", KB_NAME, "--type", "memo", "--format", "json"],
+    )
+    assert removed.exit_code == 0, removed.output
+    assert "memo" not in (kb_path / "kb.yaml").read_text(encoding="utf-8")
+
+
+def test_kb_schema_set_on_a_registered_kb(registered_kb, tmp_path):
+    config, kb_path = registered_kb
+    schema_file = tmp_path / "schema.yaml"
+    schema_file.write_text("types:\n  memo:\n    description: A memo\n", encoding="utf-8")
+
+    result = _kb_commands(
+        config,
+        ["kb", "schema", "set", KB_NAME, "--schema-file", str(schema_file), "--format", "json"],
+    )
+
+    assert result.exit_code == 0, result.output
+    assert "memo" in (kb_path / "kb.yaml").read_text(encoding="utf-8")
+
+
+def test_schema_validate_a_registered_kb(registered_kb):
+    config, _ = registered_kb
+
+    # schema validate imports load_config from pyrite.config inside the command.
+    result = _invoke("pyrite.config.load_config", config, ["schema", "validate", "-k", KB_NAME])
+
+    assert "KB_NOT_FOUND" not in result.output
+    assert result.exit_code == 0, result.output
+
+
+def test_a_config_yaml_kb_wins_over_a_registered_kb_of_the_same_name(registered_kb, tmp_path):
+    _, _ = registered_kb
+    yaml_kb_path = tmp_path / "from-config-yaml"
+    yaml_kb_path.mkdir()
+    (yaml_kb_path / "kb.yaml").write_text(
+        f"name: {KB_NAME}\nkb_type: generic\ntypes:\n  memo:\n    description: A memo\n",
+        encoding="utf-8",
+    )
+    config = PyriteConfig(
+        knowledge_bases=[KBConfig(name=KB_NAME, path=yaml_kb_path, kb_type="generic")],
+        settings=Settings(index_path=tmp_path / "index.db"),
+    )
+
+    result = _kb_commands(config, ["kb", "schema", "show", KB_NAME, "--format", "json"])
+
+    assert result.exit_code == 0, result.output
+    types = json.loads(result.output)["types"]
+    assert "memo" in types
+    assert "note" not in types
+
+
+def test_an_unknown_kb_still_reports_kb_not_found(registered_kb):
+    config, _ = registered_kb
+
+    search = _invoke(
+        "pyrite.cli.search_commands.load_config",
+        config,
+        ["search", "hello", "-k", "nope", "--format", "json"],
+    )
+    validate = _kb_commands(config, ["kb", "validate", "nope", "--format", "json"])
+    schema_show = _kb_commands(config, ["kb", "schema", "show", "nope", "--format", "json"])
+
+    for result in (search, validate, schema_show):
+        assert result.exit_code != 0
+        assert "KB_NOT_FOUND" in result.output
