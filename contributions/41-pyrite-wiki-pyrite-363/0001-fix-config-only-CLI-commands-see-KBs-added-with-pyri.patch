diff --git a/pyrite/cli/context.py b/pyrite/cli/context.py
index 9a6ff7f..f8569e8 100644
--- a/pyrite/cli/context.py
+++ b/pyrite/cli/context.py
@@ -59,6 +59,27 @@ def cli_db_context() -> Generator[tuple[PyriteConfig, PyriteDB], None, None]:
         db.close()
 
 
+def with_registered_kbs(config: PyriteConfig) -> PyriteConfig:
+    """Merge DB-registered KBs (added via ``pyrite kb add``) into ``config``.
+
+    For commands that need only the config, not a db or service: they load it
+    with ``load_config()``, which knows only the KBs in ``config.yaml``, and
+    pass it through here so a KB added with ``pyrite kb add`` resolves the same
+    way it does for ``get``, ``index sync`` and the other commands built on
+    ``_init_base()`` (#363). config.yaml KBs keep precedence on a name clash.
+
+    The index database is opened only for the merge and closed again.
+    Returns ``config`` (mutated in place) so callers can write
+    ``config = with_registered_kbs(load_config())``.
+    """
+    db = PyriteDB(config.settings.index_path)
+    try:
+        db.merge_registered_kbs(config)
+    finally:
+        db.close()
+    return config
+
+
 def get_config_and_db() -> tuple[PyriteConfig, PyriteDB]:
     """Get config and db without a context manager.
 
