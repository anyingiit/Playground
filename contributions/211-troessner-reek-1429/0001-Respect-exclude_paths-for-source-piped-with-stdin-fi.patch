From 32262b8a50cbd87b3ab12ad8297807a837c61e3f Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:45:05 +0000
Subject: [PATCH] Respect exclude_paths for source piped with --stdin-filename

When source code is piped in and --stdin-filename is given, check the
filename against the configured exclude_paths (honouring
--force-exclusion) in the same way as for files passed on the command
line. Previously the exclusion configuration was ignored for piped input.

Fixes #1429
---
 features/command_line_interface/stdin.feature | 35 +++++++++++++++++++
 lib/reek/cli/application.rb                   |  6 +++-
 lib/reek/source/source_locator.rb             | 32 ++++++++++-------
 spec/reek/source/source_locator_spec.rb       | 31 ++++++++++++++++
 4 files changed, 90 insertions(+), 14 deletions(-)

diff --git a/features/command_line_interface/stdin.feature b/features/command_line_interface/stdin.feature
index a576e7d..af415eb 100644
--- a/features/command_line_interface/stdin.feature
+++ b/features/command_line_interface/stdin.feature
@@ -63,3 +63,38 @@ Feature: Reek reads from $stdin when no files are given
       """
     Then it succeeds
     And it reports nothing
+
+  Scenario: providing a filename that is excluded in the configuration
+    Given an empty file named "db/migrate/create_foos.rb"
+    And a file named "config.reek" with:
+      """
+      ---
+      exclude_paths:
+        - db/migrate/create_foos.rb
+      """
+    When I pass a stdin to reek --config config.reek --stdin-filename db/migrate/create_foos.rb with:
+      """
+      class Turn; def y() @x = 3; end end
+      """
+    Then it succeeds
+    And it reports nothing
+
+  Scenario: providing a filename within an excluded directory
+    Given an empty file named "db/migrate/create_foos.rb"
+    And a file named "config.reek" with:
+      """
+      ---
+      exclude_paths:
+        - db/migrate
+      """
+    When I pass a stdin to reek --config config.reek --stdin-filename db/migrate/create_foos.rb with:
+      """
+      class Turn; def y() @x = 3; end end
+      """
+    Then the exit status indicates smells
+    When I pass a stdin to reek --config config.reek --force-exclusion --stdin-filename db/migrate/create_foos.rb with:
+      """
+      class Turn; def y() @x = 3; end end
+      """
+    Then it succeeds
+    And it reports nothing
diff --git a/lib/reek/cli/application.rb b/lib/reek/cli/application.rb
index 18899af..8443163 100644
--- a/lib/reek/cli/application.rb
+++ b/lib/reek/cli/application.rb
@@ -114,7 +114,11 @@ module Reek
       end
 
       def source_from_pipe
-        [Source::SourceCode.from($stdin, origin: options.stdin_filename)]
+        stdin_filename = options.stdin_filename
+        locator = Source::SourceLocator.new([], configuration: configuration, options: options)
+        return [] if stdin_filename && locator.excluded_file?(Pathname.new(stdin_filename))
+
+        [Source::SourceCode.from($stdin, origin: stdin_filename)]
       end
 
       def disable_progress_output_unless_verbose
diff --git a/lib/reek/source/source_locator.rb b/lib/reek/source/source_locator.rb
index 6434966..7dff878 100644
--- a/lib/reek/source/source_locator.rb
+++ b/lib/reek/source/source_locator.rb
@@ -29,6 +29,24 @@ module Reek
         source_paths
       end
 
+      # Checks whether the given file is excluded through the configuration.
+      # With the force_exclusion option, a file is also excluded when any of
+      # its parent directories is excluded.
+      #
+      # @param path [Pathname] path of the file to check
+      # @return [Boolean]
+      def excluded_file?(path)
+        if options.force_exclusion?
+          path.ascend do |ascendant|
+            break true if path_excluded?(ascendant)
+
+            false
+          end
+        else
+          path_excluded?(path)
+        end
+      end
+
       private
 
       attr_reader :configuration, :paths, :options
@@ -49,24 +67,12 @@ module Reek
           if path.directory?
             Find.prune if ignore_path?(path)
           elsif ruby_file?(path)
-            relevant_paths << path unless ignore_file?(path)
+            relevant_paths << path unless excluded_file?(path)
           end
         end
         relevant_paths
       end
 
-      def ignore_file?(path)
-        if options.force_exclusion?
-          path.ascend do |ascendant|
-            break true if path_excluded?(ascendant)
-
-            false
-          end
-        else
-          path_excluded?(path)
-        end
-      end
-
       def path_excluded?(path)
         configuration.path_excluded?(path)
       end
diff --git a/spec/reek/source/source_locator_spec.rb b/spec/reek/source/source_locator_spec.rb
index 3faa191..8e015fe 100644
--- a/spec/reek/source/source_locator_spec.rb
+++ b/spec/reek/source/source_locator_spec.rb
@@ -165,4 +165,35 @@ RSpec.describe Reek::Source::SourceLocator do
       end
     end
   end
+
+  describe '#excluded_file?' do
+    let(:configuration) do
+      test_configuration_for(CONFIGURATION_DIR.join('with_excluded_paths.reek'))
+    end
+
+    let(:options) { instance_double(Reek::CLI::Options, force_exclusion?: false) }
+    let(:locator) { described_class.new([], configuration: configuration, options: options) }
+
+    context 'when the file does not exist, but is in an excluded directory' do
+      let(:path) { SAMPLES_DIR.join('source_with_exclude_paths', 'ignore_me', 'not_on_disk.rb') }
+
+      it 'excludes the file when options.force_exclusion? is true' do
+        allow(options).to receive(:force_exclusion?).and_return(true)
+        expect(locator).to be_excluded_file(path)
+      end
+
+      it 'does not exclude the file when options.force_exclusion? is false' do
+        expect(locator).not_to be_excluded_file(path)
+      end
+    end
+
+    context 'when the file is not in an excluded directory' do
+      let(:path) { SAMPLES_DIR.join('source_with_exclude_paths', 'not_on_disk.rb') }
+
+      it 'does not exclude the file' do
+        allow(options).to receive(:force_exclusion?).and_return(true)
+        expect(locator).not_to be_excluded_file(path)
+      end
+    end
+  end
 end
-- 
