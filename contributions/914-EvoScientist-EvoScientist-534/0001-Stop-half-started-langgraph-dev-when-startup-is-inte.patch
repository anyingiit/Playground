From 0873cc6ecb4fb5846fb332cc10e7649b25e9e72c Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 21:41:44 +0000
Subject: [PATCH] Stop half-started langgraph dev when startup is interrupted
 (#534)

start_langgraph_dev() spawns the server in its own session / process
group, so a Ctrl+C in the terminal only reaches the CLI. The health
wait loop had no cleanup of its own and the caller's atexit/signal
handlers are registered only after startup returns, so interrupting
before the ready banner left the server, its PID file and the
workspace sidecar behind.

Wrap everything after Popen (PID/sidecar writes and the health wait)
in try/except BaseException that calls stop_langgraph_dev(proc) and
re-raises. The early-exit and timeout paths now go through the same
cleanup instead of calling it inline.

Closes #534
---
 EvoScientist/langgraph_dev/manager.py | 105 ++++++++++++++------------
 tests/test_langgraph_manager.py       |  81 ++++++++++++++++++++
 2 files changed, 139 insertions(+), 47 deletions(-)

diff --git a/EvoScientist/langgraph_dev/manager.py b/EvoScientist/langgraph_dev/manager.py
index c52c7e1..2637708 100644
--- a/EvoScientist/langgraph_dev/manager.py
+++ b/EvoScientist/langgraph_dev/manager.py
@@ -1128,54 +1128,65 @@ def start_langgraph_dev(
             log_handle.close()
         except Exception:
             pass
-    RUNTIME.pid_file.write_text(str(proc.pid), encoding="utf-8")
-    _write_workspace_sidecar(
-        workspace_dir=workspace_dir,
-        pid=proc.pid,
-        config_fingerprint=config_fingerprint,
-        deploy_mode=deploy_mode,
-    )
-    global _PROCESS_WORKSPACE, _PROCESS_DEPLOY_MODE
-    _PROCESS = proc
-    _PROCESS_WORKSPACE = workspace_dir
-    _PROCESS_DEPLOY_MODE = deploy_mode
-
-    # langgraph dev cold-starts in ~10-15s normally; first-time npx-based MCP
-    # servers can push this to 30-60s while npm fetches packages, so the budget
-    # is generous. Subsequent runs are much faster thanks to npm cache.
-    deadline = time.monotonic() + 60
-    while time.monotonic() < deadline:
-        if proc.poll() is not None:
-            tail = ""
-            try:
-                tail = RUNTIME.log_file.read_text(encoding="utf-8", errors="replace")[
-                    -2000:
-                ]
-            except Exception:
-                pass
-            # Subprocess died on its own — clear our module-level bookkeeping
-            # (``_PROCESS``, ``_PROCESS_WORKSPACE``, ``RUNTIME.pid_file``) before
-            # raising. Without this, ``_PROCESS`` would keep pointing at the
-            # dead handle and ``RUNTIME.pid_file`` at a non-existent PID, leading
-            # the next ``ensure_langgraph_dev`` to misjudge state. Pass
-            # ``proc`` directly so ``stop_langgraph_dev`` works against the
-            # one we just spawned even if the global state was overwritten.
-            stop_langgraph_dev(proc)
-            raise RuntimeError(
-                f"langgraph dev exited immediately with code {proc.returncode}.\n"
-                f"Log tail:\n{tail}"
-            )
-        if is_langgraph_dev_running(port=port, host=host):
-            logger.info(
-                "langgraph dev started on %s (pid=%d)", _base_url(port, host), proc.pid
-            )
-            return proc
-        time.sleep(0.5)
+    # Everything from here until the server is healthy runs with the child
+    # already spawned in its own session/process group, so a terminal Ctrl+C
+    # only reaches this CLI — and the caller's atexit / signal cleanup is not
+    # registered yet. Stop the half-started server on *any* exit path
+    # (KeyboardInterrupt included) so it does not keep the port, PID file and
+    # workspace sidecar alive in the background (#534).
+    try:
+        RUNTIME.pid_file.write_text(str(proc.pid), encoding="utf-8")
+        _write_workspace_sidecar(
+            workspace_dir=workspace_dir,
+            pid=proc.pid,
+            config_fingerprint=config_fingerprint,
+            deploy_mode=deploy_mode,
+        )
+        global _PROCESS_WORKSPACE, _PROCESS_DEPLOY_MODE
+        _PROCESS = proc
+        _PROCESS_WORKSPACE = workspace_dir
+        _PROCESS_DEPLOY_MODE = deploy_mode
+
+        # langgraph dev cold-starts in ~10-15s normally; first-time npx-based
+        # MCP servers can push this to 30-60s while npm fetches packages, so
+        # the budget is generous. Subsequent runs are much faster thanks to
+        # npm cache.
+        deadline = time.monotonic() + 60
+        while time.monotonic() < deadline:
+            if proc.poll() is not None:
+                tail = ""
+                try:
+                    tail = RUNTIME.log_file.read_text(
+                        encoding="utf-8", errors="replace"
+                    )[-2000:]
+                except Exception:
+                    pass
+                # Subprocess died on its own. The ``except`` below clears our
+                # module-level bookkeeping (``_PROCESS``, ``_PROCESS_WORKSPACE``,
+                # ``RUNTIME.pid_file``) via ``stop_langgraph_dev(proc)`` before
+                # the error propagates, so the next ``ensure_langgraph_dev``
+                # does not misjudge state.
+                raise RuntimeError(
+                    f"langgraph dev exited immediately with code {proc.returncode}.\n"
+                    f"Log tail:\n{tail}"
+                )
+            if is_langgraph_dev_running(port=port, host=host):
+                logger.info(
+                    "langgraph dev started on %s (pid=%d)",
+                    _base_url(port, host),
+                    proc.pid,
+                )
+                return proc
+            time.sleep(0.5)
 
-    stop_langgraph_dev(proc)
-    raise RuntimeError(
-        f"langgraph dev did not become healthy within 60 seconds. Check {RUNTIME.log_file}"
-    )
+        raise RuntimeError(
+            f"langgraph dev did not become healthy within 60 seconds. Check {RUNTIME.log_file}"
+        )
+    except BaseException:
+        # Pass ``proc`` directly so ``stop_langgraph_dev`` targets the one we
+        # just spawned even if the global state was never set or overwritten.
+        stop_langgraph_dev(proc)
+        raise
 
 
 def read_tunnel_url(timeout: float = 35.0, poll_interval: float = 0.5) -> str | None:
diff --git a/tests/test_langgraph_manager.py b/tests/test_langgraph_manager.py
index 98c2448..87ac57f 100644
--- a/tests/test_langgraph_manager.py
+++ b/tests/test_langgraph_manager.py
@@ -957,3 +957,84 @@ class TestStartLanggraphDevSpawnFlags:
         kw = env.captured["kwargs"]
         assert kw.get("start_new_session") is True
         assert "creationflags" not in kw
+
+
+# =============================================================================
+# start_langgraph_dev — interrupted startup cleanup (#534)
+# =============================================================================
+
+
+class TestStartLanggraphDevInterruptedStartup:
+    """Ctrl+C (or any error) while waiting for ``/ok`` must stop the half-started
+    server and drop its PID file / sidecar, like a post-startup Ctrl+C does."""
+
+    def _setup(self, monkeypatch, tmp_path, runtime_paths, health_probe):
+        from EvoScientist.mcp import client as mcp_client
+
+        monkeypatch.setattr(mcp_client, "load_mcp_config", lambda: {})
+        monkeypatch.setattr(manager, "_langgraph_exe", lambda: "/usr/bin/langgraph")
+        fake_config = tmp_path / "langgraph.json"
+        fake_config.write_text("{}")
+        monkeypatch.setattr(manager, "_packaged_langgraph_config", lambda: fake_config)
+        monkeypatch.setattr(manager, "is_langgraph_dev_running", health_probe)
+        monkeypatch.setattr(manager, "_is_port_occupied", lambda *_a, **_kw: False)
+        monkeypatch.setattr(manager, "_wait_for_port_bindable", lambda *_a, **_kw: True)
+        monkeypatch.setattr(manager.time, "sleep", lambda _s: None)
+
+        proc = MagicMock()
+        proc.pid = 424242
+        proc.poll.return_value = None
+        monkeypatch.setattr(manager.subprocess, "Popen", lambda *_a, **_kw: proc)
+
+        terminated: list[int] = []
+
+        def _fake_psutil_process(pid):
+            terminated.append(pid)
+            return SimpleNamespace(
+                children=lambda recursive=False: [], terminate=lambda: None
+            )
+
+        monkeypatch.setattr(manager.psutil, "Process", _fake_psutil_process)
+        return proc, terminated
+
+    def test_keyboard_interrupt_during_health_wait_stops_server(
+        self, monkeypatch, tmp_path, runtime_paths
+    ):
+        calls = {"n": 0}
+
+        def _health_probe(**_kw):
+            # First call is the pre-spawn port check; the second is inside
+            # the health-wait loop, where the user presses Ctrl+C.
+            calls["n"] += 1
+            if calls["n"] >= 2:
+                raise KeyboardInterrupt
+            return False
+
+        proc, terminated = self._setup(
+            monkeypatch, tmp_path, runtime_paths, _health_probe
+        )
+
+        with pytest.raises(KeyboardInterrupt):
+            manager.start_langgraph_dev(workspace_dir=tmp_path, port=16190)
+
+        assert terminated == [proc.pid]
+        assert not runtime_paths.pid_file.exists()
+        assert not runtime_paths.workspace_sidecar.exists()
+        assert manager._PROCESS is None
+        assert manager._PROCESS_WORKSPACE is None
+
+    def test_early_exit_still_stops_and_raises_runtime_error(
+        self, monkeypatch, tmp_path, runtime_paths
+    ):
+        proc, _terminated = self._setup(
+            monkeypatch, tmp_path, runtime_paths, lambda **_kw: False
+        )
+        proc.poll.return_value = 1
+        proc.returncode = 1
+
+        with pytest.raises(RuntimeError, match="exited immediately with code 1"):
+            manager.start_langgraph_dev(workspace_dir=tmp_path, port=16191)
+
+        assert not runtime_paths.pid_file.exists()
+        assert not runtime_paths.workspace_sidecar.exists()
+        assert manager._PROCESS is None
