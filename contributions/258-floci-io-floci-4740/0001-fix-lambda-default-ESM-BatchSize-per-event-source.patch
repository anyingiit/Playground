+    void createEventSourceMapping_withoutBatchSize_usesSourceDefault(String eventSourceArn, int expected) {
+        // Catches: every mapping defaulting BatchSize to 10, when AWS uses 10 only for SQS
+        service.createFunction(REGION, baseRequest("fn-esm-default-batch"));
