diff --git a/packages/slack-bot/src/harness.ts b/packages/slack-bot/src/harness.ts
new file mode 100644
index 0000000..844a237
--- /dev/null
+++ b/packages/slack-bot/src/harness.ts
@@ -0,0 +1,32 @@
+import {
+  checkHarnessCompatibility,
+  getHarnessCapabilities,
+  getHarnessLabel,
+  getValidHarnessOrDefault,
+  type HarnessId,
+} from "@open-inspect/shared/harnesses";
+
+/**
+ * The shared harness rule, phrased for a Slack reply. Returns null when the
+ * harness can run the model. An unset harness is the control plane's default
+ * (OpenCode), which runs every model, so unconfigured workspaces never see it.
+ */
+export function slackHarnessModelError(
+  harness: HarnessId | undefined,
+  model: string
+): string | null {
+  const resolvedHarness = getValidHarnessOrDefault(harness);
+  const incompatibility = checkHarnessCompatibility(resolvedHarness, model);
+  if (!incompatibility) return null;
+  const families = getHarnessCapabilities(resolvedHarness).modelFamilies;
+  const supported =
+    families === "any" ? "" : ` It runs ${families.map(capitalize).join(", ")} models only.`;
+  return (
+    `${incompatibility.message} This session runs on ${getHarnessLabel(resolvedHarness)}.` +
+    `${supported} Choose a supported model with \`!model\` or in the App Home tab.`
+  );
+}
+
+function capitalize(value: string): string {
+  return value.charAt(0).toUpperCase() + value.slice(1);
+}
