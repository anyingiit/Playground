 Dockerfile                                    | 45 +++++++++----------
 Dockerfile.dev                                | 45 +++++++++----------
 .../{php8 => php83}/conf.d/bbuddy-local.ini   |  0
 supervisor/cronjobs/cronjobs.go               |  2 +-
 supervisor/environment/environment.go         |  2 +-
 supervisor/services/services.go               |  6 +--
 6 files changed, 49 insertions(+), 51 deletions(-)
 rename root/etc/{php8 => php83}/conf.d/bbuddy-local.ini (100%)

