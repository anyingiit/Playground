diff --git a/pkg/http/errors.go b/pkg/http/errors.go
index f52e13a..ac459ec 100644
--- a/pkg/http/errors.go
+++ b/pkg/http/errors.go
@@ -2,4 +2,7 @@ package http
 
 import "errors"
 
-var ErrResponseBodyTooLarge = errors.New("http response too large")
+var (
+	ErrResponseBodyTooLarge = errors.New("http response too large")
