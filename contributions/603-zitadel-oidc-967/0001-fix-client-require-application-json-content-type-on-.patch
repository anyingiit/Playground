From 6c07246d2d18cd896c00158a4af85493457b9d0d Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 16:55:24 +0000
Subject: [PATCH] fix(client): require application/json content type on
 discovery

OpenID Connect Discovery 1.0, section 4.2, requires the provider
configuration response to use the application/json content type.
client.Discover did not check the Content-Type header and accepted any
response body that happened to decode as JSON.

Add httphelper.HttpJSONRequest, which behaves like HttpRequest but
rejects successful responses whose media type is not application/json
(parameters such as charset are allowed), returning an error wrapping
the new ErrInvalidContentType. Use it in client.Discover; the error is
joined with oidc.ErrDiscoveryFailed as before. HttpRequest is unchanged
for all other callers.

Closes #967
---
 pkg/client/client.go                |  4 ++-
 pkg/client/client_test.go           | 40 +++++++++++++++++++++++++++++
 pkg/client/rp/relying_party_test.go |  3 +++
 pkg/http/errors.go                  |  5 +++-
 pkg/http/http.go                    | 30 ++++++++++++++++++++++
 5 files changed, 80 insertions(+), 2 deletions(-)

diff --git a/pkg/client/client.go b/pkg/client/client.go
index 5067f53..6962719 100644
--- a/pkg/client/client.go
+++ b/pkg/client/client.go
@@ -51,7 +51,9 @@ func Discover(ctx context.Context, issuer string, httpClient *http.Client, wellK
 		return nil, err
 	}
 	discoveryConfig := new(oidc.DiscoveryConfiguration)
-	err = httphelper.HttpRequest(httpClient, req, &discoveryConfig)
+	// OpenID Connect Discovery 1.0, section 4.2: the response MUST use the
+	// application/json content type.
+	err = httphelper.HttpJSONRequest(httpClient, req, &discoveryConfig)
 	if err != nil {
 		return nil, errors.Join(oidc.ErrDiscoveryFailed, err)
 	}
