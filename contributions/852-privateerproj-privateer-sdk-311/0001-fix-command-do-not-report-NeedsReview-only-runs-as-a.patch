index bdecaf8..3ba462a 100644
--- a/pluginkit/evaluation_suite_test.go
+++ b/pluginkit/evaluation_suite_test.go
@@ -1,10 +1,12 @@
 package pluginkit
 
 import (
+	"bytes"
 	"strings"
 	"testing"
 
 	"github.com/gemaraproj/go-gemara"
+	hclog "github.com/hashicorp/go-hclog"
 )
 
 func BenchmarkEvaluate_Passing(b *testing.B) {
@@ -458,3 +460,28 @@ func TestEvaluationSuiteIntegration(t *testing.T) {
 		}
 	})
 }
+
+// TestLogSuiteSummary checks the level of the per-suite summary line: a
+// NeedsReview-only suite is a warning, not an error (issue #311).
+func TestLogSuiteSummary(t *testing.T) {
+	tests := []struct {
+		result gemara.Result
+		want   string
+	}{
+		{gemara.Passed, "[INFO]  summary"},
+		{gemara.NotRun, "[TRACE] summary"},
+		{gemara.NeedsReview, "[WARN]  summary"},
+		{gemara.Failed, "[ERROR] summary"},
+		{gemara.Unknown, "[ERROR] summary"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.result.String(), func(t *testing.T) {
+			var buf bytes.Buffer
+			logger := hclog.New(&hclog.LoggerOptions{Output: &buf, Level: hclog.Trace})
+			logSuiteSummary(logger, tt.result, "summary")
+			if got := buf.String(); !strings.Contains(got, tt.want) {
+				t.Errorf("log = %q, want it to contain %q", got, tt.want)
+			}
+		})
+	}
+}
