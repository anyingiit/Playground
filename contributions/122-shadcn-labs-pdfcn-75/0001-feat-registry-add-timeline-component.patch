+  StyleSheet,
+  Text as PDFText,
+  View,
+} from "@/registry/bases/forme/lib/pdf-primitives";
+import type { Style } from "@/registry/bases/forme/lib/pdf-primitives";
+import { resolveColor } from "@/registry/bases/forme/lib/resolve-color";
+import type { PDFComponentProps } from "@/registry/types/pdf-components";
+import type { PdfcnTheme } from "@/registry/types/pdf-themes";
+
+/**
+ * A single timeline entry.
+ * Props - `date` | `title` | `body`
+ * @see {@link TimelineItem}
+ */
+export interface TimelineItem {
+  date: string;
+  title: string;
+  body?: string;
+}
+
+/**
+ * Vertical timeline with an accent spine and dot markers.
+ * Each item is rendered as its own unbreakable row with its own spine segment,
+ * so the timeline can split across pages without orphaned markers.
+ * Props - `items` | `accentColor` | `dateWidth` | `style`
+ * @see {@link TimelineProps}
+ */
+export interface TimelineProps extends Omit<PDFComponentProps, "children"> {
+  items: TimelineItem[];
+  /**
+   * Theme color token or raw CSS color for the spine and dots.
+   * @default 'primary'
+   */
+  accentColor?: string;
+  /**
+   * Fixed width of the date column in points.
+   * @default 72
+   */
+  dateWidth?: number;
+}
+
+const DOT_SIZE = 8;
+const SPINE_WIDTH = 1.5;
+
+const createTimelineStyles = (t: PdfcnTheme) => {
+  const { spacing, fontWeights, borderRadius, typography } = t.primitives;
+  const c = t.colors;
+  const { body } = t.typography;
+  const titleLineHeight = body.fontSize * body.lineHeight;
+  const dateLineHeight = typography.xs * body.lineHeight;
+  // Center the dot (and the date) on the first line of the title.
+  const dotOffset = (titleLineHeight - DOT_SIZE) / 2;
+  const dateOffset = (titleLineHeight - dateLineHeight) / 2;
+
+  return StyleSheet.create({
+    body: {
+      color: c.mutedForeground,
+      fontFamily: body.fontFamily,
+      fontSize: typography.xs,
+      fontWeight: fontWeights.regular,
+      lineHeight: body.lineHeight,
+      marginTop: spacing[0.5],
+    },
+    container: { flexDirection: "column", width: "100%" },
+    content: {
+      flex: 1,
+      flexDirection: "column",
+      paddingBottom: t.spacing.componentGap + spacing[2],
+    },
+    contentLast: { paddingBottom: 0 },
+    date: {
+      color: c.mutedForeground,
+      fontFamily: body.fontFamily,
+      fontSize: typography.xs,
+      fontWeight: fontWeights.regular,
+      lineHeight: body.lineHeight,
+      marginTop: dateOffset,
+    },
+    dateColumn: { flexShrink: 0, paddingRight: spacing[3] },
+    dot: {
+      borderRadius: borderRadius.full,
+      height: DOT_SIZE,
+      width: DOT_SIZE,
+    },
+    rail: {
+      alignItems: "center",
+      flexDirection: "column",
+      marginRight: spacing[3],
+      width: DOT_SIZE,
+    },
+    row: {
+      alignItems: "stretch",
+      flexDirection: "row",
+    },
+    spineAfter: { flexGrow: 1, width: SPINE_WIDTH },
+    spineBefore: { height: dotOffset, width: SPINE_WIDTH },
+    title: {
+      color: c.foreground,
+      fontFamily: body.fontFamily,
+      fontSize: body.fontSize,
+      fontWeight: fontWeights.semibold,
+      lineHeight: body.lineHeight,
+    },
+  });
+};
+
+export const Timeline = ({
+  items,
+  accentColor = "primary",
+  dateWidth = 72,
+  style,
+}: TimelineProps) => {
+  const theme = usePdfcnTheme();
+  const styles = useSafeMemo(() => createTimelineStyles(theme), [theme]);
+  const accent = resolveColor(accentColor, theme.colors);
+  const containerStyles: Style[] = [styles.container];
+  if (style) {
+    containerStyles.push(...[style].flat());
+  }
+
+  return (
+    <View style={containerStyles}>
+      {items.map((item, index) => {
+        const isFirst = index === 0;
+        const isLast = index === items.length - 1;
+        return (
+          <View
+            key={`${item.date}-${item.title}-${index}`}
+            wrap={false}
+            style={styles.row}
+          >
+            <View style={[styles.dateColumn, { width: dateWidth }]}>
+              <PDFText style={styles.date}>{item.date}</PDFText>
+            </View>
+            <View style={styles.rail}>
+              <View
+                style={
+                  isFirst
+                    ? styles.spineBefore
+                    : [styles.spineBefore, { backgroundColor: accent }]
+                }
+              />
+              <View style={[styles.dot, { backgroundColor: accent }]} />
+              {isLast ? null : (
+                <View
+                  style={[styles.spineAfter, { backgroundColor: accent }]}
+                />
+              )}
+            </View>
+            <View style={[styles.content, isLast ? styles.contentLast : {}]}>
+              <PDFText style={styles.title}>{item.title}</PDFText>
+              {item.body ? (
+                <PDFText style={styles.body}>{item.body}</PDFText>
+              ) : null}
+            </View>
+          </View>
+        );
+      })}
+    </View>
+  );
+};
