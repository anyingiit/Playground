From db0a18bde47017594a2f804a565ea6ae3ed205ad Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 22:14:13 +0000
Subject: [PATCH] Support key : value pairs in DB2i JSON_OBJECT()

DB2 for i accepts both KEY 'k' VALUE v and 'k' : v inside
JSON_OBJECT(), but the db2i dialect had no ':' operator, so the colon
form failed with a parse error. Add ':' to the db2i operators. Named
host variables such as :id are still tokenized as parameters.

Fixes #773

Assisted-by: Claude Code
---
 src/languages/db2i/db2i.formatter.ts |  2 +-
 test/db2i.test.ts                    | 25 +++++++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/src/languages/db2i/db2i.formatter.ts b/src/languages/db2i/db2i.formatter.ts
index b05c66f..7b534b7 100644
--- a/src/languages/db2i/db2i.formatter.ts
+++ b/src/languages/db2i/db2i.formatter.ts
@@ -178,7 +178,7 @@ export const db2i: DialectOptions = {
     identChars: { first: '@#$', rest: '@#$' },
     paramTypes: { positional: true, named: [':'] },
     paramChars: { first: '@#$', rest: '@#$' },
-    operators: ['**', '¬=', '¬>', '¬<', '!>', '!<', '||', '=>'],
+    operators: ['**', '¬=', '¬>', '¬<', '!>', '!<', '||', '=>', ':'],
   },
   formatOptions: {
     onelineClauses: [...standardOnelineClauses, ...tabularOnelineClauses],
diff --git a/test/db2i.test.ts b/test/db2i.test.ts
index 1b03dc8..55e3729 100644
--- a/test/db2i.test.ts
+++ b/test/db2i.test.ts
@@ -1,3 +1,5 @@
+import dedent from 'dedent-js';
+
 import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
 import behavesLikeDb2Formatter from './behavesLikeDb2Formatter.js';
 import supportsComments from './features/comments.js';
@@ -34,4 +36,27 @@ describe('Db2iFormatter', () => {
     { any: true }
   );
   supportsDataTypeCase(format);
+
+  // Issue #773
+  it('supports key : value pairs in JSON_OBJECT()', () => {
+    expect(
+      format(`SELECT JSON_OBJECT('key':'val', 'arr' : JSON_ARRAY(1, 2)) FROM SYSIBM.SYSDUMMY1;`)
+    ).toBe(dedent`
+      SELECT
+        JSON_OBJECT('key': 'val', 'arr': JSON_ARRAY(1, 2))
+      FROM
+        SYSIBM.SYSDUMMY1;
+    `);
+  });
+
+  it('still supports :name host variables', () => {
+    expect(format('SELECT * FROM tbl WHERE id = :id;')).toBe(dedent`
+      SELECT
+        *
+      FROM
+        tbl
+      WHERE
+        id = :id;
+    `);
+  });
 });
