From 4da7839ecfbc51baf14ef934e85c320edbe21386 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 22:14:13 +0000
Subject: [PATCH] Support key : value pairs in DB2i JSON_OBJECT()

DB2 for i accepts both KEY 'k' VALUE v and 'k' : v inside
JSON_OBJECT() and JSON_OBJECTAGG(), but the db2i dialect had no ':'
operator, so the colon form failed with a parse error. Add ':' to the
db2i operators. Named host variables such as :id are still tokenized
as parameters.

Because db2i also uses :name for host variables, keep the space after
':' when denseOperators is enabled. Otherwise 'k' : v would be printed
as 'k':v, which reads back as 'k' followed by the host variable :v.

Fixes #773

Assisted-by: Claude Code
---
 src/dialect.ts                       |  1 +
 src/formatter/ExpressionFormatter.ts |  6 +++++
 src/languages/db2i/db2i.formatter.ts |  2 +-
 test/db2i.test.ts                    | 35 ++++++++++++++++++++++++++++
 4 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/src/dialect.ts b/src/dialect.ts
index 5a4b40e..53f635b 100644
--- a/src/dialect.ts
+++ b/src/dialect.ts
@@ -47,4 +47,5 @@ const processDialectFormatOptions = ({
     (options.tabularOnelineClauses ?? options.onelineClauses).map(name => [name, true])
   ),
   identifierDashes: Boolean(tokenizerOptions.identChars?.dashes),
+  colonNamedParams: Boolean(tokenizerOptions.paramTypes?.named?.includes(':')),
 });
diff --git a/src/formatter/ExpressionFormatter.ts b/src/formatter/ExpressionFormatter.ts
index 2c1fdc6..da67109 100644
--- a/src/formatter/ExpressionFormatter.ts
+++ b/src/formatter/ExpressionFormatter.ts
@@ -66,6 +66,10 @@ export interface ProcessedDialectFormatOptions {
   // In such dialects the "-" operator must keep its surrounding spaces,
   // otherwise "a - b" densed to "a-b" would re-parse as a single identifier.
   identifierDashes: boolean;
+  // True when ":name" is a named parameter (e.g. DB2i host variables).
+  // In such dialects the ":" operator must keep the space after it,
+  // otherwise "'k' : v" densed to "'k':v" would re-parse as "'k'" followed by parameter ":v".
+  colonNamedParams: boolean;
 }
 
 /** Formats a generic SQL expression */
@@ -355,6 +359,8 @@ export default class ExpressionFormatter {
       // would glue it to its operands ("aOPERATOR(...)b") and re-parse as invalid
       // SQL, so keep its surrounding spaces even with denseOperators.
       this.layout.add(text, WS.SPACE);
+    } else if (text === ':' && this.cfg.denseOperators && this.dialectCfg.colonNamedParams) {
+      this.layout.add(WS.NO_SPACE, text, WS.SPACE);
     } else if (this.cfg.denseOperators || this.dialectCfg.alwaysDenseOperators.includes(text)) {
       this.layout.add(WS.NO_SPACE, text);
     } else if (text === ':' && this.enclosingParenthesis === '[') {
diff --git a/src/languages/db2i/db2i.formatter.ts b/src/languages/db2i/db2i.formatter.ts
index b05c66f..7b534b7 100644
--- a/src/languages/db2i/db2i.formatter.ts
+++ b/src/languages/db2i/db2i.formatter.ts
@@ -178,7 +178,7 @@ export const db2i: DialectOptions = {
     identChars: { first: '@#$', rest: '@#$' },
     paramTypes: { positional: true, named: [':'] },
     paramChars: { first: '@#$', rest: '@#$' },
-    operators: ['**', '¬=', '¬>', '¬<', '!>', '!<', '||', '=>'],
+    operators: ['**', '¬=', '¬>', '¬<', '!>', '!<', '||', '=>', ':'],
   },
   formatOptions: {
     onelineClauses: [...standardOnelineClauses, ...tabularOnelineClauses],
diff --git a/test/db2i.test.ts b/test/db2i.test.ts
index 1b03dc8..3d01513 100644
--- a/test/db2i.test.ts
+++ b/test/db2i.test.ts
@@ -1,3 +1,5 @@
+import dedent from 'dedent-js';
+
 import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
 import behavesLikeDb2Formatter from './behavesLikeDb2Formatter.js';
 import supportsComments from './features/comments.js';
@@ -34,4 +36,37 @@ describe('Db2iFormatter', () => {
     { any: true }
   );
   supportsDataTypeCase(format);
+
+  // Issue #773
+  it('supports key : value pairs in JSON_OBJECT()', () => {
+    expect(
+      format(`SELECT JSON_OBJECT('key':'val', 'arr' : JSON_ARRAY(1, 2)) FROM SYSIBM.SYSDUMMY1;`)
+    ).toBe(dedent`
+      SELECT
+        JSON_OBJECT('key': 'val', 'arr': JSON_ARRAY(1, 2))
+      FROM
+        SYSIBM.SYSDUMMY1;
+    `);
+  });
+
+  it('keeps the space after : with denseOperators, so the value is not read as a host variable', () => {
+    expect(format(`SELECT JSON_OBJECT('a' : JSON_ARRAY(1)) FROM t;`, { denseOperators: true }))
+      .toBe(dedent`
+      SELECT
+        JSON_OBJECT('a': JSON_ARRAY(1))
+      FROM
+        t;
+    `);
+  });
+
+  it('still supports :name host variables', () => {
+    expect(format('SELECT * FROM tbl WHERE id = :id;')).toBe(dedent`
+      SELECT
+        *
+      FROM
+        tbl
+      WHERE
+        id = :id;
+    `);
+  });
 });
