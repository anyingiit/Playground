Fix #453.
---
 docs/api_reference.rst                  | 16 ++++++++++++++++
 tests/css/test_common.py                | 13 +++++++++++++
 tests/css/test_validation.py            | 12 ++++++++++++
 weasyprint/css/properties.py            |  2 ++
 weasyprint/css/validation/properties.py |  7 +++++++
 5 files changed, 50 insertions(+)

diff --git a/docs/api_reference.rst b/docs/api_reference.rst
index 89364ea..c8cf549 100644
--- a/docs/api_reference.rst
+++ b/docs/api_reference.rst
@@ -557,6 +557,22 @@ WeasyPrint does **not** support the ``color-mix()`` and ``contrast-color()`` pro
 .. _CSS Color Module Level 4: https://www.w3.org/TR/css-color-4/
 .. _CSS Color Module Level 5: https://www.w3.org/TR/css-color-5/
 
+CSS Color Adjustment Module Level 1
++++++++++++++++++++++++++++++++++++
+
+The `CSS Color Adjustment Module Level 1`_ is a candidate recommendation
+introducing "a model and controls over automatic color adjustment by the user
+agent to handle user preferences and device output optimizations".
+
+WeasyPrint supports the ``color-scheme`` and ``print-color-adjust``
+properties. As WeasyPrint never removes backgrounds or changes colors to save
+ink, ``print-color-adjust: economy`` and ``print-color-adjust: exact`` give
+the same result.
+
+WeasyPrint does **not** support the ``forced-color-adjust`` property.
+
+.. _CSS Color Adjustment Module Level 1: https://www.w3.org/TR/css-color-adjust-1/
+
 CSS Transforms Module Level 1
 +++++++++++++++++++++++++++++
 
diff --git a/tests/css/test_common.py b/tests/css/test_common.py
index 31bfb7f..6812c66 100644
--- a/tests/css/test_common.py
+++ b/tests/css/test_common.py
@@ -249,6 +249,19 @@ def test_recursive_lh(property):
     document.render().pages
 
 
+@assert_no_logs
+def test_print_color_adjust_inherited():
+    document = FakeHTML(string='''
+      <body style="print-color-adjust: exact"><p>a</p>''')
+    page, = document.render().pages
+    html, = page._page_box.children
+    body, = html.children
+    p, = body.children
+    assert html.style['print_color_adjust'] == 'economy'
+    assert body.style['print_color_adjust'] == 'exact'
+    assert p.style['print_color_adjust'] == 'exact'
+
+
 @pytest.mark.parametrize(('media', 'width', 'warning'), [
     ('@media screen { @page { size: 10px } }', 20, False),
     ('@media print { @page { size: 10px } }', 10, False),
diff --git a/tests/css/test_validation.py b/tests/css/test_validation.py
index 01843e9..0a121d1 100644
--- a/tests/css/test_validation.py
+++ b/tests/css/test_validation.py
@@ -1352,6 +1352,18 @@ def test_color_scheme_invalid(rule):
     assert_invalid(f'color-scheme: {rule}')
 
 
+@assert_no_logs
+@pytest.mark.parametrize('rule', ['economy', 'exact'])
+def test_print_color_adjust(rule):
+    assert get_value(f'print-color-adjust: {rule}') == rule
+
+
+@assert_no_logs
+@pytest.mark.parametrize('rule', ['auto', 'exact economy', 'none', '1px'])
+def test_print_color_adjust_invalid(rule):
+    assert_invalid(f'print-color-adjust: {rule}')
+
+
 @assert_no_logs
 @pytest.mark.parametrize(('rule', 'value'), [
     ('none', ()),
