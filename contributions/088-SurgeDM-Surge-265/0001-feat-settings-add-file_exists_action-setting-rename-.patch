diff --git a/internal/orchestrator/file_utils.go b/internal/orchestrator/file_utils.go
index d4c6f0f..144aea2 100644
--- a/internal/orchestrator/file_utils.go
+++ b/internal/orchestrator/file_utils.go
@@ -67,6 +67,15 @@ func InferFilenameFromURL(rawURL string) string {
 // GetUniqueFilename keeps final files and .surge working files in the same
 // collision namespace so concurrent or resumed downloads do not share a path.
 func GetUniqueFilename(dir, filename string, isNameActive func(string, string) bool) string {
+	return resolveFilename(dir, filename, isNameActive, false)
+}
+
+// resolveFilename picks the final file name inside dir. With allowOverwrite,
+// an existing regular file with the requested name is not treated as a
+// collision, so the completed download replaces it. Active downloads and
+// .surge working files always count as collisions and fall back to suffixing,
+// because overwriting those would corrupt another in-flight download.
+func resolveFilename(dir, filename string, isNameActive func(string, string) bool, allowOverwrite bool) string {
 	if filename == "" {
 		return filename
 	}
@@ -108,6 +117,10 @@ func GetUniqueFilename(dir, filename string, isNameActive func(string, string) b
 		return filename
 	}
 
+	if allowOverwrite && canOverwrite(dir, filename, isNameActive) {
+		return filename
+	}
+
 	// Keep suffixing from the same base so repeated retries stay deterministic.
 	ext := filepath.Ext(filename)
 	name := strings.TrimSuffix(filename, ext)
@@ -136,6 +149,20 @@ func GetUniqueFilename(dir, filename string, isNameActive func(string, string) b
 	return ""
 }
 
+// canOverwrite reports whether name in dir is only blocked by a finished
+// regular file (not a directory, an active download or a .surge working file).
+func canOverwrite(dir, name string, isNameActive func(string, string) bool) bool {
+	if isNameActive != nil && isNameActive(dir, name) {
+		return false
+	}
+	targetPath := filepath.Join(dir, name)
+	if _, err := os.Stat(targetPath + types.IncompleteSuffix); !os.IsNotExist(err) {
+		return false
+	}
+	info, err := os.Stat(targetPath)
+	return err == nil && info.Mode().IsRegular()
+}
+
 // GetCategoryPath applies category routing only while the caller is still using
 // the default destination, so explicit user paths are left untouched.
 func GetCategoryPath(filename, defaultDir string, settings *config.Settings) (string, error) {
@@ -190,7 +217,8 @@ func ResolveDestination(url, candidateFilename, defaultDir string, routeToCatego
 	// Safety: Truncate early so GetUniqueFilename has room to append a suffix
 	filename = utils.TruncateFilename(filename)
 
-	finalFilename := GetUniqueFilename(destPath, filename, isNameActive)
+	allowOverwrite := settings != nil && config.Resolve[string](settings.General.FileExistsAction) == config.FileExistsOverwrite
+	finalFilename := resolveFilename(destPath, filename, isNameActive, allowOverwrite)
 	if finalFilename == "" {
 		return "", "", fmt.Errorf("could not determine a unique filename for %s", url)
 	}
diff --git a/internal/orchestrator/file_utils_test.go b/internal/orchestrator/file_utils_test.go
index bb653e3..5d1fc51 100644
--- a/internal/orchestrator/file_utils_test.go
+++ b/internal/orchestrator/file_utils_test.go
@@ -240,3 +240,91 @@ func TestResolveDestination_ErrorsWhenUniqueNameExhausted(t *testing.T) {
 		t.Fatal("expected unique-name exhaustion error")
 	}
 }
+
+func TestResolveDestination_FileExistsAction(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "report.pdf"), []byte("old"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	settings := config.DefaultSettings()
+	settings.Categories.CategoryEnabled.Value = false
+
+	// Default (rename) keeps the existing behavior.
+	if _, name, err := ResolveDestination("http://example.com/report.pdf", "report.pdf", dir, false, settings, nil, nil); err != nil || name != "report(1).pdf" {
+		t.Fatalf("rename: got %q, %v; want report(1).pdf", name, err)
+	}
+
+	settings.General.FileExistsAction.Value = config.FileExistsOverwrite
+
+	// Overwrite reuses the existing name so finalize replaces the old file.
+	if _, name, err := ResolveDestination("http://example.com/report.pdf", "report.pdf", dir, false, settings, nil, nil); err != nil || name != "report.pdf" {
+		t.Fatalf("overwrite: got %q, %v; want report.pdf", name, err)
+	}
+
+	// A name owned by an active download must never be overwritten.
+	active := func(_, name string) bool { return name == "report.pdf" }
+	if _, name, _ := ResolveDestination("http://example.com/report.pdf", "report.pdf", dir, false, settings, nil, active); name != "report(1).pdf" {
+		t.Fatalf("overwrite with active download: got %q, want report(1).pdf", name)
+	}
+
+	// Neither may a pending .surge working file of another download.
+	if err := os.WriteFile(filepath.Join(dir, "notes.txt"), []byte("old"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "notes.txt"+types.IncompleteSuffix), nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, name, _ := ResolveDestination("http://example.com/notes.txt", "notes.txt", dir, false, settings, nil, nil); name != "notes(1).txt" {
+		t.Fatalf("overwrite with .surge sibling: got %q, want notes(1).txt", name)
+	}
+
+	// Directories are not replaced.
+	if err := os.Mkdir(filepath.Join(dir, "data"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, name, _ := ResolveDestination("http://example.com/data", "data", dir, false, settings, nil, nil); name != "data(1)" {
+		t.Fatalf("overwrite with directory: got %q, want data(1)", name)
+	}
+}
+
+func TestFinalizeCompletedFile_OverwritesExistingFile(t *testing.T) {
+	dir := t.TempDir()
+	finalPath := filepath.Join(dir, "report.pdf")
+	if err := os.WriteFile(finalPath, []byte("old"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(finalPath+types.IncompleteSuffix, []byte("new"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := finalizeCompletedFile(finalPath); err != nil {
+		t.Fatalf("finalizeCompletedFile: %v", err)
+	}
+	got, err := os.ReadFile(finalPath)
+	if err != nil || string(got) != "new" {
+		t.Fatalf("final file = %q, %v; want %q", got, err, "new")
+	}
+	if _, err := os.Stat(finalPath + types.IncompleteSuffix); !os.IsNotExist(err) {
+		t.Fatalf("working file still present: %v", err)
+	}
+}
+
+func TestFinalizeCompletedFile_FailedReplaceIsNotSuccess(t *testing.T) {
+	dir := t.TempDir()
+	finalPath := filepath.Join(dir, "report.pdf")
+	if err := os.WriteFile(finalPath, []byte("old"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(finalPath+types.IncompleteSuffix, []byte("new"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	orig := renameCompletedFile
+	renameCompletedFile = func(string, string) error { return os.ErrPermission }
+	t.Cleanup(func() { renameCompletedFile = orig })
+
+	if err := finalizeCompletedFile(finalPath); err == nil {
+		t.Fatal("expected error when the working file could not replace the existing file")
+	}
+}
diff --git a/internal/tui/settings_file_exists_test.go b/internal/tui/settings_file_exists_test.go
