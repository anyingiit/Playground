+#[test]
+fn test_sparse_fileset_function() {
+    let test_env = TestEnvironment::default();
+    test_env.run_jj_in(".", ["git", "init", "repo"]).success();
+    let work_dir = test_env.work_dir("repo");
+
+    work_dir.write_file("foo.txt", "foo\n");
+    work_dir.write_file("bar.txt", "bar\n");
+    work_dir
+        .run_jj(["commit", "-m", "add foo and bar"])
+        .success();
+    work_dir.write_file("bar.txt", "bar 2\n");
+    work_dir.run_jj(["commit", "-m", "modify bar"]).success();
+    work_dir.write_file("foo.txt", "foo 2\n");
+    work_dir.run_jj(["commit", "-m", "modify foo"]).success();
+
+    // By default, sparse() matches everything
+    let output = work_dir.run_jj(["file", "list", "sparse()"]);
+    insta::assert_snapshot!(output, @"
+    bar.txt
+    foo.txt
+    [EOF]
+    ");
+
+    work_dir
+        .run_jj(["sparse", "set", "--clear", "--add", "foo.txt"])
+        .success();
+    let output = work_dir.run_jj(["file", "list", "-r@-", "sparse()"]);
+    insta::assert_snapshot!(output, @"
+    foo.txt
+    [EOF]
+    ");
+
+    // Revisions which don't touch the sparse patterns can be filtered out
+    let output = work_dir.run_jj([
+        "log",
+        "--no-graph",
+        "-r",
+        "files(sparse())",
+        "-T",
+        "description",
+    ]);
+    insta::assert_snapshot!(output, @"
+    modify foo
+    add foo and bar
+    [EOF]
+    ");
+
+    // sparse() can be combined with other patterns
+    let output = work_dir.run_jj(["file", "list", "-r@-", "~sparse()"]);
+    insta::assert_snapshot!(output, @"
+    bar.txt
+    [EOF]
+    ");
+
+    // With no sparse patterns, sparse() matches nothing
+    work_dir.run_jj(["sparse", "set", "--clear"]).success();
+    let output = work_dir.run_jj(["file", "list", "-r@-", "sparse()"]);
+    insta::assert_snapshot!(output, @"");
+
+    // There's no working copy to resolve sparse() against in config
+    let output = work_dir.run_jj(["status", "--config=snapshot.auto-track='sparse()'"]);
+    insta::assert_snapshot!(output, @"
+    ------- stderr -------
+    Error: Failed to parse fileset: Sparse patterns are not available in this context
+    Caused by:  --> 1:1
+      |
+    1 | sparse()
+      | ^----^
+      |
+      = Sparse patterns are not available in this context
+    [EOF]
+    [exit status: 1]
+    ");
+}
