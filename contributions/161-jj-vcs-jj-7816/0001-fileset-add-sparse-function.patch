+    #[test]
+    fn test_parse_sparse_function() -> TestResult {
+        let settings = insta_settings();
+        let _guard = settings.bind_to_scope();
+        let path_converter = RepoPathUiConverter::Fs {
+            cwd: PathBuf::from("/ws/cur"),
+            base: PathBuf::from("/ws"),
+        };
+        let parse_with = |text, sparse_patterns| {
+            let context = FilesetParseContext {
+                aliases_map: &FilesetAliasesMap::new(),
+                path_converter: &path_converter,
+                sparse_patterns,
+            };
+            parse_maybe_bare(&mut FilesetDiagnostics::new(), text, &context)
+        };
+
+        let patterns = [repo_path_buf("foo"), repo_path_buf("bar/baz")];
+        let root_patterns = [RepoPathBuf::root()];
+        insta::assert_debug_snapshot!(parse_with("sparse()", Some(&patterns))?, @r#"
+        UnionAll(
+            [
+                Pattern(PrefixPath("foo")),
+                Pattern(PrefixPath("bar/baz")),
+            ],
+        )
+        "#);
+        // Sparse patterns are relative to the workspace root, not to cwd.
+        insta::assert_debug_snapshot!(
+            parse_with("sparse() & x", Some(&patterns[..1]))?, @r#"
+        Intersection(
+            Pattern(PrefixPath("foo")),
+            Pattern(PrefixPath("cur/x")),
+        )
+        "#);
+        insta::assert_debug_snapshot!(
+            parse_with("sparse()", Some(&root_patterns))?,
+            @r#"Pattern(PrefixPath(""))"#);
+        insta::assert_debug_snapshot!(parse_with("sparse()", Some(&[]))?, @"None");
+        insta::assert_debug_snapshot!(parse_with("sparse(x)", Some(&[])).unwrap_err().kind(), @r#"
+        InvalidArguments {
+            name: "sparse",
+            message: "Expected 0 arguments",
+        }
+        "#);
+        insta::assert_debug_snapshot!(
+            parse_with("sparse()", None).unwrap_err().kind(),
+            @r#"Expression("Sparse patterns are not available in this context")"#);
+        Ok(())
+    }
