index 98c2448..ccf3a20 100644
--- a/tests/test_langgraph_manager.py
+++ b/tests/test_langgraph_manager.py
@@ -811,6 +811,79 @@ class TestStartLanggraphDevCapturesLogOffset:
         assert env.captured["offset"] == 0
 
 
+class TestStartLanggraphDevCleansUpOnInterrupt:
+    """Ctrl+C (or any other exception) after ``Popen`` has spawned the
+    server but before ``start_langgraph_dev`` returns must stop the child.
+    The server runs in its own session/process group, so the terminal's
+    SIGINT never reaches it, and the caller's cleanup handlers are only
+    registered after this function returns — without this, the server is
+    orphaned along with its PID file and workspace sidecar (#534).
+    """
+
+    @pytest.fixture
+    def spawned(self, start_langgraph_dev_capture, monkeypatch):
+        env = start_langgraph_dev_capture
+        proc = MagicMock(pid=424242)
+        proc.poll.return_value = None  # still starting up
+        monkeypatch.setattr(
+            "EvoScientist.langgraph_dev.manager.subprocess.Popen",
+            lambda *a, **kw: proc,
+        )
+        monkeypatch.setattr(manager.time, "sleep", lambda _s: None)
+        stopped: list = []
+        monkeypatch.setattr(manager, "stop_langgraph_dev", stopped.append)
+        # start_langgraph_dev records the handle in module globals and the
+        # spy above does not clear them; let monkeypatch restore them so the
+        # fake handle does not leak into later tests.
+        monkeypatch.setattr(manager, "_PROCESS", None)
+        monkeypatch.setattr(manager, "_PROCESS_WORKSPACE", None)
+        monkeypatch.setattr(manager, "_PROCESS_DEPLOY_MODE", None)
+        return SimpleNamespace(env=env, proc=proc, stopped=stopped)
+
+    def test_keyboard_interrupt_during_health_poll_stops_server(
+        self, spawned, monkeypatch
+    ):
+        calls = {"n": 0}
+
+        def _running(*_a, **_kw):
+            # First call is the pre-spawn port check; interrupt the
+            # post-spawn health poll the way Ctrl+C would.
+            calls["n"] += 1
+            if calls["n"] > 1:
+                raise KeyboardInterrupt
+            return False
+
+        monkeypatch.setattr(manager, "is_langgraph_dev_running", _running)
+        with pytest.raises(KeyboardInterrupt):
+            manager.start_langgraph_dev(workspace_dir=spawned.env.tmp_path)
+        assert spawned.stopped == [spawned.proc]
+
+    def test_error_writing_sidecar_stops_server(self, spawned, monkeypatch):
+        monkeypatch.setattr(manager, "is_langgraph_dev_running", lambda *a, **kw: False)
+
+        def _boom(**_kw):
+            raise OSError("disk full")
+
+        monkeypatch.setattr(manager, "_write_workspace_sidecar", _boom)
+        with pytest.raises(OSError, match="disk full"):
+            manager.start_langgraph_dev(workspace_dir=spawned.env.tmp_path)
+        assert spawned.stopped == [spawned.proc]
+
+    def test_successful_start_does_not_stop_server(self, spawned, monkeypatch):
+        calls = {"n": 0}
+
+        def _running(*_a, **_kw):
+            calls["n"] += 1
+            return calls["n"] > 1  # healthy on first post-spawn poll
+
+        monkeypatch.setattr(manager, "is_langgraph_dev_running", _running)
+        assert (
+            manager.start_langgraph_dev(workspace_dir=spawned.env.tmp_path)
+            is spawned.proc
+        )
+        assert spawned.stopped == []
+
+
