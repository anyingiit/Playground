diff --git a/agent_pulse/daemon.py b/agent_pulse/daemon.py
index e58a5c7..5ba109f 100644
--- a/agent_pulse/daemon.py
+++ b/agent_pulse/daemon.py
@@ -42,6 +42,7 @@ TAB_LABELS_FILE_NAME = "tab_labels.json"
 SUMMARY_FILE_NAME = "summary.txt"
 LOG_FILE_NAME = "daemon.log"
 LOG_MAX_BYTES = 256 * 1024
+LOCK_ACQUIRE_ATTEMPTS = 5  # retries when a releasing daemon unlinks the pidfile under us
 
 TASK_TEXT_REFRESH_INTERVAL = 1.0  # seconds; how often working panes' task text is re-read
 MAIN_LOOP_MAX_POLL = 0.25  # seconds; upper bound so we never block past a due schedule
@@ -88,26 +89,49 @@ class SingletonLock(object):
         self._handle = handle
 
     def release(self):
+        # Unlink the pidfile while still holding the lock: a daemon starting
+        # in between then either fails to lock this inode or, if it wins the
+        # lock after we unlock, sees the path no longer points at it (see
+        # acquire_singleton_lock) and retries on a fresh pidfile.
         try:
-            fcntl.flock(self._handle.fileno(), fcntl.LOCK_UN)
+            os.remove(self._path)
         except OSError:
             pass
         try:
-            os.remove(self._path)
+            fcntl.flock(self._handle.fileno(), fcntl.LOCK_UN)
         except OSError:
             pass
         self._handle.close()
 
 
+def _is_same_file(handle, path):
+    """True if `path` still names the inode `handle` has open."""
+    try:
+        path_stat = os.stat(path)
+    except OSError:
+        return False
+    handle_stat = os.fstat(handle.fileno())
+    return (path_stat.st_dev, path_stat.st_ino) == (handle_stat.st_dev, handle_stat.st_ino)
+
+
 def acquire_singleton_lock(state_directory):
     """Return a held SingletonLock, or None if another daemon already holds it."""
     _ensure_dir(state_directory)
     path = os.path.join(state_directory, PID_FILE_NAME)
-    handle = open(path, "a+")
-    try:
-        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
-    except OSError:
+    for _attempt in range(LOCK_ACQUIRE_ATTEMPTS):
+        handle = open(path, "a+")
+        try:
+            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            handle.close()
+            return None
+        if _is_same_file(handle, path):
+            break
+        # We locked a pidfile that a releasing daemon unlinked after we
+        # opened it; that inode no longer excludes anyone. Start over on
+        # whatever is at the path now.
         handle.close()
+    else:
         return None
     handle.seek(0)
     handle.truncate()
diff --git a/tests/test_daemon.py b/tests/test_daemon.py
