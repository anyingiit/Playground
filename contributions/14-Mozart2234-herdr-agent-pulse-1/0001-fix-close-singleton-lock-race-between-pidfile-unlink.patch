@@ -2,6 +2,7 @@ import json
 import os
 import tempfile
 import unittest
+from unittest import mock
 
 from agent_pulse import client as client_module
 from agent_pulse import config as config_module
@@ -108,6 +109,51 @@ class SingletonLockTests(unittest.TestCase):
         lock.release()
         self.assertFalse(os.path.exists(pid_path))
 
+    def _assert_single_holder(self, *locks):
+        held = [lock for lock in locks if lock is not None]
+        try:
+            self.assertEqual(len(held), 1, "two daemons hold the singleton lock at once")
+        finally:
+            for lock in held:
+                lock.release()
+
+    def test_daemon_starting_during_release_is_not_doubled(self):
+        # Issue #1: a daemon that starts while the holder is mid-release must
+        # not lock the pidfile inode that release() is about to unlink --
+        # otherwise a third daemon locks a fresh pidfile alongside it.
+        holder = daemon.acquire_singleton_lock(self.tmpdir)
+        started_during_release = []
+        real_remove = os.remove
+
+        def remove_while_a_daemon_starts(path):
+            started_during_release.append(daemon.acquire_singleton_lock(self.tmpdir))
+            real_remove(path)
+
+        with mock.patch.object(daemon.os, "remove", side_effect=remove_while_a_daemon_starts):
+            holder.release()
+        second = started_during_release[0]
+        third = daemon.acquire_singleton_lock(self.tmpdir)
+        self._assert_single_holder(second, third)
+
+    def test_daemon_that_opened_pidfile_before_release_is_not_doubled(self):
+        # Issue #1: a daemon that opened the pidfile before the holder
+        # released, but only reaches flock() after the file was unlinked,
+        # must not treat that orphaned inode as the singleton lock.
+        holder = daemon.acquire_singleton_lock(self.tmpdir)
+        real_flock = daemon.fcntl.flock
+        released = []
+
+        def flock_after_holder_releases(fd, operation):
+            if operation & daemon.fcntl.LOCK_EX and not released:
+                released.append(True)
+                holder.release()
+            return real_flock(fd, operation)
+
+        with mock.patch.object(daemon.fcntl, "flock", side_effect=flock_after_holder_releases):
+            second = daemon.acquire_singleton_lock(self.tmpdir)
+        third = daemon.acquire_singleton_lock(self.tmpdir)
+        self._assert_single_holder(second, third)
+
 
 class DaemonTestCase(unittest.TestCase):
     def setUp(self):
