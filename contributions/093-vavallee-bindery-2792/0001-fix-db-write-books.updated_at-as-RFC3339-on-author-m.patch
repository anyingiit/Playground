From 26dab451fb9acca40aaaee56e5047dd54a76d525 Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 1 Oct 2026 18:29:11 +0000
Subject: [PATCH] fix(db): write books.updated_at as RFC3339 on author merge
 (#2792)

AuthorAliasRepo.Merge bound a raw time.Time when reparenting books, so
the sqlite driver stored updated_at in Go's time.String shape
("... +0000 UTC") instead of the RFC3339Nano that every other books
writer uses since #914. Wrap it in timeValueArg like the other writers.

Signed-off-by: anyingiit <49945850+anyingiit@users.noreply.github.com>
---
 changelog.d/2792-merge-updated-at.md |  3 +++
 internal/db/author_aliases.go        |  2 +-
 internal/db/author_aliases_test.go   | 37 ++++++++++++++++++++++++++++
 3 files changed, 41 insertions(+), 1 deletion(-)
 create mode 100644 changelog.d/2792-merge-updated-at.md

diff --git a/changelog.d/2792-merge-updated-at.md b/changelog.d/2792-merge-updated-at.md
new file mode 100644
index 0000000..7274313
--- /dev/null
+++ b/changelog.d/2792-merge-updated-at.md
@@ -0,0 +1,3 @@
+### Fixed
+
+- **Merging authors no longer writes book timestamps in a legacy format** (#2792): reparented books had their `updated_at` stored in Go's default time string (`… +0000 UTC`) instead of the RFC 3339 form every other write uses, the same mixed-format shape behind #914. Merges now write the canonical format.
diff --git a/internal/db/author_aliases.go b/internal/db/author_aliases.go
index 17aeeda..e36025d 100644
--- a/internal/db/author_aliases.go
+++ b/internal/db/author_aliases.go
@@ -366,7 +366,7 @@ func (r *AuthorAliasRepo) Merge(ctx context.Context, sourceID, targetID int64, o
 	// source author row is removed.
 	booksRes, err := tx.ExecContext(ctx,
 		"UPDATE books SET author_id = ?, updated_at = ? WHERE author_id = ?",
-		targetID, time.Now().UTC(), sourceID)
+		targetID, timeValueArg(time.Now().UTC()), sourceID)
 	if err != nil {
 		return nil, fmt.Errorf("reparent books: %w", err)
 	}
diff --git a/internal/db/author_aliases_test.go b/internal/db/author_aliases_test.go
index 622b467..814b844 100644
--- a/internal/db/author_aliases_test.go
+++ b/internal/db/author_aliases_test.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"strings"
 	"testing"
+	"time"
 
 	"github.com/vavallee/bindery/internal/models"
 )
@@ -555,3 +556,39 @@ func TestMerge_CollidingAliasesNotDuplicated(t *testing.T) {
 		t.Errorf("expected exactly one 'Collision Name' alias on target, got %d", count)
 	}
 }
+
+// Merge used to bind a raw time.Time for books.updated_at, which the sqlite
+// driver stores in Go's time.String shape ("... +0000 UTC") instead of the
+// RFC3339Nano every other books writer uses (#914, #2792).
+func TestMerge_WritesBookUpdatedAtAsRFC3339(t *testing.T) {
+	database, err := OpenMemory()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+
+	ctx := context.Background()
+	authorRepo := NewAuthorRepo(database)
+	bookRepo := NewBookRepo(database)
+	aliasRepo := NewAuthorAliasRepo(database)
+
+	source := seedAuthor(t, authorRepo, "OL-source", "Source Author")
+	target := seedAuthor(t, authorRepo, "OL-target", "Target Author")
+	b := seedBook(t, bookRepo, source.ID, "W-2792", "Merged Book")
+
+	if _, err := aliasRepo.Merge(ctx, source.ID, target.ID, MergeOptions{}); err != nil {
+		t.Fatalf("merge: %v", err)
+	}
+
+	var stored string
+	if err := database.QueryRowContext(ctx,
+		"SELECT CAST(updated_at AS TEXT) FROM books WHERE id = ?", b.ID).Scan(&stored); err != nil {
+		t.Fatalf("read raw updated_at: %v", err)
+	}
+	if strings.Contains(stored, " UTC") {
+		t.Errorf("merge stored books.updated_at in Go default shape %q; want RFC3339Nano", stored)
+	}
+	if _, perr := time.Parse(time.RFC3339Nano, stored); perr != nil {
+		t.Errorf("stored updated_at %q does not parse as RFC3339Nano: %v", stored, perr)
+	}
+}
