From 7a04f7bab66e9bd893a26860aefb58cd6e745caa Mon Sep 17 00:00:00 2001
From: anyingiit <49945850+anyingiit@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:26:42 +0000
Subject: [PATCH] fix: don't treat a sibling with a longer name as a move into
 itself

When resolving a move cycle, the parent-into-itself check compared the
destination against the source with a bare prefix match. Swapping the
names of `foo` and `foo2` therefore looked like moving `foo` into
itself and failed with "Detected cycle in desired paths". Only treat the
destination as nested when it starts with the source followed by a path
separator, as the check for selected actions already does.

Fixes #754
---
 lua/oil/mutator/init.lua |  2 +-
 tests/mutator_spec.lua   | 25 +++++++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/lua/oil/mutator/init.lua b/lua/oil/mutator/init.lua
index f55957d..bdaa2ea 100644
--- a/lua/oil/mutator/init.lua
+++ b/lua/oil/mutator/init.lua
@@ -314,7 +314,7 @@ M.enforce_action_order = function(actions)
     else
       if loop_action and loop_action.type == "move" then
         -- If this is moving a parent into itself, that's an error
-        if vim.startswith(loop_action.dest_url, loop_action.src_url) then
+        if vim.startswith(loop_action.dest_url, loop_action.src_url .. "/") then
           error("Detected cycle in desired paths")
         end
 
diff --git a/tests/mutator_spec.lua b/tests/mutator_spec.lua
index 17548d3..de54c2c 100644
--- a/tests/mutator_spec.lua
+++ b/tests/mutator_spec.lua
@@ -248,6 +248,31 @@ a.describe("mutator", function()
       end)
     end)
 
+    it("Resolves MOVE loops between names that share a prefix", function()
+      local move_1 = {
+        type = "move",
+        src_url = "oil-test:///foo",
+        dest_url = "oil-test:///foo2",
+        entry_type = "file",
+      }
+      local move_2 = {
+        type = "move",
+        src_url = "oil-test:///foo2",
+        dest_url = "oil-test:///foo",
+        entry_type = "file",
+      }
+      for _, actions in ipairs({ { move_1, move_2 }, { move_2, move_1 } }) do
+        local ordered_actions = mutator.enforce_action_order(actions)
+        assert.are.same(3, #ordered_actions)
+        -- One file is moved out of the way first and moved into place last
+        local tmp_url = ordered_actions[1].dest_url
+        assert.truthy(tmp_url:find("__oil_tmp_", 1, true))
+        assert.are.same(ordered_actions[1].src_url, ordered_actions[2].dest_url)
+        assert.are.same(tmp_url, ordered_actions[3].src_url)
+        assert.are.same(ordered_actions[2].src_url, ordered_actions[3].dest_url)
+      end
+    end)
+
     it("Detects copy directory loops", function()
       local move = {
         type = "copy",
-- 
2.43.0

